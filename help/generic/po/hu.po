#. type: \b; header
#: ../E/cbot.txt:1
#, no-wrap
msgid "Programming - the CBOT language"
msgstr "Programozás – a CBOT nyelv"

#. type: Plain text
#: ../E/cbot.txt:2
#, no-wrap
msgid ""
"The CBOT language is very close in structure and syntax to C++ and Java. It has been adapted for the specific purposes of COLOBOT, and for an efficient pedagogical approach.\n"
"This language is made up of instructions (see below), <a cbot|bloc>blocks</a>, <a cbot|function>functions</a>, <a cbot|class>classes</a>, <a cbot|var>variables</a>, <a cbot|array>arrays</a>, <a cbot|expr>expressions</a> and <a cbot|cond>conditions</a>."
msgstr ""
"A CBOT nyelv szerkezete és szintaxisa nagyon hasonlít a C++ és a Java nyelvekhez. A COLOBOT sajátos céljaihoz és hatékony oktatási megközelítéshez lett igazítva.\n"
"A nyelv utasításokból (lásd lejjebb), <a cbot|bloc>blokkokból</a>, <a cbot|function>függvényekből</a>, <a cbot|class>osztályokból</a>, <a cbot|var>változókból</a>, <a cbot|array>tömbökből</a>, <a cbot|expr>kifejezésekből</a> és <a cbot|cond>feltételekből</a> áll."

#. type: Bullet: 'o'
#: ../E/cbot.txt:8
#, no-wrap
msgid "<code><format type>Type</format></code>"
msgstr "<code><format type>Típus</format></code>"

#. type: Bullet: 'o'
#: ../E/cbot.txt:11
#, no-wrap
msgid "<code><format const>Constants</format></code>"
msgstr "<code><format const>Konstansok</format></code>"

#. type: \t; header
#: ../E/cbot.txt:14
#, no-wrap
msgid "Instructions in the CBOT language:"
msgstr "A CBOT nyelv utasításai:"

#. type: \t; header
#: ../E/cbot.txt:29
#, no-wrap
msgid "Specific instructions for bots:"
msgstr "Speciális utasítások robotokhoz:"

#. type: \t; header
#: ../E/cbot.txt:60
#, no-wrap
msgid "Instructions about topology:"
msgstr "Topológiai utasítások:"

#. type: \t; header
#: ../E/cbot.txt:66
#, no-wrap
msgid "Instructions specific to some bots:"
msgstr "Egyes robotokra vonatkozó utasítások:"

#. type: \t; header
#: ../E/cbot.txt:79
#, no-wrap
msgid "Specific instructions for exchange posts:"
msgstr "Utasítások az információs állomásokhoz:"

#. type: Plain text
#: ../E/cbot.txt:80
#, no-wrap
msgid ""
"<code><a cbot|receive>receive</a>    </code>Receives an information\n"
"<code><a cbot|send>send</a>       </code>Sends a new information\n"
"<code><a cbot|testinfo>testinfo</a>   </code>Tests if an information exists\n"
"<code><a cbot|delinfo>deleteinfo</a> </code>Deletes an existing information"
msgstr ""
"<code><a cbot|receive>receive</a>    </code>Információ fogadása\n"
"<code><a cbot|send>send</a>       </code>Új információ küldése\n"
"<code><a cbot|testinfo>testinfo</a>   </code>Megvizsgálja, létezik-e információ\n"
"<code><a cbot|delinfo>deleteinfo</a> </code>Meglévő információ törlése"

#. type: \t; header
#: ../E/cbot.txt:85
#, no-wrap
msgid "Specific instructions for classes:"
msgstr "Speciális utasítások osztályokhoz:"

#. type: \t; header
#: ../E/cbot.txt:97
#, no-wrap
msgid "Specific instructions for strings:"
msgstr "Szövegekhez (stringekhez) kapcsolódó utasítások:"

#. type: Plain text
#: ../E/cbot.txt:98
#, no-wrap
msgid ""
"<code><a cbot|strlen>strlen</a>     </code>Gets string length\n"
"<code><a cbot|strleft>strleft</a>    </code>Extracts left part\n"
"<code><a cbot|strright>strright</a>   </code>Extracts right part\n"
"<code><a cbot|strmid>strmid</a>     </code>Extracts center part\n"
"<code><a cbot|strfind>strfind</a>    </code>Finds a substring.\n"
"<code><a cbot|strval>strval</a>     </code>Converts string to number\n"
"<code><a cbot|strupper>strupper</a>   </code>Converts to upper case\n"
"<code><a cbot|strlower>strlower</a>   </code>Converts to lower case"
msgstr ""
"<code><a cbot|strlen>strlen</a>     </code>Szöveg hossza\n"
"<code><a cbot|strleft>strleft</a>    </code>Bal oldali rész kivágása\n"
"<code><a cbot|strright>strright</a>   </code>Jobb oldali rész kivágása\n"
"<code><a cbot|strmid>strmid</a>     </code>Középső rész kivágása\n"
"<code><a cbot|strfind>strfind</a>    </code>Alszöveg keresése\n"
"<code><a cbot|strval>strval</a>     </code>Szöveg számmá alakítása\n"
"<code><a cbot|strupper>strupper</a>   </code>Nagybetűssé alakítás\n"
"<code><a cbot|strlower>strlower</a>   </code>Kisbetűssé alakítás"

#. type: \t; header
#: ../E/cbot.txt:107
#, no-wrap
msgid "Specific instructions for files:"
msgstr "Fájlokhoz tartozó speciális utasítások:"

#. type: Plain text
#: ../E/cbot.txt:108
#, no-wrap
msgid ""
"<code><a cbot|open>open</a>       </code>Opens a file\n"
"<code><a cbot|close>close</a>      </code>Closes a file\n"
"<code><a cbot|writeln>writeln</a>    </code>Writes line to a file\n"
"<code><a cbot|readln>readln</a>     </code>Reads line from a file\n"
"<code><a cbot|eof>eof</a>        </code>Tests if end of file\n"
"<code><a cbot|deletef>deletefile</a> </code>Deletes a file"
msgstr ""
"<code><a cbot|open>open</a>       </code>Megnyit egy fájlt\n"
"<code><a cbot|close>close</a>      </code>Bezár egy fájlt\n"
"<code><a cbot|writeln>writeln</a>    </code>Sor írása a fájlba\n"
"<code><a cbot|readln>readln</a>     </code>Sor olvasása a fájlból\n"
"<code><a cbot|eof>eof</a>        </code>Fájl vége ellenőrzése\n"
"<code><a cbot|deletef>deletefile</a> </code>Fájl törlése"

#. type: \t; header
#: ../E/battles.txt:53 ../E/cbot.txt:131 ../E/freehelp.txt:4
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../E/cbot.txt:132
#, no-wrap
msgid "<a cbot|type>Types</a> and <a cbot|category>categories</a>."
msgstr "<a cbot|type>Típusok</a> és <a cbot|category>kategóriák</a>."

#. type: \b; header
#: ../E/command.txt:1
#, no-wrap
msgid "Controls"
msgstr "Irányítás"

#. type: Plain text
#: ../E/command.txt:2
#, no-wrap
msgid "You are advised to play with one hand on the arrow keys and the other hand on the mouse."
msgstr "Javasoljuk, hogy az egyik kezed legyen a kurzornyilakon, a másik pedig az egéren játék közben."

#. type: \t; header
#: ../E/command.txt:4
#, no-wrap
msgid "Bots"
msgstr "Robotok és az <a object|human>űrhajós</a>"

#. type: Plain text
#: ../E/command.txt:5
#, no-wrap
msgid ""
"<format key><key left/></format> = turn left\n"
"<format key><key right/></format> = turn right\n"
"<format key><key up/></format> = move forward\n"
"<format key><key down/></format> = move back\n"
"These controls are unavailable when working with the <a object|bottr>practice bots</a>."
msgstr ""
"A robotok közvetlen irányítása a legtöbb gyakorlófeladatban nem elérhető.\n"
"<format key><key left/></format> = fordulás balra\n"
"<format key><key right/></format> = fordulás jobbra\n"
"<format key><key up/></format> = előrehaladás\n"
"<format key><key down/></format> = hátrálás."

#. type: Plain text
#: ../E/command.txt:11
#, no-wrap
msgid ""
"<format key><key gup/></format> = take off and climb <button 28/>\n"
"<format key><key gdown/></format> = descend and land <button 29/>\n"
"These controls are of course restricted to the <a object|human>astronaut</a> as well as the various <a object|botgj>winged bots</a> and in selected missions only."
msgstr ""
"<format key><key gup/></format> = felszállás/emelkedés <button 28/>\n"
"<format key><key gdown/></format> = süllyedés/leszállás <button 29/>\n"
"Ezek az irányítási lehetőségek csak az <a object|human>űrhajós</a> és bizonyos <a object|botgj>szárnyas robotok</a> számára érhetők el, kizárólag egyes küldetésekben."

#. type: Plain text
#: ../E/command.txt:15
#, no-wrap
msgid ""
"mouse forward = higher aim\n"
"mouse backward = lower aim\n"
"mouse right = aim right\n"
"mouse left = aim left\n"
"These controls are only available to the <a object|botfr>shooters</a>, the <a object|botor>orga shooters</a> and the <a object|botphaz>phazer shooter</a>."
msgstr ""
"egér előre = magasabbra célzás\n"
"egér hátra = lejjebb célzás\n"
"egér jobbra = jobbra célzás\n"
"egér balra = balra célzás\n"
"Ezek az irányítások csak a <a object|botfr>lövőrobotokra</a>, az <a object|botor>orga lövőkre</a> és a <a object|botphaz>phazer lövőkre</a> vonatkoznak."

#. type: Plain text
#: ../E/command.txt:21
#, no-wrap
msgid ""
"<format key><key action/></format> = main action for a given selection (human or bot)\n"
"This control will for example operate the arm of a <a object|botgr>grabber</a> or fire a <a object|botfr>shooter</a> <button 42/>."
msgstr ""
"<format key><key action/></format> = fő művelet végrehajtása (ember vagy robot)\n"
"Ez a parancs például működteti egy <a object|botgr>fogórobot</a> karját, vagy elsüti egy <a object|botfr>lövőrobot</a> fegyverét <button 42/>."

#. type: \t; header
#: ../E/command.txt:24
#, no-wrap
msgid "Selections"
msgstr "Kijelölések"

#. type: Plain text
#: ../E/command.txt:25
#, no-wrap
msgid ""
"<format key><key next/></format> = selects next object\n"
"<format key><key human/></format> = selects astronaut\n"
"<format key><key desel/></format> = previous selection <button 10/>"
msgstr ""
"<format key><key next/></format> = következő objektum kijelölése\n"
"<format key><key human/></format> = űrhajós kijelölése\n"
"<format key><key desel/></format> = előző kijelölés <button 10/>"

#. type: \t; header
#: ../E/command.txt:29
#, no-wrap
msgid "Camera"
msgstr "Kamera"

#. type: Plain text
#: ../E/command.txt:30
#, no-wrap
msgid ""
"<format key><key camera/></format> = shifts between onboard and following cameras <button 13/>\n"
"<format key><key near/></format> = zoom in\n"
"<format key><key away/></format> = zoom out\n"
"<format key><key visit/></format> = pauses the game and shows where the latest message originated. Press again to show origin of previous message."
msgstr ""
"<format key><key camera/></format> = váltás a fedélzeti és követő kamerák között <button 13/>\n"
"<format key><key near/></format> = nagyítás\n"
"<format key><key away/></format> = kicsinyítés\n"
"<format key><key visit/></format> = megállítja a játékot, és megmutatja, honnan származik az utolsó üzenet. Ismételt megnyomással az előző üzenet forrását mutatja."

#. type: \t; header
#: ../E/command.txt:35
#, no-wrap
msgid "Help"
msgstr "Segítség"

#. type: Plain text
#: ../E/command.txt:36
#, no-wrap
msgid ""
"<format key><key help/></format> = mission instructions\n"
"<format key><key prog/></format> = programming help"
msgstr ""
"<format key><key help/></format> = küldetés utasításai\n"
"<format key><key prog/></format> = programozási segítség"

#. type: \t; header
#: ../E/command.txt:39
#, no-wrap
msgid "Game"
msgstr "Játék"

#. type: Plain text
#: ../E/command.txt:47
#, no-wrap
msgid "All these commands can be redefined in the options/controls menu."
msgstr "Minden vezérlőparancs újradefiniálható a beállítások/vezérlés menüben."

#. type: \b; header
#: ../E/freehelp.txt:1
#, no-wrap
msgid "Objective"
msgstr "Cél"

#. type: Plain text
#: ../E/freehelp.txt:2
#, no-wrap
msgid "Here you can play around without any definite objective. You can do whatever you want, explore the region, build a base camp and several bots, run various research programs, kill the insects if you find some, etc."
msgstr "Itt szabadon játszhatsz anélkül, hogy konkrét célt kellene teljesítened. Azt csinálsz, amit akarsz: felfedezheted a környéket, építhetsz táborhelyet és több robotot, különböző kutatási programokat indíthatsz, megölheted a rovarokat, ha találsz néhányat, stb."

#. type: Plain text
#: ../E/freehelp.txt:5
#, no-wrap
msgid "<a command>Controls</a>."
msgstr "<a command>Vezérlés</a>."

#. type: Plain text
#: ../E/licences.txt:1
#, no-wrap
msgid "The photograph of the nebula NGC3606 illuminating the sky on Orpheon and the installation program was taken with the Hubble space telescope. It is used with the permission of the authors Wolfgang Brandner (JPL/IPAC), Eva K. Grebel (Washington University), You-Hua Chu (Illinois Urbana-Champaign University) and NASA."
msgstr "Az Orpheon égboltját megvilágító NGC3606 köd fotója, amely az installáló programban is látható, a Hubble űrteleszkóppal készült. A képet a szerzők – Wolfgang Brandner (JPL/IPAC), Eva K. Grebel (Washington University), You-Hua Chu (Illinois Urbana-Champaign University) és a NASA – engedélyével használjuk."

#. type: Plain text
#: ../E/licences.txt:3
#, no-wrap
msgid "The thunder sound on Orpheon is used by limited permission from CREATIVE."
msgstr "Az Orpheonban hallható mennydörgés hangját a CREATIVE korlátozott engedélyével használjuk."

#. type: \b; header
#: ../E/navig.txt:1
#, no-wrap
msgid "Navigation"
msgstr "Navigáció"

#. type: Plain text
#: ../E/navig.txt:2
#, no-wrap
msgid "The three buttons on the upper left-hand corner of the screen allow you to navigate in the different texts of the help file:"
msgstr "A képernyő bal felső sarkában található három gombbal navigálhatsz a súgófájl különböző szövegei között:"

#. type: Plain text
#: ../E/navig.txt:4
#, no-wrap
msgid ""
"<button 30/> Home\n"
"Get back to the home page, i.e. the first page that was displayed, for example when you hit the <format key><key help/></format> or <format key><key prog/></format> key."
msgstr ""
"<button 30/> Kezdőlap\n"
"Visszatérés a kezdőoldalra, vagyis az első megjelenített oldalra, például amikor megnyomtad a <format key><key help/></format> vagy a <format key><key prog/></format> billentyűt."

#. type: Plain text
#: ../E/navig.txt:7
#, no-wrap
msgid ""
"<button 55/> Previous\n"
"Get back to the previous page, i.e. the page that was displayed before you clicked on a link."
msgstr ""
"<button 55/> Előző\n"
"Visszatérés az előző oldalra, vagyis arra, amely megjelent, mielőtt rákattintottál egy hivatkozásra."

#. type: Plain text
#: ../E/navig.txt:10
#, no-wrap
msgid ""
"<button 48/> Next\n"
"Get again to the next page, after you used the \"Home\" or \"Previous\" button."
msgstr ""
"<button 48/> Következő\n"
"Tovább a következő oldalra, miután a „Kezdőlap” vagy „Előző” gombot használtad."

#. type: \t; header
#: ../E/navig.txt:13
#, no-wrap
msgid "Remark"
msgstr "Megjegyzés"

#. type: Plain text
#: ../E/navig.txt:14
#, no-wrap
msgid ""
"When a button is gray, this means that it can not be used at this precise moment. For example, when you are in the home page, the \"Home\" button is gray, because it does not make sense to use it.\n"
"This remark is valid for all buttons in COLOBOT."
msgstr ""
"Ha egy gomb szürke, az azt jelenti, hogy nem használható az adott pillanatban. Például, amikor a kezdőlapot nézed, a \"Home\" gomb szürke, mert nem értelmes használni.\n"
"Ez a megjegyzés minden gombra érvényes a COLOBOT-ban."

#. type: \t; header
#: ../E/navig.txt:17
#, no-wrap
msgid "Text scrolling"
msgstr "Szöveg görgetés"

#. type: Plain text
#: ../E/navig.txt:18
#, no-wrap
msgid "If your mouse is equipped with a wheel, you can use it to scroll the text up and down. Otherwise, use the arrow keys and the scroll bar on the right-hand side of the screen."
msgstr "Ha az egér görgővel van felszerelve, akkor azt használhatod a szöveg felfelé és lefelé görgetésére. Ha nem, használd a nyílbillentyűket vagy a görgetősávot a képernyő jobb oldalán."

#. type: \t; header
#: ../E/navig.txt:20
#, no-wrap
msgid "Font size"
msgstr "Betűméret"

#. type: Plain text
#: ../E/navig.txt:21
#, no-wrap
msgid "The cursor on the upper side of the screen allows you to change the font size of the text."
msgstr "A képernyő felső részén található csúszka segítségével módosíthatod a szöveg betűméretét."

#. type: Plain text
#: ../E/win.txt:2
#, no-wrap
msgid ""
"Houston congratulates you in the name of mankind for the success of your mission.\n"
"The Great Migration to Terra Nova will start very soon."
msgstr ""
"Houston gratulál az emberiség nevében a küldetésed sikeréhez.\n"
"A Nagy Vándorlás Terra Novára hamarosan elindul."

#. type: Plain text
#: ../E/authors.txt:1
#, no-wrap
msgid "Developers and internal betatesters of Original COLOBOT game from EPSITEC"
msgstr "Az EPSITEC eredeti COLOBOT játékának fejlesztői és belső bétatesztelői"

#. type: Plain text
#: ../E/authors.txt:6
#, no-wrap
msgid "Colobot: Gold Edition developers"
msgstr "A Colobot: Gold Edition fejlesztői"

#. type: \b; header
#: ../E/battles.txt:1
#, no-wrap
msgid "Code battles"
msgstr "Kódbattles"

#. type: Plain text
#: ../E/battles.txt:2
#, no-wrap
msgid "Code battle is a completely new game mode featured in Colobot: Gold Edition. The idea is that you set up two programs (yours and the opponent's) to fight with each other. The player can't interact with the world manually."
msgstr "A kódbattle egy teljesen új játékmód, amely a Colobot: Gold Edition-ben található. Az ötlet az, hogy két programot (a tiédet és az ellenfélét) állítasz be, hogy harcoljanak egymással. A játékos nem tud manuálisan interakcióba lépni a világgal."

#. type: Plain text
#: ../E/battles.txt:18
#, no-wrap
msgid "With the new functions provided in the Gold Edition, you can create a fully automatised base, which does not need any influence from <a object|human>human</a>. All of them are described in the <a cbot>CBOT documentation</a>."
msgstr "Az új funkciók segítségével a Gold Edition-ben teljesen automatizált bázist hozhatsz létre, amelyhez nincs szükség emberi beavatkozásra. Mindegyikük le van írva a <a cbot>CBOT dokumentációban</a>."

#. type: Plain text
#: ../E/battles.txt:20
#, no-wrap
msgid "Production line is explained in Missions and Exercises, but you may want to jump into code battles right away without beating the whole game. So here is a brief description of how the things works in Colobot."
msgstr "A termelési vonalat a Küldetések és Gyakorlatok ismertetik, de lehet, hogy szeretnél azonnal a kódbattles-be ugrani anélkül, hogy végigjátszanád az egész játékot. Itt van egy rövid leírás arról, hogyan működnek a dolgok a Colobot-ban."

#. type: \t; header
#: ../E/battles.txt:22
#, no-wrap
msgid "What you want to achieve"
msgstr "Mit szeretnél elérni"

#. type: Plain text
#: ../E/battles.txt:23
#, no-wrap
msgid "Basically, you want to destroy the opponent. To do that, you will need something lethal, for example, a robot, specifically, a <a object|botfr>shooter</a>. But you will probably be losing them quite often, so maybe you should keep the production going on. For example, more <a object|botgr>grabbers</a> or more <a object|factory>factories</a>, <a object|convert>converters</a> and so on would be helpful in that. Remember that robots needs <a object|power>batteries</a>. Anyway, before you can start, you must also do some <a object|research>researches</a> to get better technologies. And here we are at the beginning, with a single <a object|botgr>robot</a> and a <a object|titan>Titanium</a>."
msgstr "Alapvetően el akarod pusztítani az ellenfelet. Ehhez valami halálosra lesz szükséged, például egy robotra, kifejezetten egy <a object|botfr>lövőre</a>. De valószínűleg el fogod őket veszíteni elég gyakran, szóval talán folytatnod kellene a termelést. Például több <a object|botgr>megragadó</a> vagy több <a object|factory>gyár</a>, <a object|convert>konvertáló</a> és így tovább hasznos lenne ebben. Ne felejtsd el, hogy a robotoknak <a object|power>akkumulátorokra</a> van szükségük. Mindenesetre, mielőtt elkezdheted, előbb kutatásokat kell végezned, hogy jobb technológiákat szerezz. És itt vagyunk az elején, egyetlen <a object|botgr>robot</a> és egy <a object|titan>Titán</a> társaságában."

#. type: Image filename
#: ../E/battles.txt:25
#, no-wrap
msgid "productionline1"
msgstr ""

#. type: \t; header
#: ../E/battles.txt:27
#, no-wrap
msgid "Titanium production"
msgstr "Titán előállítás"

#. type: Plain text
#: ../E/battles.txt:28
#, no-wrap
msgid ""
"1. <a cbot|radar>Find</a> a <a object|titan>Titanium</a>.\n"
"2. <a cbot|build>Build</a> a <a object|convert>Converter</a>.\n"
"3. Find a <a object|titanore>TitaniumOre</a>.\n"
"4. Place it in the converter. Move back and wait until the converter is done.\n"
"5. Use or move somewhere your new Titanium.\n"
"Repeat steps 3-5 in order to keep your production going."
msgstr ""
"1. <a cbot|radar>Találd meg</a> a <a object|titan>titánt</a>.\n"
"2. <a cbot|build>Építs</a> egy <a object|convert>Átalakítót</a>.\n"
"3. Találd meg a <a object|titanore>titánércet</a>.\n"
"4. Helyezd be az átalakítóba. Térj vissza, és várj, amíg az átalakító befejezi.\n"
"5. Használd fel, vagy tedd máshová az új titánt.\n"
"Ismételd meg a 3-5. lépéseket, hogy fenntartsd a termelést."

#. type: \t; header
#: ../E/battles.txt:35
#, no-wrap
msgid "Researches"
msgstr "Kutatások"

#. type: Plain text
#: ../E/battles.txt:36
#, no-wrap
msgid ""
"1. <a cbot|build>Build</a> a <a object|research>ResearchCenter</a>.\n"
"2. Power it with a <a object|power>PowerCell</a>.\n"
"3. <a cbot|research>Request</a> a <a cbot|researches>research</a> and wait until the research center is done."
msgstr ""
"1. <a cbot|build>Építs</a> egy <a object|research>Kutatóközpontot</a>.\n"
"2. Tápláld egy <a object|power>Energiasejttel</a>.\n"
"3. <a cbot|research>Kérj</a> egy <a cbot|researches>kutatást</a>, és várj, amíg a kutatóközpont befejezi."

#. type: \t; header
#: ../E/battles.txt:40
#, no-wrap
msgid "Robot production"
msgstr "Robot előállítás"

#. type: Plain text
#: ../E/battles.txt:41
#, no-wrap
msgid ""
"1. <a cbot|build>Build</a> a <a object|factory>BotFactory</a>.\n"
"2. Place a <a object|titan>Titanium</a> inside and move back.\n"
"3. <a cbot|factory>Request</a> a construction of a robot and wait until the bot factory is done.\n"
"4. Power the robot with a <a object|power>PowerCell</a>."
msgstr ""
"1. <a cbot|build>Építs</a> egy <a object|factory>Robotgyárat</a>.\n"
"2. Helyezd be a <a object|titan>titánt</a> és térj vissza.\n"
"3. <a cbot|factory>Kérj</a> egy robot építését, és várj, amíg a robotgyár befejezi.\n"
"4. Tápold a robotot egy <a object|power>Energiasejttel</a>."

#. type: \t; header
#: ../E/battles.txt:46
#, no-wrap
msgid "Power cell production"
msgstr "Energiasejt előállítás"

#. type: Plain text
#: ../E/battles.txt:47
#, no-wrap
msgid ""
"1. <a cbot|build>Build</a> a <a object|energy>PowerPlant</a>.\n"
"2. Place a <a object|titan>Titanium</a> in it and wait until the power plant is done."
msgstr ""
"1. <a cbot|build>Építs</a> egy <a object|energy>Energiaüzemet</a>.\n"
"2. Helyezd be a <a object|titan>titánt</a>, és várj, amíg az energiaüzem befejezi."

#. type: \t; header
#: ../E/battles.txt:50
#, no-wrap
msgid "There is more"
msgstr "Még több van"

#. type: Plain text
#: ../E/battles.txt:51
#, no-wrap
msgid "There is much more options, but this is the basis. Read documentation, play the game and think creatively to come up with new ideas. Good luck and have fun!"
msgstr "Rengeteg más lehetőség van, de ez az alap. Olvasd el a dokumentációt, játssz a játékkal, és gondolkodj kreatívan, hogy új ötletekkel állj elő. Sok szerencsét és jó szórakozást!"

#. type: Plain text
#: ../E/battles.txt:54
#, no-wrap
msgid "<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<a cbot>Programozás</a>, <a cbot|type>típusok</a> és <a cbot|category>kategóriák</a>."

#. type: Plain text
#: ../E/cbot.txt:15
#, no-wrap
msgid ""
"<code><a cbot|extern>extern</a>     </code>Indicate the main function\n"
"<code><a cbot|if>if</a>         </code>Choice structure\n"
"<code><a cbot|if>else</a>       </code>Alternative choice structure\n"
"<code><a cbot|switch>switch</a>     </code>Multiple choice structure\n"
"<code><a cbot|switch>case</a>       </code>One choice\n"
"<code><a cbot|switch>default</a>    </code>Default choice\n"
"<code><a cbot|for>for</a>        </code>Loop structure\n"
"<code><a cbot|while>while</a>      </code>Control structure\n"
"<code><a cbot|do>do</a>         </code>Control structure\n"
"<code><a cbot|break>break</a>      </code>Exit from a loop\n"
"<code><a cbot|continue>continue</a>   </code>Continues the loop\n"
"<code><a cbot|return>return</a>     </code>Exit from a function\n"
"<code><a cbot|sizeof>sizeof</a>     </code>Size of an array"
msgstr ""
"<code><a cbot|extern>extern</a>     </code>Jelöli a fő funkciót\n"
"<code><a cbot|if>if</a>         </code>Választási struktúra\n"
"<code><a cbot|if>else</a>       </code>Alternatív választási struktúra\n"
"<code><a cbot|switch>switch</a>     </code>Többszörös választási struktúra\n"
"<code><a cbot|switch>case</a>       </code>Egy választás\n"
"<code><a cbot|switch>default</a>    </code>Alapértelmezett választás\n"
"<code><a cbot|for>for</a>        </code>Ciklus struktúra\n"
"<code><a cbot|while>while</a>      </code>Vezérlési struktúra\n"
"<code><a cbot|do>do</a>         </code>Vezérlési struktúra\n"
"<code><a cbot|break>break</a>      </code>Kilépés a ciklusból\n"
"<code><a cbot|continue>continue</a>   </code>A ciklus folytatása\n"
"<code><a cbot|return>return</a>     </code>Kilépés a függvényből\n"
"<code><a cbot|sizeof>sizeof</a>     </code>Tömb mérete"

#. type: Plain text
#: ../E/cbot.txt:61
#, no-wrap
msgid ""
"<code><a cbot|space>space</a>      </code>Calculates a free space\n"
"<code><a cbot|flatspace>flatspace</a>  </code>Calculates a free, flat space\n"
"<code><a cbot|topo>topo</a>       </code>Returns the altitude of a point\n"
"<code><a cbot|flatgrnd>flatground</a> </code>Returns radius of a flat area"
msgstr ""
"<code><a cbot|space>space</a>      </code>Szabad területet számol\n"
"<code><a cbot|flatspace>flatspace</a>  </code>Szabad, sík területet számol\n"
"<code><a cbot|topo>topo</a>       </code>Visszaadja egy pont magasságát\n"
"<code><a cbot|flatgrnd>flatground</a> </code>Visszaadja egy sík terület sugarát"

#. type: \t; header
#: ../E/cbot.txt:115
#, no-wrap
msgid "Mathematical functions:"
msgstr "Matematikai függvények:"

#. type: Plain text
#: ../E/cbot.txt:116
#, no-wrap
msgid ""
"<code><a cbot|rand>rand</a>       </code>Returns a random value\n"
"<code><a cbot|pow>pow</a>        </code>Returns a power\n"
"<code><a cbot|sqrt>sqrt</a>       </code>Returns a square root\n"
"<code><a cbot|floor>floor</a>      </code>Returns the largest previous integer\n"
"<code><a cbot|ceil>ceil</a>       </code>Returns the smallest following integer\n"
"<code><a cbot|round>round</a>      </code>Returns a rounded number\n"
"<code><a cbot|trunc>trunc</a>      </code>Returns a truncated number\n"
"<code><a cbot|sin>sin</a>        </code>Returns a sine\n"
"<code><a cbot|cos>cos</a>        </code>Returns a cosine\n"
"<code><a cbot|tan>tan</a>        </code>Returns a tangent\n"
"<code><a cbot|asin>asin</a>       </code>Returns an arcus sine\n"
"<code><a cbot|acos>acos</a>       </code>Returns an arcus cosine\n"
"<code><a cbot|atan>atan</a>       </code>Returns an arcus tangent\n"
"<code><a cbot|atan2>atan2</a>      </code>Returns an arcus tangent, has two arguments"
msgstr ""
"<code><a cbot|rand>rand</a>       </code>Visszaad egy véletlen értéket\n"
"<code><a cbot|pow>pow</a>        </code>Visszaad egy hatványt\n"
"<code><a cbot|sqrt>sqrt</a>       </code>Visszaad egy négyzetgyököt\n"
"<code><a cbot|floor>floor</a>      </code>Visszaadja a legnagyobb előző egész számot\n"
"<code><a cbot|ceil>ceil</a>       </code>Visszaadja a legkisebb következő egész számot\n"
"<code><a cbot|round>round</a>      </code>Visszaadja egy kerekített számot\n"
"<code><a cbot|trunc>trunc</a>      </code>Visszaad egy levágott számot\n"
"<code><a cbot|sin>sin</a>        </code>Visszaad egy szinuszt\n"
"<code><a cbot|cos>cos</a>        </code>Visszaad egy koszinuszt\n"
"<code><a cbot|tan>tan</a>        </code>Visszaad egy tangenszt\n"
"<code><a cbot|asin>asin</a>       </code>Visszaad egy arkusz szinuszt\n"
"<code><a cbot|acos>acos</a>       </code>Visszaad egy arkusz koszinuszt\n"
"<code><a cbot|atan>atan</a>       </code>Visszaad egy arkusz tangenszt\n"
"<code><a cbot|atan2>atan2</a>      </code>Visszaad egy arkusz tangenszt, két argumentummal"

#. type: Plain text
#: ../E/cbot.txt:9
#, no-wrap
msgid "The <a cbot|type>type</a> of a variable appears like that: <format type>type</format>. "
msgstr "A változó <a cbot|type>típusa</a> így jelenik meg: <format type>típus</format>. "

#. type: Plain text
#: ../E/cbot.txt:12
#, no-wrap
msgid "Constants like <a cbot|category>categories</a> are displayed like that: <format const>constant</format>. "
msgstr "Az olyan konstansok, mint a <a cbot|category>kategóriák</a>, így jelennek meg: <format const>konstans</format>. "

#. type: Plain text
#: ../E/cbot.txt:5
#, no-wrap
msgid ""
"<a cheats>o</a>  |c;<format token>Instructions</format><n/>\n"
"In the program editor, an instruction in the CBOT language is always displayed like that: <format token>instruction</format>. If an instruction is not highlighted, this means that it has been misspelled. Instruction names are always written in lower case. "
msgstr ""
"<a cheats>o</a>  |c;<format token>Parancsok</format><n/>\n"
"A program szerkesztőben a CBOT nyelvű parancs mindig így jelenik meg: <format token>parancs</format>. Ha egy parancs nincs kiemelve, az azt jelenti, hogy elgépelés történt. A parancsnevek mindig kisbetűvel íródnak. "

#. type: \b; header
#: ../E/cheats.txt:1
#, no-wrap
msgid "Cheats"
msgstr "Csalások"

#. type: Plain text
#: ../E/cheats.txt:2
#, no-wrap
msgid "Great, you have found this secret page. We hope you will use informations contained here only for other than cheating purposes. Like testing the game or recording a cool video about Colobot."
msgstr "Nagyszerű, megtaláltad ezt a titkos oldalt. Reméljük, hogy az itt található információkat csak csalás céljain kívül használod. Például a játék tesztelésére vagy egy menő videó rögzítésére a Colobot-ról."

#. type: \b; header
#: ../E/cheats.txt:4
#, no-wrap
msgid "Console"
msgstr "Konzol"

#. type: Plain text
#: ../E/cheats.txt:5
#, no-wrap
msgid "You can open the console by pressing the <key/><code>~</code><norm/> button on your keyboard. Press <key/><code>ENTER</code><norm/> to hide it or pass one of the commands below."
msgstr "A konzolt úgy nyithatod meg, hogy lenyomod a <key/><code>~</code><norm/> gombot a billentyűzeteden. A <key/><code>ENTER</code><norm/> gombbal elrejtheted, vagy kiadhatod az alábbi parancsok egyikét."

#. type: \t; header
#: ../E/cheats.txt:7
#, no-wrap
msgid "Missions"
msgstr "Küldetések"

#. type: \t; header
#: ../E/cheats.txt:13
#, no-wrap
msgid "Gameplay"
msgstr "Játék menet"

#. type: \t; header
#: ../E/cheats.txt:32
#, no-wrap
msgid "Debug"
msgstr "Hibakeresés"

#. type: \t; header
#: ../E/cheats.txt:37
#, no-wrap
msgid "Aesthetic"
msgstr "Esztétikai"

#. type: \b; header
#: ../E/cheats.txt:41
#, no-wrap
msgid "CBOT"
msgstr "CBOT"

#. type: Bullet: 'o'
#: ../E/cheats.txt:45
#, no-wrap
msgid "<code><a cbot|produce>produce</a>      </code>Immediately creates an object"
msgstr "<code><a cbot|produce>produce</a>      </code>Azonnal létrehozza az objektumot"

#. type: Bullet: 'o'
#: ../E/cheats.txt:8
#, no-wrap
msgid "<code>winmission   </code>Immediately win the current mission"
msgstr "<code>winmission   </code>Azonnal megnyeri a jelenlegi küldetést"

#. type: Bullet: 'o'
#: ../E/cheats.txt:9
#, no-wrap
msgid "<code>lostmission  </code>Immediately lose the current mission"
msgstr "<code>lostmission  </code>Azonnal elveszíti a jelenlegi küldetést"

#. type: Bullet: 'o'
#: ../E/cheats.txt:14
#, no-wrap
msgid "<code>allresearch  </code>All researches are done"
msgstr "<code>allresearch  </code>Az összes kutatás befejeződött"

#. type: Bullet: 'o'
#: ../E/cheats.txt:15
#, no-wrap
msgid "<code>allbuildings </code>All buildings are enabled"
msgstr "<code>allbuildings </code>Az összes épület engedélyezve van"

#. type: Bullet: 'o'
#: ../E/cheats.txt:16
#, no-wrap
msgid "<code>all          </code><code>allbuildings</code> + <code>allresearch</code>"
msgstr "<code>all          </code><code>allbuildings</code> + <code>allresearch</code>"

#. type: Bullet: 'o'
#: ../E/cheats.txt:17
#, no-wrap
msgid "<code>fullenergy   </code>Restore energy in the currently selected bot"
msgstr "<code>fullenergy   </code>Visszaállítja az energiát a jelenleg kiválasztott botban"

#. type: Bullet: 'o'
#: ../E/cheats.txt:18
#, no-wrap
msgid "<code>fullshield   </code>Restore shield in the currently selected object"
msgstr "<code>fullshield   </code>Visszaállítja a pajzsot a jelenleg kiválasztott objektumban"

#. type: Bullet: 'o'
#: ../E/cheats.txt:19
#, no-wrap
msgid "<code>fullrange    </code>Flying reactor is cold"
msgstr "<code>fullrange    </code>A repülő reaktor hideg"

#. type: Bullet: 'o'
#: ../E/cheats.txt:20
#, no-wrap
msgid "<code>fullpower    </code><code>fullenergy</code> + <code>fullshield</code> + <code>fullrange</code>"
msgstr "<code>fullpower    </code><code>fullenergy</code> + <code>fullshield</code> + <code>fullrange</code>"

#. type: Bullet: 'o'
#: ../E/cheats.txt:22
#, no-wrap
msgid "<code>fly          </code>You can fly even if flying is disabled in the current mission"
msgstr "<code>fly          </code>Repülhetsz, még akkor is, ha a repülés le van tiltva az aktuális küldetésben"

#. type: Bullet: 'o'
#: ../E/cheats.txt:24
#, no-wrap
msgid "<code>addfreezer   </code>Flying reactor heats more slowly"
msgstr "<code>addfreezer   </code>A repülő reaktor lassabban melegszik"

#. type: Bullet: 'o'
#: ../E/cheats.txt:25
#, no-wrap
msgid "<code>addhusky     </code>You take less damage than usual"
msgstr "<code>addhusky     </code>Kevesebb sérülést szenvedsz, mint általában"

#. type: Bullet: 'o'
#: ../E/cheats.txt:26
#, no-wrap
msgid "<code>nolimit      </code>You can fly higher"
msgstr "<code>nolimit      </code>Magasabbra repülhetsz"

#. type: Bullet: 'o'
#: ../E/cheats.txt:27
#, no-wrap
msgid "<code>trainerpilot </code>You can drive robots which could be previously controlled only by programs"
msgstr "<code>trainerpilot </code>Vezethetsz robotokat, amelyeket korábban csak programok vezérelhettek"

#. type: Bullet: 'o'
#: ../E/cheats.txt:38
#, no-wrap
msgid "<code>photo1       </code>Free camera, you can change angle with <key/><code>+</code><norm/> and <key/><code>-</code><norm/> keys, type again to set it off"
msgstr "<code>photo1       </code>Szabad kamera, az <key/><code>+</code><norm/> és <key/><code>-</code><norm/> billentyűkkel változtathatod az irányt, gépeld be újra a kikapcsoláshoz"

#. type: Bullet: 'o'
#: ../E/cheats.txt:39
#, no-wrap
msgid "<code>photo2       </code>Same as <code>photo1</code>, except it hides interface, type again to set it off"
msgstr "<code>photo2       </code>Ugyanaz, mint a <code>photo1</code>, de elrejti a felületet, gépeld be újra a kikapcsoláshoz"

#. type: Bullet: 'o'
#: ../E/cheats.txt:47
#, no-wrap
msgid "<code>delete       </code>Damages the object, <code>1</code>: object's ID, <code>2</code>: magnifyDamage multiplier, without <code>2</code> the object explodes"
msgstr "<code>delete       </code>Sérti az objektumot, <code>1</code>: az objektum ID-ja, <code>2</code>: a sérülés szorzója, <code>2</code> nélkül az objektum felrobban"

#. type: Bullet: 'o'
#: ../E/cheats.txt:48
#, no-wrap
msgid "<code>setbuild     </code>Sets buildings bitmask, <code>1</code>: new bitmask"
msgstr "<code>setbuild     </code>Beállítja az épületek bitmaszkját, <code>1</code>: új bitmaszk"

#. type: Bullet: 'o'
#: ../E/cheats.txt:49
#, no-wrap
msgid "<code>setresearchenable </code>Sets researches bitmask, <code>1</code>: new bitmask"
msgstr "<code>setresearchenable </code>Beállítja a kutatások bitmaszkját, <code>1</code>: új bitmaszk"

#. type: Bullet: 'o'
#: ../E/cheats.txt:50
#, no-wrap
msgid "<code>setresearchdone </code>Sets done researches bitmask, <code>1</code>: new bitmask"
msgstr "<code>setresearchdone </code>A végrehajtott kutatásokat állítja be, <code>1</code>: új bitmaszk"

#. type: Bullet: 'o'
#: ../E/cheats.txt:51
#, no-wrap
msgid "<code>getbuild     </code>Returns buildings bitmask"
msgstr "<code>getbuild     </code>Visszaadja az épületek bitmaszkját"

#. type: Bullet: 'o'
#: ../E/cheats.txt:52
#, no-wrap
msgid "<code>getresearchenable </code>Returns researches bitmask"
msgstr "<code>getresearchenable </code>Visszaadja a kutatások bitmaszkját"

#. type: Bullet: 'o'
#: ../E/cheats.txt:53
#, no-wrap
msgid "<code>getresearchdone </code>Returns done researches bitmask"
msgstr "<code>getresearchdone </code>Visszaadja a végrehajtott kutatásokat bitmaszkját"

#. type: Bullet: 'o'
#: ../E/cheats.txt:54
#, no-wrap
msgid "<code>playmusic    </code>Plays music, <code>1</code>: file name, <code>2</code>: repeat"
msgstr "<code>playmusic    </code>Zenét játszik le, <code>1</code>: fájlnév, <code>2</code>: ismétlés"

#. type: Bullet: 'o'
#: ../E/cheats.txt:55
#, no-wrap
msgid "<code>stopmusic    </code>Stops music"
msgstr "<code>stopmusic    </code>Leállítja a zenét"

#. type: Bullet: 'o'
#: ../E/cheats.txt:10
#, no-wrap
msgid "<code>allmission   </code>All missions are unlocked, works also in main menu"
msgstr "<code>allmission   </code>Az összes küldetés feloldva, működik a főmenüben is"

#. type: Bullet: 'o'
#: ../E/cheats.txt:11
#, no-wrap
msgid "<code>showsoluce   </code>All solutions are unlocked, works also in main menu"
msgstr "<code>showsoluce   </code>Az összes megoldás feloldva, működik a főmenüben is"

#. type: Bullet: 'o'
#: ../E/cheats.txt:21
#, no-wrap
msgid "<code>selectinsect </code>You can select and control aliens, works also in main menu, type again to disable"
msgstr "<code>selectinsect </code>Idegen lényeket választhatsz és irányíthatsz, működik a főmenüben is, ismételt beírással kikapcsolható"

#. type: Bullet: 'o'
#: ../E/cheats.txt:23
#, no-wrap
msgid "<code>invradar     </code>Mini-map works like you would have built a <a object|radar>radar</a>, works also in main menu, type again to disable"
msgstr "<code>invradar     </code>Mini-térkép úgy működik, mintha építettél volna egy <a object|radar>radart</a>, működik a főmenüben is, ismételt beírással kikapcsolható"

#. type: Bullet: 'o'
#: ../E/cheats.txt:28
#, no-wrap
msgid "<code>noclip       </code>The currently selected object can pass through objects"
msgstr "<code>noclip       </code>A jelenleg kiválasztott objektum át tud haladni más objektumokon"

#. type: Bullet: 'o'
#: ../E/cheats.txt:29
#, no-wrap
msgid "<code>clip         </code>Disable <code>noclip</code> on the currently selected object"
msgstr "<code>clip         </code>Letiltja a <code>noclip</code>-et a jelenleg kiválasztott objektumon"

#. type: Bullet: 'o'
#: ../E/cheats.txt:30
#, no-wrap
msgid "<code>speed        </code>Set the speed of the game to the given number, for example <code>speed 2</code> - two times faster, <code>speed 0.5</code> - two times slower, works also in main menu"
msgstr "<code>speed        </code>A játék sebességét a megadott számra állítja, például <code>speed 2</code> - kétszer gyorsabb, <code>speed 0.5</code> - kétszer lassabb, működik a főmenüben is"

#. type: Plain text
#: ../E/cheats.txt:33
#, no-wrap
msgid "These commands work also in main menu. Type them again to set them off."
msgstr "Ezek a parancsok a főmenüben is működnek. Ismételd meg őket a kikapcsoláshoz."

#. type: Bullet: 'o'
#: ../E/cheats.txt:34
#, no-wrap
msgid "<code>showstat     </code>Show debug statistics on the screen, <format key>F12</format> keyboard key has the same effect"
msgstr "<code>showstat     </code>Debug statisztikák megjelenítése a képernyőn, a <format key>F12</format> billentyűnek ugyanaz a hatása"

#. type: Bullet: 'o'
#: ../E/cheats.txt:35
#, no-wrap
msgid "<code>debugmode    </code>Enable debug mode (useful for the game developers): the verbose debugging of events and other things; make sure you run the game with <code>-loglevel trace</code> to see the effect; see also <code>-debug</code> commandline parameter"
msgstr "<code>debugmode    </code>Debug mód engedélyezése (hasznos a játék fejlesztőinek): részletes események és egyéb dolgok naplózása; győződj meg róla, hogy a játékot a <code>-loglevel trace</code> opcióval futtatod a hatás megtekintéséhez; lásd még a <code>-debug</code> parancssori paramétert"

#. type: Plain text
#: ../E/cheats.txt:42
#, no-wrap
msgid ""
"There are hidden commands in CBOT that are not even highlighted in the editor. They are considered cheating, so do not use them for \"legal\" programs. It should be fine to use them for level creation though if there is no other way.\n"
"Numbers mean order of parameters."
msgstr ""
"Vannak rejtett parancsok a CBOT-ban, amelyek még az editorban sem kiemeltek. Csalásnak számítanak, ezért ne használd őket \"törvényes\" programokban. Azonban szintkészítésnél használhatók, ha nincs más lehetőség.\n"
"A számok a paraméterek sorrendjét jelentik."

#. type: Bullet: 'o'
#: ../E/cheats.txt:46
#, no-wrap
msgid "<code>ipf          </code>Sets the number of instructions per frame, <code>1</code>: the number, default is <code>100</code>"
msgstr "<code>ipf          </code>Beállítja az utasítások számát képkockánként, <code>1</code>: a szám, alapértelmezett érték <code>100</code>"

#. type: \b; header
#: ../E/battles.txt:17
#, no-wrap
msgid "Basics of production line\\m production;"
msgstr "A gyártósor alapjai\\m gyártás;"

#. type: \b; header
#: ../E/battles.txt:4
#, no-wrap
msgid "How to control the level"
msgstr "Hogyan irányítsuk a szintet"

#. type: \t; header
#: ../E/battles.txt:6
#, no-wrap
msgid "Starting a code battle"
msgstr "Kódcsata indítása"

#. type: \t; header
#: ../E/battles.txt:11
#, no-wrap
msgid "Controlling the spectator's view"
msgstr "A nézői nézet irányítása"

#. type: Plain text
#: ../E/battles.txt:12
#, no-wrap
msgid "After a code battle is started, the camera is put into a special mode:"
msgstr "Miután a kódcsata elindult, a kamera egy speciális módba kerül:"

#. type: Plain text
#: ../E/battles.txt:7
#, no-wrap
msgid ""
"In order to start a code battle you need to:\n"
"1. Run all the necessary programs for your/all team(s).\n"
"2. Press the <button 21/> button above the mini-map."
msgstr ""
"Ahhoz, hogy elindíts egy kódcsatát, szükséges:\n"
"1. Elindítani az összes szükséges programot a csapatod/minden csapat számára.\n"
"2. Nyomd meg a <button 21/> gombot a mini-térkép felett."

#. type: Bullet: 'o'
#: ../E/battles.txt:13
#, no-wrap
msgid "One can select objects as a player normally would, but one will not see their interface and the camera does not rotate when the object rotates. One can also use numerical keyboard instead of mouse in order to rotate the object-centered camera."
msgstr "A játékosokhoz hasonlóan választhatsz objektumokat, de nem fogod látni azok felületét, és a kamera sem forog, amikor az objektum forog. Az objektum központú kamera forgatásához használhatsz numerikus billentyűzetet az egér helyett."

#. type: Bullet: 'o'
#: ../E/battles.txt:15
#, no-wrap
msgid "One can return to the normal view by pressing the <button 13/> button above the mini-map."
msgstr "A normál nézetbe visszatérhetsz, ha megnyomod a <button 13/> gombot a mini-térkép felett."

#. type: Bullet: 'o'
#: ../E/battles.txt:14
#, no-wrap
msgid "One can also switch to the free camera view by clicking somewhere on the map. One can move around in this view by using the numerical keyboard and <format key>PageUp</format>/<format key>PageDown</format> keys."
msgstr "Szabad kamera nézetre is válthatsz, ha bárhol kattintasz a térképen. Ezen a nézeten belül mozgathatod a kamerát a numerikus billentyűzet és a <format key>PageUp</format>/<format key>PageDown</format> billentyűk használatával."

#. type: Plain text
#: ../E/cbot.txt:86
#, no-wrap
msgid ""
"<code><a cbot|class>class</a>      </code>Class declararion\n"
"<code><a cbot|public>public</a>     </code>Declares a public class member\n"
"<code><a cbot|private>private</a>    </code>Declares a private class member\n"
"<code><a cbot|protected>protected</a>  </code>Declares a protected class member\n"
"<code><a cbot|static>static</a>     </code>Declares a static class member\n"
"<code><a cbot|synchro>synchronized</a> </code>Prevents simultaneous execution\n"
"<code><a cbot|new>new</a>        </code>Creates a new instance\n"
"<code><a cbot|this>this</a>       </code>Reference to the current instance\n"
"<code><a cbot|extends>extends</a>    </code>Extends a class\n"
"<code><a cbot|super>super</a>      </code>Grants access to the parent class"
msgstr ""
"<code><a cbot|class>class</a>      </code>Osztály deklarálása\n"
"<code><a cbot|public>public</a>     </code>Publikus osztálytag deklarálása\n"
"<code><a cbot|private>private</a>    </code>Privát osztálytag deklarálása\n"
"<code><a cbot|protected>protected</a>  </code>Védett osztálytag deklarálása\n"
"<code><a cbot|static>static</a>     </code>Statikus osztálytag deklarálása\n"
"<code><a cbot|synchro>synchronized</a> </code>Egymástól független futtatás megakadályozása\n"
"<code><a cbot|new>new</a>        </code>Új példány létrehozása\n"
"<code><a cbot|this>this</a>       </code>Hivatkozás az aktuális példányra\n"
"<code><a cbot|extends>extends</a>    </code>Osztály kiterjesztése\n"
"<code><a cbot|super>super</a>      </code>Hozzáférést biztosít a szülő osztályhoz"

#. type: Plain text
#: ../E/command.txt:40
#, no-wrap
msgid ""
"<format key><key speed_dec/></format> = slow down speed by half\n"
"<format key><key speed_reset/></format> = normal speed x1\n"
"<format key><key speed_inc/></format> = increase speed twice\n"
"<format key><key quicksave/></format> = quick save\n"
"<format key><key quickload/></format> = quick load\n"
"<format key><key quit/></format> = exits mission <button 11/>"
msgstr ""
"<format key><key speed_dec/></format> = lassítja a sebességet a felére\n"
"<format key><key speed_reset/></format> = normál sebesség x1\n"
"<format key><key speed_inc/></format> = kétszeres sebesség növelése\n"
"<format key><key quicksave/></format> = gyors mentés\n"
"<format key><key quickload/></format> = gyors betöltés\n"
"<format key><key quit/></format> = kilépés a küldetésből <button 11/>"

#. type: Plain text
#: ../E/cbot.txt:30
#, no-wrap
msgid ""
"<code><a cbot|detect>detect</a>     </code>Simple object detection\n"
"<code><a cbot|radar>radar</a>      </code>Advanced object detection\n"
"<code><a cbot|radarall>radarall</a>   </code>Advanced multiple objects detection\n"
"<code><a cbot|search>search</a>     </code>Object detection from a specific point\n"
"<code><a cbot|direct>direction</a>  </code>Calculates a rotation angle\n"
"<code><a cbot|dist>distance</a>   </code>Calculates a distance\n"
"<code><a cbot|dist2d>distance2d</a> </code>Calculates a distance\n"
"<code><a cbot|wait>wait</a>       </code>Waits\n"
"<code><a cbot|move>move</a>       </code>Moves forward or backward\n"
"<code><a cbot|turn>turn</a>       </code>Turns\n"
"<code><a cbot|goto>goto</a>       </code>Goes to a given position\n"
"<code><a cbot|motor>motor</a>      </code>Direct motor control\n"
"<code><a cbot|jet>jet</a>        </code>Direct jet engine control\n"
"<code><a cbot|message>message</a>    </code>Displays a message\n"
"<code><a cbot|retobj>retobject</a>  </code>Returns an object from a function\n"
"<code><a cbot|errmode>errmode</a>    </code>Error treatement control\n"
"<code><a cbot|abstime>abstime</a>    </code>Returns the absolute time\n"
"<code><a cbot|pendown>pendown</a>    </code>Starts drawing\n"
"<code><a cbot|penup>penup</a>      </code>Stops drawing\n"
"<code><a cbot|pencolor>pencolor</a>   </code>Changes the pen color\n"
"<code><a cbot|penwidth>penwidth</a>   </code>Changes the pen width\n"
"<code><a cbot|factory>factory</a>    </code>Starts construction of a bot\n"
"<code><a cbot|research>research</a>   </code>Starts a research\n"
"<code><a cbot|takeoff>takeoff</a>    </code>Launches a spaceship\n"
"<code><a cbot|isbusy>isbusy</a>     </code>Checks if object is busy\n"
"<code><a cbot|canresearch>canresearch</a></code>Checks if a technology can be researched\n"
"<code><a cbot|researched>researched</a> </code>Checks if a technology is researched\n"
"<code><a cbot|canbuild>canbuild</a>   </code>Checks if a building can be built\n"
"<code><a cbot|buildingenabled>buildingenabled</a> </code>Checks if a building is available during current mission"
msgstr ""
"<code><a cbot|detect>detect</a>     </code>Egyszerű objektum észlelés\n"
"<code><a cbot|radar>radar</a>      </code>Fejlettebb objektum észlelés\n"
"<code><a cbot|radarall>radarall</a>   </code>Fejlettebb több objektum észlelés\n"
"<code><a cbot|search>search</a>     </code>Objektum észlelés egy meghatározott pontból\n"
"<code><a cbot|direct>direction</a>  </code>Forgatási szög kiszámítása\n"
"<code><a cbot|dist>distance</a>   </code>Távolság kiszámítása\n"
"<code><a cbot|dist2d>distance2d</a> </code>Távolság kiszámítása\n"
"<code><a cbot|wait>wait</a>       </code>Várakozik\n"
"<code><a cbot|move>move</a>       </code>Előre vagy hátra mozog\n"
"<code><a cbot|turn>turn</a>       </code>Forgás\n"
"<code><a cbot|goto>goto</a>       </code>Elmegy egy adott pozícióra\n"
"<code><a cbot|motor>motor</a>      </code>Közvetlen motorvezérlés\n"
"<code><a cbot|jet>jet</a>        </code>Közvetlen sugárhajtómű-vezérlés\n"
"<code><a cbot|message>message</a>    </code>Üzenet megjelenítése\n"
"<code><a cbot|retobj>retobject</a>  </code>Visszaad egy objektumot egy függvényből\n"
"<code><a cbot|errmode>errmode</a>    </code>Hiba kezelési vezérlés\n"
"<code><a cbot|abstime>abstime</a>    </code>Abszolút idő visszaadása\n"
"<code><a cbot|pendown>pendown</a>    </code>Rajzolás kezdése\n"
"<code><a cbot|penup>penup</a>      </code>Rajzolás leállítása\n"
"<code><a cbot|pencolor>pencolor</a>   </code>Toll színének módosítása\n"
"<code><a cbot|penwidth>penwidth</a>   </code>Toll vastagságának módosítása\n"
"<code><a cbot|factory>factory</a>    </code>Bot építése kezdése\n"
"<code><a cbot|research>research</a>   </code>Kutatás kezdése\n"
"<code><a cbot|takeoff>takeoff</a>    </code>Űrhajó indítása\n"
"<code><a cbot|isbusy>isbusy</a>     </code>Megnézi, hogy az objektum foglalt-e\n"
"<code><a cbot|canresearch>canresearch</a></code>Megnézi, hogy egy technológia kutatható-e\n"
"<code><a cbot|researched>researched</a> </code>Megnézi, hogy egy technológia kutatva van-e\n"
"<code><a cbot|canbuild>canbuild</a>   </code>Megnézi, hogy egy épület építhető-e\n"
"<code><a cbot|buildingenabled>buildingenabled</a> </code>Megnézi, hogy egy épület elérhető-e az aktuális küldetés során"

#. type: Plain text
#: ../E/cbot.txt:67
#, no-wrap
msgid ""
"<code><a cbot|grab>grab</a>       </code>Picks up an object\n"
"<code><a cbot|drop>drop</a>       </code>Puts down an object\n"
"<code><a cbot|sniff>sniff</a>      </code>Sounds the subsoil\n"
"<code><a cbot|thump>thump</a>      </code>Overturns alien insects\n"
"<code><a cbot|recycle>recycle</a>    </code>Recycles a derelict bot\n"
"<code><a cbot|shield>shield</a>     </code>Extends or withdraws the shield\n"
"<code><a cbot|fire>fire</a>       </code>Fires the cannon\n"
"<code><a cbot|aim>aim</a>        </code>Rotates the cannon\n"
"<code><a cbot|build>build</a>      </code>Builds a building\n"
"<code><a cbot|flag>flag</a>       </code>Plants a flag\n"
"<code><a cbot|deflag>deflag</a>     </code>Removes a flag"
msgstr ""
