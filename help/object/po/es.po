#, no-wrap
msgid "Gravi-plant"
msgstr "Planta Gravitacional"

#. type: Image filename
#: ../E/gravi.txt:2
#, no-wrap
msgid "gravi"
msgstr "gravi"

#. type: Plain text
#: ../E/gravi.txt:3
#, no-wrap
msgid "Gravi-plants generate a 25-meter radius green energy field that pushes <a object|human>you</a> and your bots downwards, making flight impossible."
msgstr "Las plantas gravitacionales generan un campo de energía verde de 25 metros de radio que empuja hacia abajo a <a object|human>tú</a> y tus bots, haciendo imposible el vuelo."

#. type: Plain text
#: ../E/gravi.txt:6
#, no-wrap
msgid "<code>GraviPlant</code>"
msgstr "<code>PlantaGravitacional</code>"

#. type: \b; header
#: ../E/gremush.txt:1
#, no-wrap
msgid "Green Mushroom"
msgstr "Hongo Verde"

#. type: Image filename
#: ../E/gremush.txt:2
#, no-wrap
msgid "gremush"
msgstr "hongoverde"

#. type: Plain text
#: ../E/gremush.txt:3
#, no-wrap
msgid "These poisonous green mushrooms spew tiny corrosive balls upon being approached. It is recommended not to get any closer than 12 meters unless protected by a <a object|botshld>shielder</a>."
msgstr "Estos hongos verdes venenosos expulsan pequeñas bolas corrosivas al ser aproximados. Se recomienda no acercarse a menos de 12 metros a menos que estés protegido por un <a object|botshld>escudo</a>."

#. type: Plain text
#: ../E/gremush.txt:6
#, no-wrap
msgid "<code>GreenMushroom</code>"
msgstr "<code>HongoVerde</code>"
