msgstr "destroy"

#. type: Plain text
#: ../E/destroy.txt:3
#, no-wrap
msgid "This building was designed to destroy objects. The object just needs to be placed at the center of the platform and the button can be pressed. The destroyer takes care of the rest."
msgstr "Este edificio fue diseñado para destruir objetos. El objeto solo necesita colocarse en el centro de la plataforma y se puede presionar el botón. El destructor se encarga del resto."

#. type: Plain text
#: ../E/destroy.txt:9
#, no-wrap
msgid "Object that is no longer needed."
msgstr "Objeto que ya no se necesita."

#. type: Plain text
#: ../E/destroy.txt:12
#, no-wrap
msgid "Satisfaction."
msgstr "Satisfacción."

#. type: Plain text
#: ../E/destroy.txt:18
#, no-wrap
msgid "5 seconds."
msgstr "5 segundos."

#. type: Plain text
#: ../E/destroy.txt:21
#, no-wrap
msgid "<code>Destroyer</code>"
msgstr "<code>Destroyer</code>"

