#. type: \b; header
#: ../E/convert.txt:1
#, no-wrap
msgid "<button 162/> Converter"
msgstr "<button 162/> Convertidor"

#. type: Image filename
#: ../E/convert.txt:2
#, no-wrap
msgid "convert"
msgstr "convert"

#. type: Plain text
#: ../E/convert.txt:3
#, no-wrap
msgid "This building was designed to convert chunks of <a object|titanore>titanium ore</a> into usable <a object|titan>titanium cubes</a>. All <a object|human>you</a> need to do is place a chunk at the center of the platform and step back. The converter takes care of the rest."
msgstr "Este edificio fue diseñado para convertir trozos de <a object|titanore>mineral de titanio</a> en <a object|titan>cubos de titanio</a> utilizables. Todo lo que <a object|human>tú</a> necesitas hacer es colocar un trozo en el centro de la plataforma y retroceder. El convertidor se encarga del resto."

#. type: Plain text
#: ../E/convert.txt:6 ../E/labo.txt:6 ../E/repair.txt:6
#, no-wrap
msgid "Any flat surface of at least 6 meters wide."
msgstr "Cualquier superficie plana de al menos 6 metros de ancho."

