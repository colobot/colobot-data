#: ../E/target1.txt:6
#, no-wrap
msgid "<code>Target1</code>"
msgstr "<code>Target1</code>"

#. type: Plain text
#: ../E/target2.txt:3
#, no-wrap
msgid "In the flying exercise missions, brown crosses indicate positions that have to be crossed by a winged bot. They disappear as soon as a bot flies through them. They are placed in the center of the <a object|target1>Target1</a> building."
msgstr "En las misiones de ejercicio de vuelo, las cruces marrones indican posiciones que deben ser cruzadas por un bot alado. Desaparecen tan pronto como un bot vuela a través de ellas. Se colocan en el centro del edificio <a object|target1>Target1</a>."

