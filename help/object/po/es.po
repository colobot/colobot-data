#. type: \b; header
#: ../E/bromush.txt:1
#, no-wrap
msgid "Brown Mushroom"
msgstr "Hongo Marrón"

#. type: Image filename
#: ../E/bromush.txt:2
#, no-wrap
msgid "bromush"
msgstr "bromush"

#. type: Plain text
#: ../E/bromush.txt:3
#, no-wrap
msgid "The growth of these harmless brown mushrooms signifies the presence of <a object|uranore>uranium ore</a> in the subsoil. Use a <a object|botsr>sniffer</a> in order to confirm that."
msgstr "El crecimiento de estos inofensivos hongos marrones signifies the presence of <a object|uranore>mineral de uranio</a> in the subsuelo. Usa un <a object|botsr>detector</a> para confirmar eso."

#. type: Plain text
#: ../E/bromush.txt:6
#, no-wrap
msgid "<code>BrownMushroom</code>"
msgstr "<code>BrownMushroom</code>"

#. type: \b; header
#: ../E/bush.txt:1
#, no-wrap
msgid "Bush"
msgstr "Arbusto"

#. type: Image filename
#: ../E/bush.txt:2
#, no-wrap
msgid "bush"
msgstr "bush"

#. type: Plain text
#: ../E/bush.txt:3
#, no-wrap
msgid "A bush is a type of greenery that can be flattened by <a object|botrecy>heavy tracked bots</a>, allowing other bots and <a object|human>you</a> to pass through it as well."
msgstr "Un arbusto es un tipo de vegetación que puede ser aplanado por <a object|botrecy>robots pesados con oruga</a>, permitiendo que otros bots y <a object|human>tú</a> pasen a través de él."

#. type: Plain text
#: ../E/bush.txt:6
#, no-wrap
msgid "<code>Bush</code>"
msgstr "<code>Arbusto</code>"

