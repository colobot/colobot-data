msgid "Checkpoint"
msgstr "Punto de Control"

#. type: Image filename
#: ../E/waypoint.txt:2
#, no-wrap
msgid "waypoint"
msgstr "waypoint"

#. type: Plain text
#: ../E/waypoint.txt:3
#, no-wrap
msgid "In the exercises, blue crosses indicate positions that have to be crossed. They disappear as soon as a <a object|bottr>practice bot</a> crosses them."
msgstr "En los ejercicios, las cruces azules indican posiciones que deben cruzarse. Desaparecen tan pronto como un <a object|bottr>robot de práctica</a> las cruza."

#. type: Plain text
#: ../E/waypoint.txt:9
