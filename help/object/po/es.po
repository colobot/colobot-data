#. type: \b; header
#: ../E/worm.txt:1
#, no-wrap
msgid "Worm"
msgstr "Gusano"

#. type: Image filename
#: ../E/worm.txt:2
#, no-wrap
msgid "worm"
msgstr "worm"

#. type: Plain text
#: ../E/worm.txt:3
#, no-wrap
msgid "Worms transmit viruses to programmed bots. The virus alters the programming to such an extent that the bot either functions in a very erratic way or stops functioning altogether."
msgstr "Los gusanos transmiten virus a los bots programados. El virus altera la programación hasta tal punto que el bot funciona de manera muy errática o deja de funcionar por completo."

#. type: Plain text
#: ../E/worm.txt:5
#, no-wrap
msgid "Worms live in the subsoil but sometimes emerge and crawl on the surface. When they are underground they are undetectable and indestructible."
msgstr "Los gusanos viven en el subsuelo pero a veces emergen y se arrastran en la superficie. Cuando están bajo tierra son indetectables e indestructibles."

#. type: Plain text
#: ../E/worm.txt:8
#, no-wrap
msgid "<code>AlienWorm</code>"
msgstr "<code>AlienWorm</code>"

#. type: \b; header
#: ../E/wreck.txt:1
#, no-wrap
msgid "Derelict bot"
msgstr "Bot Abandonado"

#. type: Plain text
#: ../E/wreck.txt:3
#, no-wrap
msgid "A derelict bot is what's left of a bot after it has been disabled by a <a object|spider>spider</a> or by friendly fire."
msgstr "Un bot abandonado es lo que queda de un bot después de que ha sido incapacitado por una <a object|spider>araña</a> o por fuego amigo."

#. type: Plain text
#: ../E/wreck.txt:5
#, no-wrap
msgid "A <a object|botrecy>recycler</a> can convert a derelict bot back into a reusable <a object|titan>titanium cube</a>."
msgstr "Un <a object|botrecy>reciclador</a> puede convertir un bot abandonado de nuevo en un <a object|titan>cubo de titanio</a> reutilizable."

#. type: Plain text
#: ../E/wreck.txt:8
#, no-wrap
msgid "<code>Wreck</code>"
msgstr "<code>Wreck</code>"

#. type: Plain text
#: ../E/mother.txt:5
#, no-wrap
msgid "It gives birth to the following insects :"
msgstr "Da a luz a los siguientes insectos:"

