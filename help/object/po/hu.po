#. type: \b; header
#: ../E/bromush.txt:1
#, no-wrap
msgid "Brown Mushroom"
msgstr "Barna gomba"

#. type: Image filename
#: ../E/bromush.txt:2
#, no-wrap
msgid "bromush"
msgstr "barnagomba"

#. type: Plain text
#: ../E/bromush.txt:3
#, no-wrap
msgid "The growth of these harmless brown mushrooms signifies the presence of <a object|uranore>uranium ore</a> in the subsoil. Use a <a object|botsr>sniffer</a> in order to confirm that."
msgstr "Ezeknek az ártalmatlan barna gombáknak a megjelenése arra utal, hogy <a object|uranore>uránérc</a> található a talaj alatt. Használj egy <a object|botsr>szimatoló</a> robotot ennek megerősítésére."

#. type: Plain text
#: ../E/bromush.txt:6
#, no-wrap
msgid "<code>BrownMushroom</code>"
msgstr "<code>Barna gomba</code>"

#. type: \b; header
#: ../E/bush.txt:1
#, no-wrap
msgid "Bush"
msgstr "Bokor"

#. type: Image filename
#: ../E/bush.txt:2
#, no-wrap
msgid "bush"
msgstr "bokor"

#. type: Plain text
#: ../E/bush.txt:3
#, no-wrap
msgid "A bush is a type of greenery that can be flattened by <a object|botrecy>heavy tracked bots</a>, allowing other bots and <a object|human>you</a> to pass through it as well."
msgstr "A bokor egyfajta növényzet, amit <a object|botrecy>nehéz lánctalpas robotok</a> le tudnak lapítani, így más robotok és <a object|human>te</a> is át tudtok rajta haladni."

#. type: Plain text
#: ../E/bush.txt:6
#, no-wrap
msgid "<code>Bush</code>"
msgstr "<code>Bokor</code>"

#. type: \b; header
#: ../E/crystal.txt:1
#, no-wrap
msgid "Crystal"
msgstr "Kristály"

#. type: Image filename
#: ../E/crystal.txt:2
#, no-wrap
msgid "crystal"
msgstr "kristály"

#. type: Plain text
#: ../E/crystal.txt:3
#, no-wrap
msgid "The growth of these large blue crystals signifies the presence of <a object|titanore>titanium ore</a> in the subsoil. Use a <a object|botsr>sniffer</a> in order to confirm that."
msgstr "Ezeknek a nagy, kék kristályoknak a növekedése arra utal, hogy <a object|titanore>titánérc</a> található a talaj alatt. Használj egy <a object|botsr>szimatolót</a> a megerősítéshez."

#. type: Plain text
#: ../E/crystal.txt:6
#, no-wrap
msgid "<code>Crystal</code>"
msgstr "<code>Kristály</code>"

#. type: \b; header
#: ../E/gravi.txt:1
#, no-wrap
msgid "Gravi-plant"
msgstr "Gravi-növény"

#. type: Image filename
#: ../E/gravi.txt:2
#, no-wrap
msgid "gravi"
msgstr "gravi"

#. type: Plain text
#: ../E/gravi.txt:3
#, no-wrap
msgid "Gravi-plants generate a 25-meter radius green energy field that pushes <a object|human>you</a> and your bots downwards, making flight impossible."
msgstr "A gravi-növények 25 méteres sugarú zöld energiamezőt hoznak létre, amely lefelé nyom <a object|human>téged</a> és a robotjaidat, így a repülés lehetetlenné válik."

#. type: Plain text
#: ../E/gravi.txt:6
#, no-wrap
msgid "<code>GraviPlant</code>"
msgstr "<code>Gravi növény</code>"

#. type: \b; header
#: ../E/gremush.txt:1
#, no-wrap
msgid "Green Mushroom"
msgstr "Zöld gomba"

#. type: Image filename
#: ../E/gremush.txt:2
#, no-wrap
msgid "gremush"
msgstr "zöldgomba"

#. type: Plain text
#: ../E/gremush.txt:3
#, no-wrap
msgid "These poisonous green mushrooms spew tiny corrosive balls upon being approached. It is recommended not to get any closer than 12 meters unless protected by a <a object|botshld>shielder</a>."
msgstr "Ezek a mérgező zöld gombák apró maró gömböket lövellnek ki, ha megközelítik őket. Ajánlott 12 méternél nem közelebb menni hozzájuk, hacsak nincs nálad egy <a object|botshld>védőrobot</a>."

#. type: Plain text
#: ../E/gremush.txt:6
#, no-wrap
msgid "<code>GreenMushroom</code>"
msgstr "<code>Zöld gomba</code>"
