#. type: \b; header
#: ../E/derrick.txt:1
#, no-wrap
msgid "<button 161/> Derrick"
msgstr "<button 161/> Fúrótorony"

#. type: Image filename
#: ../E/derrick.txt:2
#, no-wrap
msgid "derrick"
msgstr "fúrótorony"

#. type: Plain text
#: ../E/derrick.txt:3
#, no-wrap
msgid "The derrick is intended for the extraction of raw materials."
msgstr "A fúrótorony nyersanyagok kitermelésére szolgál."

#. type: Plain text
#: ../E/derrick.txt:5
#, no-wrap
msgid "In order to determine the best site on which to erect a derrick, a <a object|botsr>sniffer</a> should be used to prospect the subsoil. The marks it lays down provide information about the specifics of what the derrick will be able to extract:"
msgstr "A fúrótorony helyének meghatározásához egy <a object|botsr>szimatoló</a> szükséges, amely feltérképezi a talajt. Az általa hagyott jelek alapján derül ki, milyen nyersanyag található az adott helyen:"

#. type: Bullet: '-'
#: ../E/derrick.txt:7
#, no-wrap
msgid "a <a object|stonspot>red cross</a> -> <a object|titanore>titanium ore</a>."
msgstr "egy <a object|stonspot>piros kereszt</a> -> <a object|titanore>titánérc</a>."

#. type: Bullet: '-'
#: ../E/derrick.txt:8
#, no-wrap
msgid "a <a object|uranspot>yellow circle</a>  -> <a object|uranore>uranium ore</a>."
msgstr "egy <a object|uranspot>sárga kör</a> -> <a object|uranore>uránérc</a>."

#. type: Plain text
#: ../E/derrick.txt:11
#, no-wrap
msgid "Any flat and geologically adequate surface of at least 2.5 meters wide."
msgstr "Bármilyen sík és geológiailag megfelelő felszín, amely legalább 2,5 méter széles."

#. type: Plain text
#: ../E/derrick.txt:14
#, no-wrap
msgid "Titanium or uranium ore in the subsoil."
msgstr "Titán- vagy uránérc a föld alatt."

#. type: Plain text
#: ../E/derrick.txt:17
#, no-wrap
msgid "Chunks of titanium or uranium ore."
msgstr "Titán- vagy uránérc darabok."

#. type: Plain text
#: ../E/derrick.txt:23
#, no-wrap
msgid "10 seconds for titanium and 30 for uranium."
msgstr "10 másodperc a titánhoz, 30 az uránhoz."

#. type: Plain text
#: ../E/derrick.txt:26
#, no-wrap
msgid "<code>Derrick</code>"
msgstr "<code>Derrick</code>"

