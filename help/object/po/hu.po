#. type: \b; header
#: ../E/target1.txt:1
#, no-wrap
msgid "Target1"
msgstr "Cél 1"

#. type: Image filename
#: ../E/target1.txt:2
#, no-wrap
msgid "target1"
msgstr "cél 1"

#. type: Plain text
#: ../E/target1.txt:3
#, no-wrap
msgid "These buildings appear in the flying exercise missions and their height can vary. In the center <a object|target2>Target2</a> is placed."
msgstr "Ezek az épületek a repülési gyakorló küldetésekben jelennek meg, és magasságuk változó lehet. A közepükön egy <a object|target2>Target2</a> található."

#. type: Plain text
#: ../E/target1.txt:6
#, no-wrap
msgid "<code>Target1</code>"
msgstr "<code>Cél 1</code>"

#. type: Plain text
#: ../E/target2.txt:3
#, no-wrap
msgid "In the flying exercise missions, brown crosses indicate positions that have to be crossed by a winged bot. They disappear as soon as a bot flies through them. They are placed in the center of the <a object|target1>Target1</a> building."
msgstr "A repülési gyakorló küldetésekben barna keresztekkel jelölik azokat a pontokat, amelyeken a szárnyas robotnak át kell repülnie. Ezek eltűnnek, amint a robot átrepül rajtuk. A <a object|target1>Target1</a> épület közepén helyezkednek el."

#. type: Image filename
#: ../E/nest.txt:2
#, no-wrap
msgid "nest"
msgstr "fészek"

#. type: Image filename
#: ../E/ruin.txt:2
#, no-wrap
msgid "ruin"
msgstr "rom"

#. type: Image filename
