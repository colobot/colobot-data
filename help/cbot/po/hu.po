"<code><format const>Bőrszín</format></code>\n"
"<code><format const>Zöld</format></code>\n"
"<code><format const>Világoszöld</format></code>\n"
"<code><format const>Kék</format></code>\n"
"<code><format const>Világoskék</format></code>"

#. type: Plain text
#: ../E/colors.txt:25
#, no-wrap
msgid "You can also draw colored symbols:"
msgstr "Színes szimbólumokat is rajzolhatsz:"

#. type: Plain text
#: ../E/colors.txt:27
