msgid ""
"<code><format const>BlackArrow</format></code>\n"
"<code><format const>RedArrow</format></code>"
msgstr ""
"<code><format const>FeketeNyíl</format></code>\n"
"<code><format const>PirosNyíl</format></code>"

#. type: \b; header
#: ../E/cos.txt:1
#, no-wrap
msgid "Instruction <code>cos</code>"
msgstr "Utasítás <code>cos</code>"

#. type: Source code
#: ../E/cos.txt:3
#, no-wrap
msgid "<c/>cos ( angle );<n/>"
msgstr "<c/>cos ( angle );<n/>"

#. type: Plain text
#: ../E/cos.txt:6 ../E/sin.txt:6
#, no-wrap
msgid "Angle in degrees."
msgstr "Szög fokban."

#. type: Plain text
