msgstr ""
"<a cbot|string>Karakterláncok</a>, <code><a cbot|strlen>strlen</a></code>, <code><a cbot|strleft>strleft</a></code>, <code><a cbot|strright>strright</a></code>, <code><a cbot|strfind>strfind</a></code>, <code><a cbot|strval>strval</a></code>, <code><a cbot|strupper>strupper</a></code>, <code><a cbot|strlower>strlower</a></code>\n"
"Die <a cbot>CBOT-Sprache</a>, <a cbot|type>Variablentypen</a> und <a cbot|category>Kategorien</a>."

#. type: \b; header
#: ../E/strright.txt:1
#, no-wrap
msgid "Instruction <code>strright</code>"
msgstr "Utasítás <code>strright</code>"

#. type: Plain text
#: ../E/strright.txt:2
#, no-wrap
msgid "Extracts the last (that is, rightmost) characters from a string."
msgstr "Kivágja az utolsó (vagyis a legjobb oldali) karaktereket egy <a cbot|string>karakterláncból</a>."

#. type: Source code
#: ../E/strright.txt:5
#, no-wrap
msgid "<c/>strright ( string, len );<n/>"
msgstr "<c/>strright ( string, len );<n/>"

#. type: Source code
#: ../E/strright.txt:11
#, no-wrap
msgid ""
"<c/>\tstring s = strright(\"abcdef\", 2);  // s is \"ef\"\n"
"\tstring s = strright(\"abc\", 10);  // s is \"abc\""
msgstr ""
"<c/>\tstring s = strright(\"abcdef\", 2);  // s = \"ef\"\n"
"\tstring s = strright(\"abc\", 10);  // s = \"abc\""

#. type: Plain text
#: ../E/strright.txt:15
#, no-wrap
msgid ""
"<code><a cbot|strlen>strlen</a></code>, <code><a cbot|strleft>strleft</a></code>, <code><a cbot|strmid>strmid</a></code>, <code><a cbot|strfind>strfind</a></code>, <code><a cbot|strval>strval</a></code>, <code><a cbot|strupper>strupper</a></code>, <code><a cbot|strlower>strlower</a></code>\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<a cbot|string>Karakterláncok</a>, <code><a cbot|strlen>strlen</a></code>, <code><a cbot|strleft>strleft</a></code>, <code><a cbot|strmid>strmid</a></code>, <code><a cbot|strfind>strfind</a></code>, <code><a cbot|strval>strval</a></code>, <code><a cbot|strupper>strupper</a></code>, <code><a cbot|strlower>strlower</a></code>\n"
"Die <a cbot>CBOT-Sprache</a>, <a cbot|type>Variablentypen</a> und <a cbot|category>Kategorien</a>."

#. type: \b; header
#: ../E/strupper.txt:1
#, no-wrap
msgid "Instruction <code>strupper</code>"
msgstr "Utasítás <code>strupper</code>"

#. type: Plain text
#: ../E/strupper.txt:2
#, no-wrap
msgid "Convert all characters in a string to uppercase."
msgstr "Konvertálja a string összes karakterét nagybetűssé."

#. type: Source code
#: ../E/strupper.txt:5
#, no-wrap
msgid "<c/>strupper ( string );<n/>"
msgstr "<c/>strupper ( string );<n/>"

#. type: Source code
#: ../E/strupper.txt:8
#, no-wrap
msgid "<c/>\tstring s = strupper(\"Abc\");  // s is \"ABC\""
msgstr "<c/>\tstring s = strupper(\"Abc\");  // s értéke \"ABC\""

#. type: Plain text
#: ../E/strupper.txt:11
#, no-wrap
msgid ""
"<code><a cbot|strlen>strlen</a></code>, <code><a cbot|strleft>strleft</a></code>, <code><a cbot|strright>strright</a></code>, <code><a cbot|strmid>strmid</a></code>, <code><a cbot|strfind>strfind</a></code>, <code><a cbot|strval>strval</a></code>, <code><a cbot|strlower>strlower</a></code>\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<a cbot|string>Stringek</a>, <code><a cbot|strlen>strlen</a></code>, <code><a cbot|strleft>strleft</a></code>, <code><a cbot|strright>strright</a></code>, <code><a cbot|strmid>strmid</a></code>, <code><a cbot|strfind>strfind</a></code>, <code><a cbot|strval>strval</a></code>, <code><a cbot|strlower>strlower</a></code>\n"
"Az <a cbot>CBOT nyelv</a>, <a cbot|type>típusok</a> és <a cbot|category>Kategóriák</a>."

#. type: \b; header
#: ../E/strval.txt:1
#, no-wrap
msgid "Instruction <code>strval</code>"
msgstr "Utasítás <code>strval</code>"

#. type: Plain text
#: ../E/strval.txt:2
#, no-wrap
msgid "Convert a string to a number. Don't confuse the string <code>\"45\"</code> that contains actually the two characters <code>4</code> and <code>5</code> and the number <code>45</code>."
msgstr "Konvertálja a stringet számmá. Ne keverje össze a <code>\"45\"</code> stringet, amely valójában két karaktert tartalmaz: <code>4</code> és <code>5</code>, a <code>45</code> számmal."

#. type: Source code
#: ../E/strval.txt:5
#, no-wrap
msgid ""
"<c/>\tstring s = \"45\"+\"12\";  // s contains \"4512\"\n"
"\tfloat  n =  45 + 12;   // n contains 67"
msgstr ""
"<c/>\tstring s = \"45\"+\"12\";  // s tartalmazza \"4512\"\n"
"\tfloat  n =  45 + 12;   // n tartalmazza 67"

#. type: Source code
#: ../E/strval.txt:9
#, no-wrap
msgid "<c/>strval ( string );<n/>"
msgstr "<c/>strval ( string );<n/>"

#. type: Source code
#: ../E/strval.txt:12
#, no-wrap
msgid ""
"<c/>\tfloat n = strval(\"1.23\");     // n is 1.23\n"
"\tfloat n = strval(\"12abc45\");  // n is 12\n"
"\tfloat n = strval(\"abc\");      // n is 0\n"
"\tfloat n = strval(\"100\")+2;    // n is 102"
msgstr ""
"<c/>\tfloat n = strval(\"1.23\");     // n értéke 1.23\n"
"\tfloat n = strval(\"12abc45\");  // n értéke 12\n"
"\tfloat n = strval(\"abc\");      // n értéke 0\n"
"\tfloat n = strval(\"100\")+2;    // n értéke 102"

#. type: Plain text
#: ../E/strval.txt:18
#, no-wrap
msgid ""
"<code><a cbot|strlen>strlen</a></code>, <code><a cbot|strleft>strleft</a></code>, <code><a cbot|strright>strright</a></code>, <code><a cbot|strmid>strmid</a></code>, <code><a cbot|strfind>strfind</a></code>, <code><a cbot|strupper>strupper</a></code>, <code><a cbot|strlower>strlower</a></code>\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<a cbot|string>Stringek</a>, <code><a cbot|strlen>strlen</a></code>, <code><a cbot|strleft>strleft</a></code>, <code><a cbot|strright>strright</a></code>, <code><a cbot|strmid>strmid</a></code>, <code><a cbot|strfind>strfind</a></code>, <code><a cbot|strupper>strupper</a></code>, <code><a cbot|strlower>strlower</a></code>\n"
"Az <a cbot>CBOT nyelv</a>, <a cbot|type>típusok</a> és <a cbot|category>Kategóriák</a>."

#. type: \b; header
#: ../E/synchro.txt:1
#, no-wrap
msgid "Instruction <code>synchronized</code> (for specialists)"
msgstr "Utazás <code>synchronized</code> (szakembereknek)"

#. type: Plain text
#: ../E/synchro.txt:2
#, no-wrap
msgid "A <a cbot|class>class</a> method can be declared <code>synchronized</code>. This is to make sure that the method is never being executed by more than one bot at the same time."
msgstr "Egy <a cbot|class>osztály</a> metódus deklarálható <code>synchronized</code> kulcsszóval. Ez biztosítja, hogy a metódust soha ne hajtsa végre egyszerre több robot."

#. type: Plain text
#: ../E/synchro.txt:4
#, no-wrap
msgid "The following example illustrates the problem:"
msgstr "Az alábbi példa szemlélteti a problémát:"

#. type: Source code
#: ../E/synchro.txt:6
#, no-wrap
msgid ""
"class blocking\n"
"{\n"
"\tstatic int nb = 33;\n"
"\tsynchronized int inc( )\n"
"\t{\n"
"\t\tint val = nb;\n"
"\t\twait ( 2 );  // wait 2 sec.\n"
"\t\tnb = nb + 1;\n"
"\t\treturn val;\n"
"\t}\n"
"}"
msgstr ""
"class blocking\n"
"{\n"
"\tstatic int nb = 33;\n"
"\tsynchronized int inc( )\n"
"\t{\n"
"\t\tint val = nb;\n"
"\t\twait ( 2 );  // wartet 2 Sek.\n"
"\t\tnb = nb + 1;\n"
"\t\treturn val;\n"
"\t}\n"
"}"

#. type: Plain text
#: ../E/synchro.txt:18
#, no-wrap
msgid ""
"What happens if two bots execute the <code>inc</code> method at the same time?\n"
"Both of them will execute <code>val=nb</code> and wait 2 seconds so both of them will have <code>val=33</code>. With <code>synchronized</code> the first bot starts execution with <code>val=33</code> and then waits 2 seconds and returns. Only once the first bot has returned from the <code>inc</code> method, the second bot will be allowed to enter the <code>inc</code> method and therefore the second bot will always have <code>val=34</code>."
msgstr ""
"Mi történik, ha két robot egyszerre hajtja végre az <code>inc</code> metódust?\n"
"Mindkettő végrehajtja a <code>val=nb</code> parancsot és vár 2 másodpercet, tehát mindkettőnek <code>val=33</code> lesz. A <code>synchronized</code> kulcsszóval az első robot <code>val=33</code>-al kezdi a végrehajtást, majd 2 másodpercet vár és visszatér. Csak akkor, amikor az első robot visszatér az <code>inc</code> metódusból, a második robot léphet be az <code>inc</code> metódusba, így a második robot mindig <code>val=34</code>-et fog kapni."

#. type: Plain text
#: ../E/synchro.txt:21
#, no-wrap
msgid "You can have more than one synchronized method in your <a cbot|class>class</a> in order to prevent simultaneous execution across more than one method. In other words: as long as a bot's program is inside a synchronized method, no other bot can enter any synchronized method of the same class."
msgstr "Több szinkronizált metódus is lehet az <a cbot|class>osztályodban</a>, hogy megakadályozd több metódus párhuzamos végrehajtását. Más szóval: amíg egy robot programja egy szinkronizált metódusban van, egy másik robot nem léphet be ugyanazon osztály bármelyik szinkronizált metódusába."

#. type: Plain text
#: ../E/synchro.txt:24
#, no-wrap
msgid ""
"<code><a cbot|class>class</a></code>, <code><a cbot|static>static</a></code>\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<code><a cbot|class>class</a></code>, <code><a cbot|static>static</a></code>\n"
"<a cbot>CBOT programozás</a>, <a cbot|type>változó típusok</a> és <a cbot|category>kategóriák</a>."

#. type: \b; header
#: ../E/term.txt:1
#, no-wrap
msgid "Semicolon"
msgstr "Pontosvessző"

#. type: Plain text
#: ../E/term.txt:2
#, no-wrap
msgid "Always use a semicolon <c/>;<n/> after a simple expression. For example: "
msgstr "Mindig használj pontosvesszőt <c/>;<n/> egy egyszerű kifejezés után. Például:"

#. type: Source code
#: ../E/term.txt:4
#, no-wrap
msgid "\tint counter = 0;"
msgstr "\tint counter = 0;"

#. type: Plain text
#: ../E/term.txt:6
#, no-wrap
msgid "However, after a <a cbot|bloc>bloc</a>, never put a semicolon:"
msgstr "Azonban egy <a cbot|bloc>blokk</a> után soha ne tegyél pontosvesszőt:"

#. type: Source code
#: ../E/term.txt:8
#, no-wrap
msgid ""
"\t{\n"
"\t\tfloat dist;\n"
"\t\tdist = distance(p1, p2);\n"
"\t} <n/>// no semicolon here!<c/>"
msgstr ""
"\t{\n"
"\t\tfloat dist;\n"
"\t\tdist = distance(p1, p2);\n"
"\t} <n/>// itt nincs pontosvessző!<c/>"

#. type: Plain text
#: ../E/term.txt:13
#, no-wrap
msgid "Do not use a semicolon either immediately after the instructions <code><a cbot|while>while</a></code>, <code><a cbot|if>if</a></code> or <code><a cbot|for>for</a></code>:"
msgstr "Ne tegyél pontosvesszőt közvetlenül a következő utasítások után: <code><a cbot|while>while</a></code>, <code><a cbot|if>if</a></code> vagy <code><a cbot|for>for</a></code>:"

#. type: Source code
#: ../E/term.txt:15
#, no-wrap
msgid ""
"\tif ( a < b ) <n/>// no semicolon here!<c/>\n"
"\t{\n"
"\t\tb = 100-a;\n"
"\t}"
msgstr ""
"\tif ( a < b ) <n/>// hier kein Strichpunkt!<c/>\n"
"\t{\n"
"\t\tb = 100-a;\n"
"\t}"

#. type: Plain text
#: ../E/term.txt:20
#, no-wrap
msgid "An instruction is always ended by a semicolon, and not by the end of the line. So you can very well put several instructions on the same line: "
msgstr "Egy utasítás mindig pontosvesszővel végződik, és nem a sor végén. Tehát nyugodtan több utasítást is írhat ugyanarra a sorra:"

#. type: Source code
#: ../E/term.txt:22
#, no-wrap
msgid ""
"\tint d=20;\n"
"\tmove(d);\n"
"\tturn(90);"
msgstr ""
"\tint d=20;\n"
"\tmove(d);\n"
"\tturn(90);"

#. type: Plain text
#: ../E/term.txt:26
#, no-wrap
msgid "Is equivalent to:"
msgstr "Ez egyenértékű a következővel:"

#. type: Source code
#: ../E/term.txt:28
#, no-wrap
msgid "\tint d=20; move(d); turn(90);"
msgstr "\tint d=20; move(d); turn(90);"

#. type: \b; header
#: ../E/testinfo.txt:1
#, no-wrap
msgid "Instruction <code>testinfo</code>"
msgstr "Utasítás <code>testinfo</code>"

#. type: Source code
#: ../E/testinfo.txt:3
#, no-wrap
msgid "<c/>testinfo ( name, power );<n/>"
msgstr "<c/>testinfo ( név, hatótáv );<n/>"

#. type: Plain text
#: ../E/testinfo.txt:5
#, no-wrap
msgid "Tests if an information exists in the closest <a object|exchange>information exchange post</a>."
msgstr "Ellenőrzi, hogy létezik-e egy információ a legközelebbi <a object|exchange>információcsere pontban</a>."

#. type: Plain text
#: ../E/testinfo.txt:8
#, no-wrap
msgid "Name of the information to be tested in the exchange post. This name is a string: it must be written in quotation marks \"\"."
msgstr "Az információ neve, amelynek létezését tesztelni szeretnénk az információcsere pontban. A név egy karakterlánc, idézőjelek között kell szerepelnie: \"\"."

#. type: Plain text
#: ../E/testinfo.txt:11
#, no-wrap
msgid "Power of the transmitter, which corresponds to the maximal distance between the transmitter and the exchange post. If the distance is longer, the function returns <code>false</code>. Default value is 10 metres."
msgstr "A vevő hatótávja, amely megfelel az adó és az információcsere pont közötti maximális távolságnak. Ha a távolság nagyobb, az utasítás <code>false</code>-t ad vissza. Az alapértelmezett érték 10 méter."

#. type: \t; header
#: ../E/testinfo.txt:13
#, no-wrap
msgid "Return: <code><a cbot|bool>bool</a></code>"
msgstr "Visszatérés: <code><a cbot|bool>bool</a></code>"

#. type: Plain text
#: ../E/testinfo.txt:14
#, no-wrap
msgid "Return <code>true</code> if the information exists. Return and <code>false</code> if the information does not exist or if the receiver is too far away from the exchange post."
msgstr "Visszatér <code>true</code>-val, ha az információ létezik. Visszatér <code>false</code>-val, ha az információ nem létezik, vagy ha a vevő túl messze van az információcsere ponttól."

#. type: Plain text
#: ../E/testinfo.txt:17
#, no-wrap
msgid ""
"<code><a cbot|receive>receive</a></code>, <code><a cbot|send>send</a></code> and <code><a cbot|delinfo>deleteinfo</a></code>.\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<code><a cbot|receive>receive</a></code>, <code><a cbot|send>send</a></code> és <code><a cbot|delinfo>deleteinfo</a></code>.\n"
"<a cbot>Programozás</a>, <a cbot|type>típusok</a> és <a cbot|category>kategóriák</a>."

#. type: \b; header
#: ../E/this.txt:1
#, no-wrap
msgid "Instruction <code>this</code>"
msgstr "Utasítás <code>this</code>"

#. type: Plain text
#: ../E/this.txt:2
#, no-wrap
msgid "Occasionally, a <a cbot|class>class</a> method needs to know the reference to the instance it is acting upon. For example the instance might want to pass it's own reference to another function. An implicit reference name <code>this</code> is available to methods and <code>this</code> is a reference to the current instance."
msgstr "Időnként egy <a cbot|class>osztály</a> metódusnak szüksége van arra, hogy tudja, melyik példányon dolgozik. Például előfordulhat, hogy a példány szeretné saját referenciáját átadni egy másik függvénynek. Az implicit referencia név <code>this</code> elérhető a metódusok számára, és a <code>this</code> a jelenlegi példányra mutat."

#. type: Source code
#: ../E/this.txt:4
#, no-wrap
msgid ""
"public class MyClass\n"
"{\n"
"\tint    m_int;\n"
"\tstring m_str;\n"
"\tvoid MyFunction()\n"
"\t{\n"
"\t\tOtherFunction(this);\n"
"\t\tm_int = 2;\n"
"\t}\n"
"}\n"
"\n"
"void OtherFunction(MyClass obj)\n"
"{\n"
"\tmessage(obj.m_str);\n"
"}\n"
"\n"
"extern void object::Test()\n"
"{\n"
"\tMyClass item();\n"
"\titem.m_str = \"Hello\";\n"
"\titem.MyFunction();  // display \"Hello\"\n"
"}"
msgstr ""
"public class MyClass\n"
"{\n"
"\tint    m_int;\n"
"\tstring m_str;\n"
"\tvoid MyFunction()\n"
"\t{\n"
"\t\tOtherFunction(this);\n"
"\t\tm_int = 2;\n"
"\t}\n"
"}\n"
"\n"
"void OtherFunction(MyClass obj)\n"
"{\n"
"\tmessage(obj.m_str);\n"
"}\n"
"\n"
"extern void object::Test()\n"
"{\n"
"\tMyClass item();\n"
"\titem.m_str = \"Hello\";\n"
"\titem.MyFunction();  // zeigt \"Hello\" an\n"
"}"

#. type: Plain text
#: ../E/this.txt:27
#, no-wrap
msgid "You can also put <code>this</code> before a field name in a method but this is not necessary. In the example above in the method <code>MyFunction()</code> following two lines have strictly the same meaning:"
msgstr "Módszeren belül is írhatja a <code>this</code> kifejezést egy mezőnév elé, de ez nem szükséges. Az előző példában a <code>MyFunction()</code> metódusban az alábbi két sor pontosan ugyanazt jelenti:"

#. type: Source code
#: ../E/this.txt:29
#, no-wrap
msgid ""
"\tm_int = 2;\n"
"\tthis.m_int = 2;  // identical"
msgstr ""
"\tm_int = 2;\n"
"\tthis.m_int = 2;  // egyenértékű"

#. type: Plain text
#: ../E/this.txt:32
#, no-wrap
msgid "In a method of the <code><a cbot|object>object</a></code> class, you can also use <code>this.</code> before a fieldname."
msgstr "Egy <code><a cbot|object>object</a></code> osztály metódusában a mezőnév elé használhatja a <code>this.</code> kifejezést is."

#. type: Source code
#: ../E/this.txt:34
#, no-wrap
msgid ""
"extern void object::Display()\n"
"{\n"
"\tmessage(orientation);\n"
"\tmessage(this.orientation); // same thing but\n"
"\t                           // more explicit\n"
"}"
msgstr ""
"extern void object::Display()\n"
"{\n"
"\tmessage(orientation);\n"
"\tmessage(this.orientation); // egyenértékű\n"
"\t                           // de kifejezőbb\n"
"}"

#. type: Plain text
#: ../E/this.txt:41
#, no-wrap
msgid "However if a field name is hidden by a parameter declaration or a variable declaration you must use <code>this</code>. In the following example the name <code>value</code> of the parameter is the same as the name of the field <code>value</code> of the <a cbot|class>class</a> <code>MyClass</code>, we must therefore write <code>this.value</code> in order to distinguish the field from the parameter."
msgstr "Ha azonban egy mező neve rejtve van egy paraméterdeklaráció vagy egy változódeklaráció által, akkor használnia kell a <code>this</code> kifejezést. Az alábbi példában a <code>value</code> paraméter neve ugyanaz, mint a <code>value</code> mező neve a <a cbot|class>MyClass</a> osztályban, ezért <code>this.value</code>-ot kell írni a mező és a paraméter megkülönböztetésére."

#. type: Source code
#: ../E/this.txt:43
#, no-wrap
msgid ""
"public class MyClass\n"
"{\n"
"\tint  value;\n"
"\tvoid Put( int value )\n"
"\t{\n"
"\t\tthis.value = value;\n"
"\t}\n"
"}"
msgstr ""
"public class MyClass\n"
"{\n"
"\tint  value;\n"
"\tvoid Put( int value )\n"
"\t{\n"
"\t\tthis.value = value;\n"
"\t}\n"
"}"

#. type: \b; header
#: ../E/thump.txt:1
#, no-wrap
msgid "Instruction <code>thump</code>"
msgstr "Utasítás <code>thump</code>"

#. type: Source code
#: ../E/thump.txt:3
#, no-wrap
msgid "<c/>thump ( );<n/>"
msgstr "<c/>thump ( );<n/>"

#. type: Plain text
#: ../E/thump.txt:5
#, no-wrap
msgid "Activates the weapon system of the <a object|bottump>thumper</a>, that turns ants and spiders belly up and makes them completely harmless for a while."
msgstr "Aktiválja a <a object|bottump>thumper</a> fegyverrendszerét, amely felfordítja az összes hangyát és pókot, és így egy időre teljesen ártalmatlanná teszi őket."

#. type: Plain text
#: ../E/thump.txt:8
#, no-wrap
msgid ""
"Zero if everything is OK, a value different from zero if an error occurred. \n"
"<code>== 0 </code>Thumping performed\n"
"<code>!= 0 </code>Operation impossible"
msgstr ""
"Null, ha minden rendben van, egy nem null érték, ha hiba történt. \n"
"<code>== 0 </code>Stampálás végrehajtva\n"
"<code>!= 0 </code>Művelet lehetetlen"

#. type: \b; header
#: ../E/topo.txt:1
#, no-wrap
msgid "Instruction <code>topo</code>"
msgstr "Utásítás <code>topo</code>"

#. type: Source code
#: ../E/topo.txt:3
#, no-wrap
msgid "<c/>topo ( position );<n/>"
msgstr "<c/>topo ( pozíció );<n/>"

#. type: Plain text
#: ../E/topo.txt:5
#, no-wrap
msgid "Returns the altitude of the ground at a give position. The altitude zero corresponds to sea level. A negative value indicates that at this position ground is covered with water. "
msgstr "Visszaadja a talaj magasságát a megadott pozíción. A nulla magasság a tengerszintet jelenti. A negatív érték azt jelzi, hogy ezen a ponton a talajt víz borítja."

#. type: Plain text
#: ../E/topo.txt:8
#, no-wrap
msgid "Coordinates of the position whose altitude you want to know. "
msgstr "A pozíció koordinátái, amelynek magasságát szeretné megtudni."

#. type: Plain text
#: ../E/topo.txt:11
#, no-wrap
msgid "Altitude of the ground at the given position."
msgstr "A talaj magassága a megadott helyen."

#. type: \b; header
#: ../E/true.txt:1
#, no-wrap
msgid "Type <code>true</code>"
msgstr "Típus <code>true</code>"

#. type: Plain text
#: ../E/true.txt:2
#, no-wrap
msgid "This value means that a condition is true; it is one of the two values that a <a cbot|bool>boolean</a> <a cbot|var>variable</a> can take."
msgstr "Ez az érték azt jelenti, hogy egy feltétel igaz; ez az egyik a két érték közül, amelyet egy <a cbot|bool>logikai</a> <a cbot|var>változó</a> felvehet."

#. type: \b; header
#: ../E/turn.txt:1
#, no-wrap
msgid "Instruction <code>turn</code>"
msgstr "Utasítás <code>turn</code>"

#. type: Plain text
#: ../E/turn.txt:2
#, no-wrap
msgid "Use the instruction <c/>turn();<n/> to instruct the bot to perform a rotation on itself of a certain number of degrees."
msgstr "Használja a <c/>turn();<n/> utasítást, hogy a robot egy meghatározott fokszámú forgatást végezzen el saját magán."

#. type: Plain text
#: ../E/turn.txt:5
#, no-wrap
msgid "90 degreed means a quarter turn, 180 degrees means a half turn. A positive angle will perform a counterclockwise rotation, a negative angle means a clockwise rotation. Here are some examples with <c/>turn();<n/>:"
msgstr "A 90 fokos forgatás negyedkörös elfordulást jelent, a 180 fokos forgatás félkörös elfordulást jelent. A pozitív szög ellentétes irányú forgatást végez, a negatív szög az óramutató járásával megegyező irányú forgatást jelent. Íme néhány példa a <c/>turn();<n/> használatával:"

#. type: Plain text
#: ../E/turn.txt:7
#, no-wrap
msgid ""
"<c/>turn(90);<n/>  quarter turn to the left\n"
"<c/>turn(-90);<n/> quarter turn to the right (negative angle)\n"
"<c/>turn(180);<n/> half turn"
msgstr ""
"<c/>turn(90);<n/>  Negyedkörös elfordulás balra\n"
"<c/>turn(-90);<n/> Negyedkörös elfordulás jobbra (negatív szög)\n"
"<c/>turn(180);<n/> Félkörös elfordulás"

#. type: Plain text
#: ../E/turn.txt:11
#, no-wrap
msgid "In order to turn the bot towards an object found with the instruction <c/><a cbot|radar>radar</a>();<n/>, you must calculate the rotation angle with the instruction <code><a cbot|direct>direction</a>()</code>:"
msgstr "Ahhoz, hogy a robotot egy <c/><a cbot|radar>radar</a>();<n/> utasítással megtalált objektum felé fordítsuk, ki kell számítani a forgási szöget a <code><a cbot|direct>direction</a>()</code> utasítással:"

#. type: Source code
#: ../E/turn.txt:13
#, no-wrap
msgid ""
"\titem = <a cbot|radar>radar</a>(AlienSpider);\n"
"\tturn(<a cbot|direct>direction</a>(item.position));"
msgstr ""
"\titem = <a cbot|radar>radar</a>(AlienSpider);\n"
"\tturn(<a cbot|direct>direction</a>(item.position));"

#. type: Plain text
#: ../E/turn.txt:16
#, no-wrap
msgid "After these lines, just fire the cannon, and there is one hostile element less."
msgstr "Miután végrehajtottuk ezeket a sorokat, csak lője ki a ágyút, és máris egy ellenséges elem eltűnik."

#. type: Source code
#: ../E/turn.txt:20
#, no-wrap
msgid "<c/>turn ( angle );<n/>"
msgstr "<c/>turn ( szög );<n/>"

#. type: Plain text
#: ../E/turn.txt:22
#, no-wrap
msgid "Turns the bot with a given angle, right or left, without moving either forward or backward. "
msgstr "A robotot egy adott szögben forgatja, jobbra vagy balra, anélkül hogy előre vagy hátra mozogna."

#. type: Plain text
#: ../E/turn.txt:25
#, no-wrap
msgid "Angle of the required rotation, in degrees. A positive value turns left, a negative value turns right. <code>turn(180)</code> turns round completely. "
msgstr "A kívánt forgás szöge fokokban. A pozitív érték balra fordít, a negatív érték jobbra fordít. <code>turn(180)</code> teljes fordulatot hajt végre."

#. type: Plain text
#: ../E/turn.txt:28
#, no-wrap
msgid ""
"Zero if everything is OK, or a value different from zero if an error occurred. \n"
"<code>== 0 </code>rotation performed\n"
"<code>!= 0 </code>rotation impossible"
msgstr ""
"Null, ha minden rendben van, vagy nem nulla érték, ha hiba történt. \n"
"<code>== 0 </code>forgás végrehajtva\n"
"<code>!= 0 </code>forgás lehetetlen"

#. type: \b; header
#: ../E/type.txt:1
#, no-wrap
msgid "Variable types"
msgstr "Változó típusok"

#. type: Plain text
#: ../E/type.txt:2
#, no-wrap
msgid "When you define a <a cbot|var>variable</a>, you must give two elements: "
msgstr "Ha változót deklarálsz, két elemet kell megadnod:"

#. type: Bullet: '1)'
#: ../E/type.txt:4
#, no-wrap
msgid "a name"
msgstr "nevet"

#. type: Bullet: '2)'
#: ../E/type.txt:5
#, no-wrap
msgid "a type"
msgstr "a változó típusát"

#. type: Plain text
#: ../E/type.txt:7
#, no-wrap
msgid "Once you defined a variable, you can use it to put information in it. However, the information that a variable can contain must always be of the correct type: a variable of type <a cbot|float>float</a> can not contain a string, etc."
msgstr "Miután deklaráltál egy változót, használhatod információk tárolására benne. Azonban a változó által tárolt információknak mindig a megfelelő típusúnak kell lenniük: egy <a cbot|float>float</a> típusú változó nem tartalmazhat szöveget, stb."

#. type: Source code
#: ../E/type.txt:11
#, no-wrap
msgid "<code><a cbot|int>int</a></code>"
msgstr "<code><a cbot|int>int</a></code>"

#. type: Plain text
#: ../E/type.txt:12
#, no-wrap
msgid "For a whole number (12, -500, etc.)."
msgstr "Egész számokhoz (12, -500, stb.)."

#. type: Source code
#: ../E/type.txt:14
#, no-wrap
msgid "<code><a cbot|float>float</a></code>"
msgstr "<code><a cbot|float>float</a></code>"

#. type: Plain text
#: ../E/type.txt:15
#, no-wrap
msgid "For a real number (12, 3.14, 0.2, -99.98, etc.)."
msgstr "Valós számokhoz (12, 3.14, 0.2, -99.98, stb.)."

#. type: Source code
#: ../E/type.txt:17
#, no-wrap
msgid "<code><a cbot|bool>bool</a></code>"
msgstr "<code><a cbot|bool>bool</a></code>"

#. type: Plain text
#: ../E/type.txt:18
#, no-wrap
msgid "For a boolean variable, that can only take the values <code>true</code> or <code>false</code>."
msgstr "Bools értékű változókhoz, amelyek csak <code><a cbot|true>true</a></code> (igaz) vagy <code><a cbot|false>false</a></code> (hamis) értéket vehetnek fel."

#. type: Source code
#: ../E/type.txt:20
#, no-wrap
msgid "<code><a cbot|string>string</a></code>"
msgstr "<code><a cbot|string>string</a></code>"

#. type: Plain text
#: ../E/type.txt:21
#, no-wrap
msgid "For texts (\"Hello!\", \"No object found\", etc.)"
msgstr "Szövegekhez (\"Hello!\", \"Nincs objektum találva\", stb.)"

#. type: Source code
#: ../E/type.txt:23
#, no-wrap
msgid "<code><a cbot|point>point</a></code>"
msgstr "<code><a cbot|point>point</a></code>"

#. type: Plain text
#: ../E/type.txt:24
#, no-wrap
msgid "For the coordinates of a point in space; a variable of this type consists of three parts named x, y and z."
msgstr "Egy térbeli pont koordinátáihoz; egy ilyen típusú változó három részből áll, amelyek neve x, y és z."

#. type: Source code
#: ../E/type.txt:26
#, no-wrap
msgid "<code><a cbot|object>object</a></code>"
msgstr "<code><a cbot|object>object</a></code>"

#. type: Plain text
#: ../E/type.txt:27
#, no-wrap
msgid "A variable of this type contains the information about an object (bot, building, enemy, etc.)."
msgstr "Egy ilyen típusú változó információkat tartalmaz egy objektumról (robot, épület, ellenség, stb.)."

#. type: Source code
#: ../E/type.txt:29
#, no-wrap
msgid "<code><a cbot|void>void</a></code>"
msgstr "<code><a cbot|void>void</a></code>"

#. type: Plain text
#: ../E/type.txt:30
#, no-wrap
msgid "This type is an \"empty type\", that you use when you do not want to specify a type."
msgstr "Ez a típus egy \"üres típus\", amit akkor használsz, amikor nem akarod megadni a típust."

#. type: \b; header
#: ../E/var.txt:1
#, no-wrap
msgid "Variables"
msgstr "Változók"

#. type: Plain text
#: ../E/var.txt:2
#, no-wrap
msgid "A variable is like a box, where you can put some information. The content of the variable can change during the execution of the program."
msgstr "A változó olyan, mint egy doboz, amibe információt tehetsz. A változó tartalma a program futása közben változhat."

#. type: Plain text
#: ../E/var.txt:4
#, no-wrap
msgid "For example, you can use a variable to count the number of titanium ore units that the grabber has collected and carried to the converter. First, you must find a name for it: the name should not be too long, but explain by itself what the variable is used for. Let's call it <code>countTit</code>. This variable must contain only whole numbers, so choose the type <code>int</code>. At the beginning of the program, you must declare the variable. Then you put the value <code>0</code> into the variable, and every time you grab a titanium ore, you increase the variable by <code>1</code>. At every moment, the variable contains the number of titanium ore units that the grabber collected."
msgstr "Például egy változó segítségével számolhatod a titániumérc egységeinek számát, amelyet a grabber összegyűjtött és a konverterhez vitt. Először is nevet kell adnod neki: a név ne legyen túl hosszú, de önállóan magyarázza el, mire használjuk a változót. Hívjuk <code>countTit</code>-nak. Ez a változó csak egész számokat tartalmazhat, így válaszd a <code>int</code> típust. A program elején deklarálnod kell a változót. Ezután állítsd be a változó értékét <code>0</code>-ra, és minden alkalommal, amikor egy titániumércet megfogsz, növeld a változót <code>1</code>-gyel. Így a változó mindig tartalmazni fogja a grabber által összegyűjtött titániumérc egységek számát."

#. type: Plain text
#: ../E/var.txt:6
#, no-wrap
msgid ""
"For the declaration of the variable, write the following line: \n"
"<c/><s/>\tint  countTit;<n/>"
msgstr ""
"A változó deklarálásához írd be a következő sort: \n"
"<c/><s/>\tint  countTit;<n/>"

#. type: Plain text
#: ../E/var.txt:9
#, no-wrap
msgid ""
"To put <code>0</code> into the variable, write:\n"
"<c/><s/>\tcountTit = 0;<n/>"
msgstr ""
"Ha <code>0</code>-t szeretnél beállítani a változóban, írd be:\n"
"<c/><s/>\tcountTit = 0;<n/>"

#. type: Plain text
#: ../E/var.txt:12
#, no-wrap
msgid ""
"At every titanium ore grabbed, write:\n"
"<c/><s/>\tcountTit = countTit + 1<n/>"
msgstr ""
"Számolj minden titániumérc összegyűjtésével:\n"
"<c/><s/>\tcountTit = countTit + 1<n/>"

#. type: Plain text
#: ../E/var.txt:15
#, no-wrap
msgid ""
"You have much freedom in the choice of the name for a variable, you can call them by any name, f. ex.: <code>dist</code>, <code>direct</code>, <code>p2</code>, <code>a</code>, <code>x</code>, <code>nothing_2_shoot_at</code>, etc.\n"
"A variable name must always begin with a letter. It can be followed by any combination of letters, digits or the underscore character <code>_</code>. You can of course not use the keywords of the CBOT language like <code><a cbot|for>for</a></code>, <code><a cbot|while>while</a></code>, <code><a cbot|break>break</a></code>, <code><a cbot|continue>continue</a></code>, <code>do</code>, etc.\n"
"You should be careful about the choice of the names that you give to variables; writing a program can become very difficult if you forget the names of variables or if you do not remember what they are used for. Elaborate your own system to find variable names, and do not use names like <code>Bmo45</code>, <code>a</code> or <code>tgBinX</code>."
msgstr ""
"Nagyon sok szabadságot kaptál a változók nevének kiválasztásában, például ilyen neveket adhatsz: <code>dist</code>, <code>direct</code>, <code>p2</code>, <code>a</code>, <code>x</code>, <code>nothing_2_shoot_at</code>, stb.\n"
"Egy változónévnek mindig betűvel kell kezdődnie. Ezt követheti bármilyen betűk, számok és az alulvonás karaktere <code>_</code> kombinációja. Természetesen nem használhatod a CBOT nyelv kulcsszavait, mint például a <code><a cbot|for>for</a></code>, <code><a cbot|while>while</a></code>, <code><a cbot|break>break</a></code>, <code><a cbot|continue>continue</a></code>, <code>do</code>, stb.\n"
"Legyél körültekintő a változónevek kiválasztásakor; egy program írása nagyon nehézzé válhat, ha elfelejted a változók neveit, vagy nem emlékszel, mire használják őket. Alakíts ki saját rendszert a változónevek megtalálásához, és ne használj olyan neveket, mint <code>Bmo45</code>, <code>a</code> vagy <code>tgBinX</code>."

#. type: Plain text
#: ../E/var.txt:19
#, no-wrap
msgid "In the example above, the keyword <code>int</code> indicates that this variable can contain only whole numbers, which is adequate to counting objects. If you want to measure a distance, better use a variable that can contain also real numbers, with a fractional part (like 3.45 or 0.034): in this case, use the type <code>float</code>."
msgstr "A fenti példában az <code>int</code> kulcsszó azt jelzi, hogy ez a változó csak egész számokat tartalmazhat, ami megfelelő az objektumok számolásához. Ha távolságot szeretnél mérni, inkább olyan változót használj, amely valós számokat is tartalmazhat, tizedes résszel (például 3.45 vagy 0.034): ebben az esetben használd a <code>float</code> típust."

#. type: Plain text
#: ../E/var.txt:21
#, no-wrap
msgid "In fact, a variable is made up of three parts:"
msgstr "Valójában egy változó három részből áll:"

#. type: Bullet: '1)'
#: ../E/var.txt:22
#, no-wrap
msgid "the name,"
msgstr "a név,"

#. type: Bullet: '2)'
#: ../E/var.txt:23
#, no-wrap
msgid "the type of the information stored inside,"
msgstr "az abban tárolt információ típusa,"

#. type: Bullet: '3)'
#: ../E/var.txt:24
#, no-wrap
msgid "the content, i.e. the information itself."
msgstr "a tartalom, azaz maga az információ."

#. type: \t; header
#: ../E/var.txt:26
#, no-wrap
msgid "the name"
msgstr "A név"

#. type: Plain text
#: ../E/var.txt:27
#, no-wrap
msgid "You need the name to be able to distinguish the different variables from each other."
msgstr "A névre van szükséged, hogy meg tudd különböztetni a különböző változókat egymástól."

#. type: \t; header
#: ../E/var.txt:29
#, no-wrap
msgid "the type"
msgstr "A típus"

#. type: Plain text
#: ../E/var.txt:30
#, no-wrap
msgid ""
"The <a cbot|type>type</a> determines what kind of information the variable can contain. According to the type, a variable can contain a whole number, a real number, a string, the coordinates of a point, information about an object, etc. \n"
"Here is a list of the most common variable types:"
msgstr ""
"A <a cbot|type>típus</a> meghatározza, hogy milyen típusú információt tartalmazhat a változó. A típus szerint a változó tartalmazhat egész számot, valós számot, karakterláncot, egy pont koordinátáit, egy objektumról szóló információkat, stb. \n"
"Itt található a leggyakoribb változótípusok listája:"

#. type: Bullet: 'o'
#: ../E/var.txt:32
#, no-wrap
msgid "<code><a cbot|int>int</a></code> for a whole number (12, -500, etc.)"
msgstr "<code><a cbot|int>int</a></code> egész számokhoz (12, -500, stb.)"

#. type: Bullet: 'o'
#: ../E/var.txt:33
#, no-wrap
msgid "<code><a cbot|float>float</a></code> for a real number (3.14, 0.2, -99.98, etc.)"
msgstr "<code><a cbot|float>float</a></code> valós számokhoz (3.14, 0.2, -99.98, stb.)"

#. type: Bullet: 'o'
#: ../E/var.txt:34
#, no-wrap
msgid "<code><a cbot|string>string</a></code> for a character string (\"Hello!\", \"No object found\", etc.)"
msgstr "<code><a cbot|string>string</a></code> karakterláncokhoz (\"Hello!\", \"Objektum nem található\", stb.)"

#. type: Bullet: 'o'
#: ../E/var.txt:35
#, no-wrap
msgid "<code><a cbot|point>point</a></code> for a x,y,z-coordinate in space"
msgstr "<code><a cbot|point>point</a></code> x,y,z koordinátákhoz a térben"

#. type: Bullet: 'o'
#: ../E/var.txt:36
#, no-wrap
msgid "<code><a cbot|object>object</a></code> for information about an object (bot, building, etc.)"
msgstr "<code><a cbot|object>object</a></code> objektumok információihoz (robot, épület, stb.)"

#. type: \t; header
#: ../E/var.txt:38
#, no-wrap
msgid "The content"
msgstr "A tartalom"

#. type: Plain text
#: ../E/var.txt:39
#, no-wrap
msgid "The content of a variable is an information of the kind specified in the type. It can change during the execution of the program. "
msgstr "A változó tartalma olyan információ, amely megfelel a típusának. A tartalom a program végrehajtása során változhat."

#. type: Plain text
#: ../E/var.txt:41
#, no-wrap
msgid ""
"Once you declared a variable, it still does not contain any value. Before you can use it, you must put a value inside: \n"
"<c/><s/>\tint  i, j;"
msgstr ""
"Miután deklaráltál egy változót, még nem tartalmaz értéket. Mielőtt használni tudnád, értéket kell hozzárendelni: \n"
"<c/><s/>\tint  i, j;"

#. type: Source code
#: ../E/var.txt:43
#, no-wrap
msgid ""
"\tj = 25;  // j takes the value 25\n"
"\tj = i;   // can not write this, because i has got no content yet."
msgstr ""
"\tj = 25;  // j értéke 25 lesz\n"
"\tj = i;   // ezt nem lehet írni, mert i még nem tartalmaz értéket."

#. type: Plain text
#: ../E/var.txt:46
#, no-wrap
msgid ""
"You can also declare a variable and put a value inside in the same line, writing: \n"
"<c/><s/>\tint  countTit = 0;"
msgstr ""
"Szintén egy sorban deklarálhatod a változót és hozzárendelhetsz egy értéket: \n"
"<c/><s/>\tint  countTit = 0;"

#. type: Plain text
#: ../E/var.txt:49
#, no-wrap
msgid ""
"When you assign a value to a variable with the equals sign <code>=</code>, the value on the right side is copied into the value on the left side. Consider the following example: \n"
"<c/><s/>\tint  i, j;"
msgstr ""
"Amikor egy változónak értéket rendelsz az egyenlőségjellel <code>=</code>, a jobb oldali érték a bal oldali változóba másolódik. Nézd meg a következő példát: \n"
"<c/><s/>\tint  i, j;"

#. type: Source code
#: ../E/var.txt:51
#, no-wrap
msgid ""
"\ti = 5+2;  // i takes the value 7\n"
"\tj = i+6;  // j takes the value of i plus 6, this is 13\n"
"\ti = j;    // i takes the value of j, this is 13"
msgstr ""
"\ti = 5+2;  // i értéke 7 lesz\n"
"\tj = i+6;  // j értéke i + 6, tehát 13\n"
"\ti = j;    // i értéke j, tehát 13"

#. type: Plain text
#: ../E/var.txt:55
#, no-wrap
msgid "At the end of this example, both variables <code>i</code> and <code>j</code> contain the value <code>13</code>."
msgstr "A példának a végén mindkét változó, <code>i</code> és <code>j</code>, tartalmazza a <code>13</code> értéket."

#. type: Plain text
#: ../E/var.txt:57
#, no-wrap
msgid ""
"The following assignment is not correct, because on the left side of the equals sign <code>=</code>, there can be only a variable name:\n"
"<c/><s/>\ti+2 = j;  // impossible"
msgstr ""
"A következő hozzárendelés nem helyes, mert az egyenlőségjel <code>=</code> bal oldalán csak egy változó neve szerepelhet, nem pedig egy teljes számítás:\n"
"<c/><s/>\ti+2 = j;  // lehetetlen"

#. type: Plain text
#: ../E/var.txt:60
#, no-wrap
msgid ""
"If you want to exchange the values of two variables, you must use a third variable. Here is an example to exchange the content of two variables <code>a</code> and <code>b</code> :\n"
"<c/><s/>\tint temp;"
msgstr ""
"Ha két változó értékét szeretnéd kicserélni, egy harmadik változót kell használnod. Itt egy példa arra, hogyan lehet kicserélni két változó, <code>a</code> és <code>b</code> tartalmát:\n"
"<c/><s/>\tint temp;"

#. type: Source code
#: ../E/var.txt:62
#, no-wrap
msgid ""
"\ttemp = a;  // temp takes the value of a\n"
"\ta = b;     // the content of b is copied into a\n"
"\tb = temp;  // the content of temp is copied into b"
msgstr ""
"\ttemp = a;  // a értéke kerül a temp-be\n"
"\ta = b;     // b tartalma kerül a-ba\n"
"\tb = temp;  // temp tartalma kerül b-be"

#. type: \b; header
#: ../E/void.txt:1
#, no-wrap
msgid "Type <code>void</code>"
msgstr "Típus <code>void</code>"

#. type: Plain text
#: ../E/void.txt:2
#, no-wrap
msgid "Use this type when you want to declare a function that returns nothing."
msgstr "Használd ezt a típust, ha olyan függvényt deklarálsz, amely nem ad vissza semmit."

#. type: Plain text
#: ../E/void.txt:4
#, no-wrap
msgid ""
"Example:\n"
"<c/><s/>void MyFunction(int a)"
msgstr "<c/><s/>void MyFunction(int a)"

#. type: Source code
#: ../E/void.txt:6
#, no-wrap
msgid ""
"{\n"
"\t...\n"
"}"
msgstr ""
"{\n"
"\t...\n"
"}"

#. type: \b; header
#: ../E/wait.txt:1
#, no-wrap
msgid "Instruction <code>wait</code>"
msgstr "Utasítás <code>wait</code>"

#. type: Plain text
#: ../E/wait.txt:2
#, no-wrap
msgid "The instruction <c/>wait();<n/> instructs the bot to wait for some seconds, according to the value written in brackets."
msgstr "A <c/>wait();<n/> utasítás arra utasítja a robotot, hogy várjon néhány másodpercet, a zárójelben szereplő érték szerint."

#. type: Plain text
#: ../E/wait.txt:5
#, no-wrap
msgid "In order to wait until the <a object|power>power cell</a> is recharged on a power station, wait 5 seconds with <c/>wait(5);<n/>."
msgstr "Ha a robot egy erőműben vár, akkor legfeljebb 5 másodpercet kell várni, amíg a <a object|power>akkumulátor</a> fel van töltve. Írd tehát be: <c/>wait(5);<n/>."

#. type: Plain text
#: ../E/wait.txt:7
#, no-wrap
msgid "In order to wait until the <a object|convert>converter</a> finished transforming some <a object|titanore>titanium ore</a> in a <a object|titan>titanium cube</a>, wait 15 seconds with <c/>wait(15);<n/>."
msgstr "Ha egy <a object|convert>konverter</a> előtt vársz, amíg az átalakítja a <a object|titanore>titanércet</a> <a object|titan>titanium kockává</a>, várj 15 másodpercet a következővel: <c/>wait(15);<n/>."

#. type: Source code
#: ../E/wait.txt:11
#, no-wrap
msgid "<c/>wait ( time );<n/>"
msgstr "<c/>wait ( idő );<n/>"

#. type: Plain text
#: ../E/wait.txt:13
#, no-wrap
msgid "Waits for a moment."
msgstr "Vár egy pillanatot."

#. type: Plain text
#: ../E/wait.txt:16
#, no-wrap
msgid "Specifies the time that the bot must wait."
msgstr "Megadja az időt másodpercekben, amelyet a robotnak várnia kell."

#. type: \b; header
#: ../E/while.txt:1
#, no-wrap
msgid "Instruction <code>while</code>"
msgstr "Utásítás <code>while</code>"

#. type: Plain text
#: ../E/while.txt:2
#, no-wrap
msgid "The instruction <code>while () {}</code> is used to repeat a set of instructions several times."
msgstr "A <code>while () {}</code> utasítás arra szolgál, hogy egy sor utasítást többször ismételjen meg."

#. type: Plain text
#: ../E/while.txt:5
#, no-wrap
msgid "The most frequent use of <code>while</code> consists in repeating a set of instructions again and again. In order to achieve this, write <code>while (true) {}</code> and put the instructions to be repeated in braces <code>{}</code>. As an example, here is a program that repeats again and again the following actions:"
msgstr "A <code>while</code> leggyakoribb használata egy sor utasítás ismételgetése. Ennek eléréséhez írja be a <code>while (true) {}</code> utasítást, és helyezze el az ismételni kívánt utasításokat a <code>{}</code> zárójelek közé. Például itt van egy program, amely folyamatosan ismétli az alábbi műveleteket:"

#. type: Bullet: 'o'
#: ../E/while.txt:6
#, no-wrap
msgid "look for a spider,"
msgstr "keres egy pókot,"

#. type: Bullet: 'o'
#: ../E/while.txt:7
#, no-wrap
msgid "turn towards it,"
msgstr "megfordul felé,"

#. type: Bullet: 'o'
#: ../E/while.txt:8
#, no-wrap
msgid "shoot."
msgstr "lő."

#. type: Source code
#: ../E/while.txt:10
#, no-wrap
msgid ""
"\twhile (true)\n"
"\t{\n"
"\t\titem = <a cbot|radar>radar</a>(AlienSpider);\n"
"\t\t<a cbot|turn>turn</a>(direction(item.position));\n"
"\t\t<a cbot|fire>fire</a>(1);\n"
"\t}"
msgstr ""
"\twhile (true)\n"
"\t{\n"
"\t\titem = <a cbot|radar>radar</a>(AlienSpider);\n"
"\t\t<a cbot|turn>turn</a>(direction(item.position));\n"
"\t\t<a cbot|fire>fire</a>(1);\n"
"\t}"

#. type: Plain text
#: ../E/while.txt:17
#, no-wrap
msgid "Just execute this program once, and it will kill all spiders around it."
msgstr "Ezt a programot csak egyszer kell végrehajtani, és minden pók, amely a közelében van, elpusztul."

#. type: Source code
#: ../E/while.txt:21
#, no-wrap
msgid ""
"<code>while ( condition )\n"
"{\n"
"\t</code>Instructions ...<c/>\n"
"}"
msgstr ""
"<code>while ( feltétel )\n"
"{\n"
"\t</code>Utasítások ...<c/>\n"
"}"

#. type: Plain text
#: ../E/while.txt:26
#, no-wrap
msgid "This instruction allows you to perform the instructions inside the <a cbot|bloc>block</a> several times."
msgstr "Ez az utasítás lehetővé teszi, hogy a <a cbot|bloc>blokk</a> belsejében található utasításokat többször hajtsa végre, amíg a feltétel igaz."

#. type: Plain text
#: ../E/while.txt:28
#, no-wrap
msgid "Be careful not to confuse the instruction <code>while( ) { }</code> with the instruction <c/><a cbot|do>do</a> { } while( );<n/>; the latter tests the condition only after the instructions in the block have been performed a first time. "
msgstr "Légy óvatos, hogy ne keverd össze a <code>while( ) { }</code> utasítást a <c/><a cbot|do>do</a> { } while( );<n/>; utasítással; az utóbbi csak akkor ellenőrzi a feltételt, miután az utasításokat a blokkban első alkalommal végrehajtották."

#. type: Source code
#: ../E/while.txt:34
#, no-wrap
msgid ""
"<c/>int i = 0;\n"
"while ( i < 10 )\n"
"{\n"
"\t<n/>Instructions ...<c/>\n"
"\ti = i+1;\n"
"}"
msgstr ""
"<c/>int i = 0;\n"
"while ( i < 10 )\n"
"{\n"
"\t<n/>Utasítások ...<c/>\n"
"\ti = i+1;\n"
"}"

#. type: Plain text
#: ../E/while.txt:42
#, no-wrap
msgid "Do not put a <a cbot|term>semicolon</a> at the end of the line <code>while ( )</code>."
msgstr "Ne tegyél pontosvesszőt a sor végére <code>while ( )</code>."

#. type: Plain text
#: ../E/while.txt:44
#, no-wrap
msgid "The instructions <code><a cbot|break>break</a></code> and <code><a cbot|continue>continue</a></code> can be useful inside a block following the instruction <code>while { }</code>."
msgstr "A <code><a cbot|break>break</a></code> és <code><a cbot|continue>continue</a></code> utasítások hasznosak lehetnek egy blokkban, amely a <code>while { }</code> utasítást követi."

#. type: \b; header
#: ../E/writeln.txt:1
#, no-wrap
msgid "Instruction <code>writeln</code>"
msgstr "Utasítás <code>writeln</code>"

#. type: Plain text
#: ../E/writeln.txt:2
#, no-wrap
msgid "Write one line of text to an open file in the files/ folder. This is a method of the <code><a cbot|file>file</a></code> class. This is the reason why we always write <code>handle.writeln()</code>:"
msgstr "Egy sor szöveget ír egy nyitott fájlba a files/ mappában. Ez a <code><a cbot|file>file</a></code> osztály egy metódusa. Ezért írjuk mindig <code>handle.writeln()</code>:"

#. type: Source code
#: ../E/writeln.txt:4
#, no-wrap
msgid "\thandle.writeln(\"abc\");"
msgstr "\thandle.writeln(\"abc\");"

#. type: Plain text
#: ../E/writeln.txt:6
#, no-wrap
msgid "The file must have been opened for writing (<code>\"w\"</code>) with the <code><a cbot|open>open</a></code> instruction. The line will automatically be terminated by the end of line characters 0x0D (CR) and 0x0A (LF)."
msgstr "A fájlt írásra kell megnyitni (<code>\"w\"</code>) a <code><a cbot|open>open</a></code> utasítással. A sor automatikusan lezárul a sorvégi karakterekkel 0x0D (CR) és 0x0A (LF)."

#. type: Source code
#: ../E/writeln.txt:9
#, no-wrap
msgid "<c/>handle.writeln ( string );<n/>"
msgstr "<c/>handle.writeln ( string );<n/>"

#. type: Source code
#: ../E/writeln.txt:13
#, no-wrap
msgid "\twriteln(\"Line of text\");"
msgstr "\twriteln(\"Egy sor szöveg\");"

#. type: Source code
#: ../E/writeln.txt:15
#, no-wrap
msgid ""
"\tstring s1 = \"abc\";\n"
"\tstring s2 = \"def\";\n"
"\twriteln(s1 + \" \" + s2);"
msgstr ""
"\tstring s1 = \"abc\";\n"
"\tstring s2 = \"def\";\n"
"\twriteln(s1 + \" \" + s2);"

#. type: Plain text
#: ../E/writeln.txt:20
#, no-wrap
msgid ""
"<code><a cbot|file>file</a></code>, <code><a cbot|open>open</a></code>, <code><a cbot|close>close</a></code>, <code><a cbot|readln>readln</a></code> and <code><a cbot|eof>eof</a></code>.\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<code><a cbot|file>file</a></code>, <code><a cbot|open>open</a></code>, <code><a cbot|close>close</a></code>, <code><a cbot|readln>readln</a></code> és <code><a cbot|eof>eof</a></code>.\n"
"<a cbot>Programozás</a>, <a cbot|type>típusok</a> és <a cbot|category>kategóriák</a>."

#. type: Source code
#: ../E/array.txt:22
#, no-wrap
msgid ""
"{\n"
"\tint a[5];\n"
"\ta[7] = 123;  // no error at compile time\n"
"\t             // but error at run time\n"
"}"
msgstr ""
"{\n"
"\tint a[5];\n"
"\ta[7] = 123;  // Nincs hiba a fordítási időben\n"
"\t             // de hiba a futási időben\n"
"}"

#. type: Source code
#: ../E/bloc.txt:4
#, no-wrap
msgid ""
"\t{\n"
"\t\tfloat  t;\n"
"\t\tt = a;\n"
"\t\ta = b;\n"
"\t\tb = t;  // switches round a and b\n"
"\t}"
msgstr ""
"\t{\n"
"\t\tfloat  t;\n"
"\t\tt = a;\n"
"\t\ta = b;\n"
"\t\tb = t;  // vertauscht a und b\n"
"\t}"

#. type: Source code
#: ../E/bloc.txt:22
#, no-wrap
msgid ""
"\tif ( a < b )\n"
"\t{\n"
"\t\t<n/>instruction 1<c/>;\n"
"\t\t<n/>instruction 2<c/>;\n"
"\t}\n"
"\t<n/>instruction 3<c/>;"
msgstr ""
"\tif ( a < b )\n"
"\t{\n"
"\t\t<n/>Utasítás 1<c/>;\n"
"\t\t<n/>Utasítás 2<c/>;\n"
"\t}\n"
"\t<n/>Utasítás 3<c/>;"

#. type: \t; header
#: ../E/expr.txt:132 ../E/radar.txt:68
#, no-wrap
msgid "Remark"
msgstr "Megjegyzés"

#. type: \t; header
