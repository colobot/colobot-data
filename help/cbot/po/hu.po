#. type: \b; header
#: ../E/switch.txt:1
#, no-wrap
msgid "Instructions <code>switch</code>, <code>case</code> and <code>default</code>"
msgstr "A <code>switch</code>, <code>case</code> és <code>default</code> utasítások"

#. type: Plain text
#: ../E/switch.txt:2
#, no-wrap
msgid "With the instruction <code>switch() {}</code> you can execute a proper set of instructions (a case) basing on some value."
msgstr "A <code>switch() {}</code> utasítással megfelelő utasításkészletet (egy case-t) hajthatsz végre egy érték alapján."

#. type: Plain text
#: ../E/switch.txt:7
#, no-wrap
msgid "See the following <a cbot|function>function</a>: the bot will be <a cbot|wait>waiting</a> a proper amount of time for a certain task to be completed:"
msgstr "Lásd az alábbi <a cbot|function>funkciót</a>: a bot <a cbot|wait>várni</a> fog egy megfelelő ideig, amíg egy bizonyos feladat befejeződik:"

#. type: Source code
#: ../E/switch.txt:9
#, no-wrap
msgid ""
"public void WaitForTaskCompleted(object building)\n"
"{\n"
"\tint cat = building.category;\n"
"\t<a cbot|if>if</a> (cat == Converter) wait(15);\n"
"\telse if (cat == BotFactory) wait(15);\n"
"\telse if (cat == PowerPlant) wait(12);\n"
"\telse message(\"Undefined wait time\", DisplayError);\n"
"}"
msgstr ""
"public void WaitForTaskCompleted(object building)\n"
"{\n"
"\tint cat = building.category;\n"
"\t<a cbot|if>if</a> (cat == Converter) wait(15);\n"
"\telse if (cat == BotFactory) wait(15);\n"
"\telse if (cat == PowerPlant) wait(12);\n"
"\telse message(\"Nincs meghatározva várakozási idő\", DisplayError);\n"
"}"

#. type: Plain text
#: ../E/switch.txt:18
#, no-wrap
msgid "This function can be also written using the <code>switch() {}</code> instruction:"
msgstr "Ez a funkció a <code>switch() {}</code> utasítással is megírható:"

#. type: Source code
#: ../E/switch.txt:20
#, no-wrap
msgid ""
"public void WaitForTaskCompleted(object building)\n"
"{\n"
"\tswitch (building.category)\n"
"\t{\n"
"\t\tcase Converter: wait(15); break;\n"
"\t\tcase BotFactory: wait(15); break;\n"
"\t\tcase PowerPlant: wait(12); break;\n"
"\t\tdefault: message(\"Undefined wait time\", DisplayError);\n"
"\t}\n"
"}"
msgstr ""
"public void WaitForTaskCompleted(object building)\n"
"{\n"
"\tswitch (building.category)\n"
"\t{\n"
"\t\tcase Converter: wait(15); break;\n"
"\t\tcase BotFactory: wait(15); break;\n"
"\t\tcase PowerPlant: wait(12); break;\n"
"\t\tdefault: message(\"Nincs meghatározott várakozási idő\", DisplayError);\n"
"\t}\n"
"}"

#. type: Plain text
#: ../E/switch.txt:31
#, no-wrap
msgid "Which way to write this kind of choice structures, is a matter of taste."
msgstr "Hogy milyen módon írod le az ilyen típusú választási struktúrákat, az ízlés kérdése."

#. type: Plain text
#: ../E/switch.txt:33
#, no-wrap
msgid "You can also make cases like this:"
msgstr "Egyes eseteket így is létrehozhatsz:"

#. type: Source code
#: ../E/switch.txt:35
#, no-wrap
msgid ""
"switch (building.category)\n"
"{\n"
"\tcase Converter:\n"
"\tcase BotFactory:\n"
"\t\twait(15); break;\n"
"\tcase PowerPlant: wait(12); break;\n"
"\tdefault: message(\"Undefined wait time\", DisplayError);\n"
"}"
msgstr ""
"switchelés (building.category)\n"
"{\n"
"\tcase Converter:\n"
"\tcase BotFactory:\n"
"\t\twait(15); break;\n"
"\tcase PowerPlant: wait(12); break;\n"
"\tdefault: üzenet(\"Nem meghatározott várakozási idő\", DisplayError);\n"
"}"

#. type: Plain text
#: ../E/switch.txt:44
#, no-wrap
msgid "<a object|convert>Converter</a> and <a object|factory>bot factory</a> have the same waiting time, so in order to not write the same instructions twice, we made multiple cases run the same code. In fact, all code after the highest case used will be executed if we do not <code><a cbot|break>break</a></code> it."
msgstr "<a object|convert>Converter</a> és <a object|factory>bot factory</a> ugyanazzal a várakozási idővel rendelkezik, így annak érdekében, hogy ne írjuk le kétszer ugyanazokat az utasításokat, több case-t is létrehoztunk, amelyek ugyanazt a kódot futtatják. Valójában az összes kód, amely a legnagyobb case után következik, végrehajtódik, ha nem használunk <code><a cbot|break>break</a></code> utasítást."

#. type: Source code
#: ../E/switch.txt:48
#, no-wrap
msgid ""
"<c/>switch ( value )\n"
"{\n"
"\tcase value1: instructions1\n"
"\tcase value2: instructions2\n"
"\t...\n"
"\tcase valueN: instructionsN\n"
"\tdefault: instructionsDefault\n"
"}"
msgstr ""
"<c/>switch ( value )\n"
"{\n"
"\tcase value1: instructions1\n"
"\tcase value2: instructions2\n"
"\t...\n"
"\tcase valueN: instructionsN\n"
"\tdefault: instructionsDefault\n"
"}"

#. type: Plain text
#: ../E/switch.txt:57
#, no-wrap
msgid "With this conditional structure you can execute <code>instructions1</code> or <code>instructions2</code> ... or <code>instructionsN</code> or <code>instructionsDefault</code> depending on the <code>value</code>."
msgstr "Ezzel a feltételes szerkezettel végrehajthatod a <code>instructions1</code>, <code>instructions2</code> ... vagy <code>instructionsN</code>, vagy <code>instructionsDefault</code> utasításokat a <code>value</code> értéke alapján."

#. type: Plain text
#: ../E/switch.txt:59
#, no-wrap
msgid ""
"If the <code>value</code> is equal to <code>value1</code>, <code>instructions1</code> to <code>N</code> (including <code>instructionsDefault</code>) are executed.\n"
"If the <code>value</code> is equal to <code>value2</code>, <code>instructions2</code> to <code>N</code> (including <code>instructionsDefault</code>) are executed.\n"
"And so on.\n"
"If the <code>value</code> is equal to <code>valueN</code>, <code>instructionsN</code> and <code>instructionsDefault</code> are executed.\n"
"If the <code>value</code> is not equal to any value in the given cases, <code>instructionsDefault</code> are executed."
msgstr ""
"Ha a <code>value</code> értéke egyenlő a <code>value1</code>-tel, akkor a <code>instructions1</code> -tól <code>N</code>-ig (beleértve a <code>instructionsDefault</code>-ot) kerül végrehajtásra.\n"
"Ha a <code>value</code> értéke egyenlő a <code>value2</code>-tól, akkor a <code>instructions2</code> -tól <code>N</code>-ig (beleértve a <code>instructionsDefault</code>-ot) kerül végrehajtásra.\n"
"És így tovább.\n"
"Ha a <code>value</code> értéke egyenlő a <code>valueN</code>-tól, akkor a <code>instructionsN</code> és a <code>instructionsDefault</code> kerül végrehajtásra.\n"
"Ha a <code>value</code> nem egyezik meg egyik megadott értékkel sem, akkor a <code>instructionsDefault</code> kerül végrehajtásra."

#. type: Plain text
#: ../E/switch.txt:65
#, no-wrap
msgid "You can exit from the the <code>switch() {}</code> instruction using <code><a cbot|break>break</a></code>."
msgstr "Kiléphetsz a <code>switch() {}</code> utasításból a <code><a cbot|break>break</a></code> használatával."

#. type: Plain text
#: ../E/switch.txt:68
#, no-wrap
msgid "Do not put a <a cbot|term>semicolon</a> at the end of the <code>switch ( ) { }</code> instruction."
msgstr "Ne tegyél pontosvesszőt a <code>switch ( ) { }</code> utasítás végére."

#. type: \b; header
#: ../E/takeoff.txt:1
#, no-wrap
msgid "Instruction <code>takeoff</code>"
msgstr "Utasítás <code>takeoff</code>"

#. type: Plain text
#: ../E/takeoff.txt:11
#, no-wrap
msgid ""
"Normally an error stops the program. You can prevent the program from stopping on errors by using the <code><a cbot|errmode>errmode</a>(0)</code> instruction. A value different from zero if an error occurred is then returned by <code>takeoff()</code>.\n"
"<code>== 0 </code>Spaceship takes off\n"
"<code>!= 0 </code>Spaceship could not take off (e.g. mission is not finished yet)"
msgstr ""
"Normál esetben egy hiba megállítja a programot. Megakadályozhatod a program leállását hibák esetén az <code><a cbot|errmode>errmode</a>(0)</code> utasítás használatával. Ha hiba történt, akkor egy nem nulla értéket ad vissza a <code>takeoff()</code>.\n"
"<code>== 0 </code>Űrhajó felszáll\n"
"<code>!= 0 </code>Űrhajó nem tudott felszállni (pl. a küldetés még nincs befejezve)"

#. type: \b; header
#: ../E/tan.txt:1
#, no-wrap
msgid "Instruction <code>tan</code>"
msgstr "Utasítás <code>tan</code>"

#. type: Source code
#: ../E/tan.txt:3
#, no-wrap
msgid "<c/>tan ( angle );<n/>"
msgstr "<c/>tan ( szög );<n/>"

#. type: Plain text
#: ../E/tan.txt:6
#, no-wrap
msgid "Angle in degrees (except multiples of 90)."
msgstr "Szög fokokban (kivéve a 90 fokos többszöröseit)."

#. type: Plain text
#: ../E/tan.txt:9
#, no-wrap
msgid "Tangent of the angle."
msgstr "Az szög tangense."

#. type: \b; header
#: ../E/trunc.txt:1
#, no-wrap
msgid "Instruction <code>trunc</code>"
msgstr "Útmutató <code>trunc</code>"

#. type: Source code
#: ../E/trunc.txt:3
#, no-wrap
msgid "<c/>trunc ( value );<n/>"
msgstr "<c/>trunc ( érték );<n/>"

#. type: Plain text
#: ../E/trunc.txt:4
#, no-wrap
msgid "Truncation is a method of approximating a decimal number by dropping all decimal places past a certain point without rounding. For positive numbers, it works like the <c/><a cbot|floor>floor();</a><n/> function, and for negative numbers, it works like the <c/><a cbot|ceil>ceil();</a><n/> function. It can be said that it rounds towards zero."
msgstr "A levágás egy módszer a tizedes számok közelítésére, úgy hogy eltávolítjuk az összes tizedesjegyet egy bizonyos pont után, kerekítés nélkül. Pozitív számoknál úgy működik, mint a <c/><a cbot|floor>floor();</a><n/> függvény, negatív számoknál pedig úgy, mint a <c/><a cbot|ceil>ceil();</a><n/> függvény. Mondhatjuk, hogy ez a nulla felé kerekít."

#. type: Plain text
#: ../E/trunc.txt:10
#, no-wrap
msgid "Truncated <code>value</code>. For example, <code>trunc(-2.5)</code> is <code>-2.00</code>."
msgstr "Levágott <code>érték</code>. Például, <code>trunc(-2.5)</code> = <code>-2.00</code>."

#. type: Plain text
#: ../E/category.txt:4
#, no-wrap
msgid "In a program, categories are always displayed like that: <format const>category</format>. If a category isn't highlighted, it is misspelled. Caps and lower cases should be kept as is."
msgstr "A programban a kategóriák mindig így jelennek meg: <format const>kategória</format>. Ha egy kategória nincs kiemelve, akkor el van írva. A nagy- és kisbetűket változtatás nélkül kell hagyni."

#. type: Plain text
#: ../E/type.txt:9
#, no-wrap
msgid "In a program, the name of a type is always displayed like that: <format type>type</format>. If the name of a type is not highlighted, this means that the name is misspelled. Type names are always written with lower case characters. Here is a list of the different types: "
msgstr "A programban a típus neve mindig így jelenik meg: <format type>típus</format>. Ha a típus neve nincs kiemelve, az azt jelenti, hogy el van írva. A típusneveket mindig kisbetűkkel kell írni. Itt található a különböző típusok listája:"

#. type: \b; header
#: ../E/produce.txt:1
#, no-wrap
msgid "Instruction <code>produce</code>"
msgstr "Útmutató <code>produce</code>"

#. type: Source code
#: ../E/produce.txt:3
#, no-wrap
msgid "<c/>produce ( position, orientation, category, program, power );<n/>"
msgstr "<c/>produce ( hely, irány, kategória, program, teljesítmény );<n/>"

#. type: Bullet: 'o'
#: ../E/produce.txt:4
#, no-wrap
msgid "r"
msgstr "r"

#. type: Source code
#: ../E/produce.txt:5
#, no-wrap
msgid "<c/>produce ( category, power );<n/>"
msgstr "<c/>produce ( kategória, teljesítmény );<n/>"

#. type: Plain text
#: ../E/produce.txt:7
#, no-wrap
msgid "Immediately creates an <a cbot|category>object</a>."
msgstr "Azonnal létrehoz egy <a cbot|kategória>objektumot</a>."

#. type: \t; header
#: ../E/produce.txt:12
#, no-wrap
msgid "orientation: <code><a cbot|float>float</a></code>"
msgstr "irány: <code><a cbot|float>lebegőpontos</a></code>"

#. type: Plain text
#: ../E/produce.txt:13
#, no-wrap
msgid "Orientation (angle) of the object."
msgstr "Az objektum iránya (szög)."

#. type: Plain text
#: ../E/produce.txt:16
#, no-wrap
msgid "<a cbot|category>Category</a> of the object."
msgstr "Az objektum <a cbot|kategória>Kategóriája</a>."

#. type: \t; header
#: ../E/produce.txt:18
#, no-wrap
msgid "program: <code><a cbot|string>string</a></code>"
msgstr "program: <code><a cbot|string>string</a></code>"

#. type: Plain text
#: ../E/produce.txt:22
#, no-wrap
msgid "Energy level."
msgstr "Energia szint."

#. type: \t; header
#: ../E/produce.txt:24
#, no-wrap
msgid "Return: <code><a cbot|void>void</a></code>"
msgstr "Visszatérés: <code><a cbot|void>void</a></code>"

#. type: Plain text
#: ../E/produce.txt:25
#, no-wrap
msgid "Nothing."
msgstr "Semmi."

#. type: \b; header
#: ../E/produce.txt:27
#, no-wrap
msgid "Example usage"
msgstr "Példa használat"

#. type: Plain text
#: ../E/produce.txt:28
#, no-wrap
msgid "It is used by <a object|mother>AlienQueen</a> to produce <a object|egg>AlienEggs</a>."
msgstr "Az <a object|mother>AlienQueen</a> használja <a object|egg>AlienEggs</a> előállítására."

#. type: Plain text
#: ../E/produce.txt:10
#, no-wrap
msgid "Where object will be created. The second syntax creates the object at the current bot's position."
msgstr "Ahol az objektum létrejön. A második szintaxis az objektumot a jelenlegi robot pozíciójában hozza létre."

#. type: Plain text
#: ../E/produce.txt:19
#, no-wrap
msgid "Program for the object. Will have effect only for programmable objects like robots or aliens."
msgstr "Program az objektumhoz. Csak a programozható objektumokra, mint például robotok vagy idegenek, lesz hatása."

#. type: Plain text
#: ../E/expr.txt:2
#, no-wrap
msgid "Expressions are used for various calculations with many different variables, which return the desired result. What distinguishes them from standard instructions are operators, which are described below."
msgstr "Az kifejezések különböző számításokhoz használatosak sokféle változóval, amelyek a kívánt eredményt adják vissza. Ami megkülönbözteti őket a szokásos utasításoktól, azok az operátorok, amelyekről az alábbiakban olvashatsz."

#. type: \b; header
#: ../E/expr.txt:8
#, no-wrap
msgid "Binary operations"
msgstr "Bináris műveletek"

#. type: Plain text
#: ../E/expr.txt:9
#, no-wrap
msgid "Assuming that <code>a</code>, <code>b</code> can be values of declared and initialized variables of types <code>t1</code> and <code>t2</code>, the binary operations can be described as follows:"
msgstr "Feltételezve, hogy <code>a</code>, <code>b</code> a deklarált és inicializált változók értékei, amelyek <code>t1</code> és <code>t2</code> típusúak, a bináris műveletek az alábbiak szerint írhatók le:"

#. type: Source code
#: ../E/expr.txt:10
#, no-wrap
msgid "<code>r = a op b</code>"
msgstr "<code>r = a op b</code>"

#. type: Plain text
#: ../E/expr.txt:11
#, no-wrap
msgid "Where <code>r</code> is the result of the operation and <code>op</code> is a binary operator which works with values of types <code>t1</code> and <code>t2</code>."
msgstr "Ahol <code>r</code> a művelet eredménye, és <code>op</code> egy bináris operátor, amely a <code>t1</code> és <code>t2</code> típusú változók értékeivel működik."

#. type: \t; header
#: ../E/expr.txt:13
#, no-wrap
msgid "Order of operations"
msgstr "A műveletek sorrendje"

#. type: Plain text
#: ../E/expr.txt:14
#, no-wrap
msgid "Let <code>a op1 b op2 c</code> be a legal expression, then the following rules apply:"
msgstr "Tegyük fel, hogy <code>a op1 b op2 c</code> egy érvényes kifejezés, akkor a következő szabályok érvényesek:"

#. type: Bullet: 'o'
#: ../E/expr.txt:15
#, no-wrap
msgid "If <code>op1 == op2</code> or <code>op1</code> is as strong as <code>op2</code> or <code>op1</code> is stronger than <code>op2</code>, first calculate <code>a op1 b</code> and store its result in a temporary variable <code>r</code>, then calculate <code>r op2 c</code>, which is the final result of the expression."
msgstr "Ha <code>op1 == op2</code> vagy <code>op1</code> olyan erős, mint <code>op2</code>, vagy <code>op1</code> erősebb, mint <code>op2</code>, először számítsuk ki <code>a op1 b</code> értékét, és tároljuk el egy ideiglenes változóban, <code>r</code>-ben, majd számítsuk ki <code>r op2 c</code> értékét, ami a kifejezés végső eredménye."

#. type: Bullet: 'o'
#: ../E/expr.txt:16
#, no-wrap
msgid "If <code>op1</code> is weaker than <code>op2</code>, first calculate <code>b op2 c</code> and store its result in a temporary variable <code>r</code>, then calculate <code>a op1 r</code>, which is the final result of the expression."
msgstr "Ha az <code>op1</code> gyengébb, mint az <code>op2</code>, először számítsuk ki a <code>b op2 c</code> kifejezést, és az eredményt tároljuk egy <code>r</code> nevű ideiglenes változóban, majd számítsuk ki az <code>a op1 r</code> kifejezést, ami a teljes kifejezés végső eredménye."

#. type: Plain text
#: ../E/expr.txt:18
#, no-wrap
msgid "Note: an operation can be made stronger by surrounding it in brackets, so for example assuming that <code>op1</code> is weaker than <code>op2</code>, in an expression <code>(a op1 b) op2 c</code> the <code>a op1 b</code> operation will be executed first."
msgstr "Megjegyzés: egy művelet erősebbé tehető, ha zárójelek közé helyezzük, tehát például ha feltételezzük, hogy <code>op1</code> gyengébb, mint <code>op2</code>, akkor a <code>(a op1 b) op2 c</code> kifejezésben először a <code>a op1 b</code> művelet fog végrehajtódni."

#. type: Plain text
#: ../E/expr.txt:20
#, no-wrap
msgid "Tip: always use brackets if you are not sure about the order of operations, do not try to remember how strong are each of the operators. Generally it should be fairly obvious."
msgstr "Tipp: mindig használj zárójeleket, ha nem vagy biztos a műveletek sorrendjében, ne próbáld megjegyezni, hogy melyik operátor milyen erős. Általában elég nyilvánvaló kell, hogy legyen."

#. type: Plain text
#: ../E/expr.txt:22
#, no-wrap
msgid ""
"Here is a complicated example, which uses arithemtic operations described below, showing how expressions are calculated:\n"
"<c/>Assume a, b, c, d, x, y, z, e are all initialized variables of type float or int. Then the following expression should be calculated the following way:\n"
"  a * b + c - d / x % (y * z) - e =\n"
"= r1 + c - d / x % (y * z) - e    = , r1 = a * b\n"
"= r2 - d / x % (y * z) - e        = , r2 = r1 + c\n"
"= r2 - r3 % (y * z) - e           = , r3 = d / x\n"
"= r2 - r3 % r4 - e                = , r4 = y * z\n"
"= r2 - r5 - e                     = , r5 = r3 % r4\n"
"= r6 - e                          = , r6 = r2 - r5\n"
"= r7                                , r7 = r6 - e\n"
"r7 is the final result of this expression."
msgstr ""
"Íme egy bonyolult példa, amely az alábbiakban leírt aritmetikai műveleteket használja, és bemutatja, hogyan számítják ki a kifejezéseket:\n"
"<c/>Tegyük fel, hogy a, b, c, d, x, y, z, e mind float vagy int típusú inicializált változók. Ezután a következő kifejezést így kell kiszámítani:\n"
"  a * b + c - d / x % (y * z) - e =\n"
"= r1 + c - d / x % (y * z) - e    = , r1 = a * b\n"
"= r2 - d / x % (y * z) - e        = , r2 = r1 + c\n"
"= r2 - r3 % (y * z) - e           = , r3 = d / x\n"
"= r2 - r3 % r4 - e                = , r4 = y * z\n"
"= r2 - r5 - e                     = , r5 = r3 % r4\n"
"= r6 - e                          = , r6 = r2 - r5\n"
"= r7                                , r7 = r6 - e\n"
"r7 az eredmény a kifejezés végén."

#. type: \b; header
#: ../E/expr.txt:35
#, no-wrap
msgid "Assignment operator"
msgstr "Értékadás operátor"

#. type: Plain text
#: ../E/expr.txt:36
#, no-wrap
msgid "<code>=</code> is the assignment operator. It is used to store the result of an expression in a variable."
msgstr "<code>=</code> az értékadás operátor. Arra használják, hogy egy kifejezés eredményét egy változóban tárolják."

#. type: Plain text
#: ../E/expr.txt:38
#, no-wrap
msgid "On the left side of this operator there must be so called l-value and on the right side - r-value. L-values are just <a cbot|var>variables</a><n/>, r-values are expressions or just usual values. This makes the assignment operator kind of special, because what is l-value is pretty restrictive (it cannot be an expression, constant and so on, only single variable). Also, the type of l-value must match the type of r-value (unless a conversion is possible, for example assigning a <code><a cbot|float>float</a></code> to <code><a cbot|int>int</a></code>)."
msgstr "Ennek az operátornak a bal oldalán úgynevezett l-értéknek, a jobb oldalán pedig r-értéknek kell lennie. Az l-értékek egyszerűen <a cbot|var>változók</a><n/>, az r-értékek kifejezések vagy egyszerű értékek. Ez teszi az értékadás operátort különlegessé, mivel az l-érték meglehetősen korlátozó (nem lehet kifejezés, konstans stb., csak egyetlen változó). Ezen kívül az l-érték típusának meg kell egyeznie az r-érték típusával (kivéve, ha átalakítás lehetséges, például egy <code><a cbot|float>float</a></code> típusú érték <code><a cbot|int>int</a></code> típusúra történő hozzárendelése)."

#. type: Source code
#: ../E/expr.txt:42
#, no-wrap
msgid ""
" float a;\n"
" float b = 2.0 * (a = 4.0); // b == 8.0"
msgstr ""
" float a;\n"
" float b = 2.0 * (a = 4.0); // b == 8.0"

#. type: Plain text
#: ../E/expr.txt:45
#, no-wrap
msgid "This example is actually really confusing, but this property is actually useful, because it lets doing something like this:"
msgstr "Ez a példa valójában nagyon zavaró, de ez a tulajdonság hasznos, mert lehetővé teszi, hogy ilyesmit csináljunk:"

#. type: Source code
#: ../E/expr.txt:47
#, no-wrap
msgid ""
" float a, b, c, d, e;\n"
" a = b = c = d = e = 1.0; // a == b == c == d == e == 1.0"
msgstr ""
" float a, b, c, d, e;\n"
" a = b = c = d = e = 1.0; // a == b == c == d == e == 1.0"

#. type: \b; header
#: ../E/expr.txt:50
#, no-wrap
msgid "Basic arithmetic operations"
msgstr "Alapvető aritmetikai műveletek"

#. type: Plain text
#: ../E/expr.txt:51
#, no-wrap
msgid "Binary operators below are working with fundamental number types (<code><a cbot|int>int</a></code>, <code><a cbot|float>float</a></code>)."
msgstr "Az alábbi bináris operátorok az alapvető szám típusokkal (<code><a cbot|int>int</a></code>, <code><a cbot|float>float</a></code>) működnek."

#. type: \t; header
#: ../E/expr.txt:53 ../E/expr.txt:90 ../E/expr.txt:116 ../E/expr.txt:141
#: ../E/expr.txt:164
#, no-wrap
msgid "List"
msgstr "Lista"

#. type: \t; header
#: ../E/expr.txt:60
#, no-wrap
msgid "Notes"
msgstr "Megjegyzések"

#. type: Bullet: 'o'
#: ../E/expr.txt:61
#, no-wrap
msgid "The <code>*</code>, <code>/</code>, <code>%</code> are all stronger than <code>+</code> and <code>-</code>."
msgstr "A <code>*</code>, <code>/</code>, <code>%</code> mind erősebbek, mint a <code>+</code> és a <code>-</code>."

#. type: Bullet: 'o'
#: ../E/expr.txt:62
#, no-wrap
msgid "The result <a cbot|type>type</a> is always <code><a cbot|float>float</a></code>. If <code>a</code> or <code>b</code> are of type <code><a cbot|int>int</a></code>, they are automatically converted to <code><a cbot|float>float</a></code>. Note: this means that results of intermediate calculations tends to be as precise as possible, the precision is lost only during converting the final (<code><a cbot|float>float</a></code>) result to <code><a cbot|int>int</a></code>, for example by the assignment <code>=</code> operator."
msgstr "Az eredmény <a cbot|type>type</a> mindig <code><a cbot|float>float</a></code>. Ha <code>a</code> vagy <code>b</code> típusa <code><a cbot|int>int</a></code>, automatikusan <code><a cbot|float>float</a></code>-ra konvertálódnak. Megjegyzés: ez azt jelenti, hogy az intermedier számítások eredményei általában a lehető legpontosabbak, a pontosság csak akkor veszhet el, amikor az végső (<code><a cbot|float>float</a></code>) eredményt <code><a cbot|int>int</a></code>-re konvertáljuk, például az <code>=</code> operátorral."

#. type: \t; header
#: ../E/expr.txt:64
#, no-wrap
msgid "Real life examples"
msgstr "Valódi életbeli példák"

#. type: \t; header
#: ../E/expr.txt:82
#, no-wrap
msgid "Compound assignment operators"
msgstr "Összetett hozzárendelési operátorok"

#. type: Plain text
#: ../E/expr.txt:83
#, no-wrap
msgid "Besides the <code>=</code> operator for variable assignment there are several compound-assignment operators."
msgstr "A változó hozzárendelésére szolgáló <code>=</code> operátor mellett több összetett hozzárendelési operátor is létezik."

#. type: Plain text
#: ../E/expr.txt:85
#, no-wrap
msgid "The compound-assignment operators combine the <code>=</code> assignment operator with another binary operator such as <code>+</code> or <code>-</code>. Compound-assignment operators perform the operation specified by the additional operator and then assign the result to the left operand. For example, a compound-assignment expression such as"
msgstr "Az összetett hozzárendelési operátorok a <code>=</code> hozzárendelési operátort kombinálják egy másik bináris operátorral, mint például a <code>+</code> vagy <code>-</code>. Az összetett hozzárendelési operátorok végrehajtják az extra operátor által meghatározott műveletet, majd az eredményt hozzárendelik a bal oldali operandushoz. Például egy összetett hozzárendelési kifejezés, mint a"

#. type: Source code
#: ../E/expr.txt:86
#, no-wrap
msgid "<code>lvalue += expression</code>"
msgstr "<code>lvalue += expression</code>"

#. type: Source code
#: ../E/expr.txt:88
#, no-wrap
msgid "<code>lvalue = lvalue + expression</code>"
msgstr "<code>lvalue = lvalue + expression</code>"

#. type: \b; header
#: ../E/expr.txt:97
#, no-wrap
msgid "String concatenation"
msgstr "Sztring összefűzés"

#. type: Plain text
#: ../E/expr.txt:98
#, no-wrap
msgid "If at least one of the values used with the <code>+</code> operator is a <a cbot|string>string</a>, then the operation of concatenation is performed. The result of the operator is then a string, which is created by joining end-to-end the string and the other value. If the other value is not a string, then it is converted to string beforehand."
msgstr "Ha a <code>+</code> operátorral használt értékek közül legalább az egyik <a cbot|string>sztring</a>, akkor összefűzés történik. Az operátor eredménye ekkor egy sztring, amely úgy jön létre, hogy a sztringet és a másik értéket összeillesztjük. Ha a másik érték nem sztring, akkor előtte sztringgé konvertálódik."

#. type: Source code
#: ../E/expr.txt:102
#, no-wrap
msgid ""
"\tstring s = \"a\" + \"bc\";  // returns \"abc\"\n"
"\tstring s = 1 + \"bc\";    // returns \"1bc\"\n"
"\tstring s = 2.5 + \"bc\";  // returns \"2.5bc\"\n"
"\tstring s = \"a\" + true;  // returns \"atrue\""
msgstr ""
"\tstring s = \"a\" + \"bc\";  // visszaadja \"abc\"\n"
"\tstring s = 1 + \"bc\";    // visszaadja \"1bc\"\n"
"\tstring s = 2.5 + \"bc\";  // visszaadja \"2.5bc\"\n"
"\tstring s = \"a\" + true;  // visszaadja \"atrue\""

#. type: Plain text
#: ../E/expr.txt:107
#, no-wrap
msgid "Tip: the properties of the concatenation <code>+</code> operator is useful with the <a cbot|message>message();</a> function, because it does not work with other types than string. An empty string can be used together with a value in order to create a string, which actually can be passed to the <a cbot|message>message();</a> function:"
msgstr "Tipp: az összefűzés <code>+</code> operátor tulajdonságai hasznosak a <a cbot|message>message();</a> függvénnyel, mivel az nem működik más típusokkal, mint a sztring. Egy üres sztringet használhatunk egy értékkel együtt, hogy sztringet hozzunk létre, amit ténylegesen át lehet adni a <a cbot|message>message();</a> függvénynek:"

#. type: \b; header
#: ../E/expr.txt:178
#, no-wrap
msgid "Prefix and postfix increment- and decrement operators"
msgstr "Előtagos és utótagos inkrementáló és dekrementáló operátorok"

#. type: Plain text
#: ../E/expr.txt:181
#, no-wrap
msgid "For example to increment the variable <code>a</code> you can write"
msgstr "Például az <code>a</code> változó inkrementálásához írhatod:"

#. type: Source code
#: ../E/expr.txt:182
#, no-wrap
msgid "<c/>a++;<n/>"
msgstr "<c/>a++;<n/>"

#. type: Plain text
#: ../E/expr.txt:183
#, no-wrap
msgid "instead of"
msgstr "ez helyett:"

#. type: Source code
#: ../E/expr.txt:184
#, no-wrap
msgid "<c/>a = a + 1;<n/>"
msgstr "<c/>a = a + 1;<n/>"

#. type: Plain text
#: ../E/expr.txt:186
#, no-wrap
msgid "The result of the operation <code>a++</code> is the value of the variable <code>a</code> *before* the increment. If you use the prefix operator <code>++a</code> the result of the operation is the value of the variable <code>a</code> *after* the increment. The same holds for the <code>--</code> decrement operator."
msgstr "Az <code>a++</code> művelet eredménye az <code>a</code> változó értéke *a növelés előtt*. Ha a prefix operátort, a <code>++a</code>-t használod, akkor a művelet eredménye az <code>a</code> változó értéke *a növelés után*. Ugyanez érvényes a <code>--</code> csökkentő operátorra is."

#. type: Plain text
#: ../E/expr.txt:4
#, no-wrap
msgid "Specifically speaking, an expression is an ordered series of operations which yield a result. Operations consist of operators, which are special <a cbot|function>functions</a> <code>T f(t1 x1, t2 x2, ..., tn xn)</code>, where <code>xi</code> is a value of type <code>ti</code>, and <code>T</code> is the result type. For example, <code>float +(float a, float b)</code> returns a sum of values <code>a</code> and <code>b</code>. Note: Operators are a part of the CBOT language and they cannot be defined in program. Also, the operators cannot be used as usual <a cbot|function>functions</a>, they need to be written using a special notation depending on the operator, for example <code>a+b</code>."
msgstr "Pontosan beszélve, egy kifejezés egy rendezett műveletsorozat, amely eredményt ad. A műveletek operátorokból állnak, amelyek speciális <a cbot|function>funkciók</a> <code>T f(t1 x1, t2 x2, ..., tn xn)</code>, ahol <code>xi</code> egy <code>ti</code> típusú érték, és <code>T</code> az eredménytípus. Például, a <code>float +(float a, float b)</code> a <code>a</code> és <code>b</code> értékek összegét adja vissza. Megjegyzés: Az operátorok a CBOT nyelv részei, és nem definiálhatók a programban. Az operátorok nem használhatók szokásos <a cbot|function>funkciók</a> módjára, hanem speciális jelöléssel kell őket megírni, az operátortól függően, például <code>a+b</code>."

#. type: Plain text
#: ../E/expr.txt:6
#, no-wrap
msgid "In nearly all operations, <a cbot>constants</a>, <a cbot|var>variables</a>, <a cbot|function>functions</a> returning non-<a cbot|void>void</a> type and also other operations can be used as values."
msgstr "Majdnem minden műveletben <a cbot>konstansok</a>, <a cbot|var>változók</a>, <a cbot|function>funkciók</a>, amelyek nem <a cbot|void>void</a> típusúak, valamint más műveletek is használhatók értékekként."

#. type: Plain text
#: ../E/expr.txt:40
#, no-wrap
msgid "Note: it may be not obvious at first, but notice that <code>=</code> is an *operator* not an instruction. This mean that it can be used in the middle of an other expression! The result of <code>=</code> is the value which was assigned to the l-value - the result of the expression on the right. Example:"
msgstr "Megjegyzés: kezdetben nem biztos, hogy nyilvánvaló, de vedd észre, hogy a <code>=</code> egy *operátor*, nem pedig egy utasítás. Ez azt jelenti, hogy más kifejezés közepén is használható! A <code>=</code> eredménye az érték, amelyet a bal oldali értékhez rendeltek - azaz a jobb oldali kifejezés eredménye. Példa:"

#. type: Source code
#: ../E/expr.txt:109
#, no-wrap
msgid ""
" float pi = 3.14;\n"
" // message(pi); // does not work\n"
" message(\"\"+pi);"
msgstr ""
" float pi = 3.14;\n"
" // message(pi); // nem működik\n"
" message(\"\"+pi);"

#. type: Source code
#: ../E/expr.txt:190
#, no-wrap
msgid ""
" a = 2;\n"
" b = a++;\n"
" // now b contains 2 and a contains 3"
msgstr ""
" a = 2;\n"
" b = a++;\n"
" // most b 2-t tartalmaz, és a 3-at"

#. type: Source code
#: ../E/expr.txt:194
#, no-wrap
msgid ""
" a = 2;\n"
" b = ++a;\n"
" // now b contains 3 and a contains 3"
msgstr ""
" a = 2;\n"
" b = ++a;\n"
" // most b 3-at tartalmaz, és a is 3-at"

#. type: \b; header
#: ../E/expr.txt:138
#, no-wrap
msgid "Logical operators"
msgstr "Logikai operátorok"

#. type: Plain text
#: ../E/expr.txt:139
#, no-wrap
msgid "Logical operators work with values of type <a cbot|bool>bool</a> and they always return a <a cbot|bool>bool</a>. They are mainly used in <a cbot|cond>conditions</a>."
msgstr "A logikai operátorok <a cbot|bool>bool</a> típusú értékekkel dolgoznak, és mindig <a cbot|bool>bool</a> értéket adnak vissza. Főleg <a cbot|cond>feltételekben</a> használják őket."

#. type: \b; header
#: ../E/expr.txt:151
#, no-wrap
msgid "Ternary operator"
msgstr "Hármas operátor"

#. type: Plain text
#: ../E/expr.txt:152
#, no-wrap
msgid ""
"The ternary operator is nothing more than a syntax sugar. It is also known as \"inline if\". It might be confusing at first, because its syntax is a little more complicated than other operators. It can be described as follows:\n"
"<code>(condition) ? (result when true) : (result when false)</code>\n"
"Brackets are not needed."
msgstr ""
"A hármas operátor nem más, mint egy szintaxis cukorka. Más néven \"inline if\"-nek is hívják. Kezdetben zavaró lehet, mert a szintaxisa egy kicsit bonyolultabb, mint más operátoroké. Így írható le:\n"
"<code>(feltétel) ? (eredmény igaz esetén) : (eredmény hamis esetén)</code>\n"
"Zárójelek nem szükségesek."

#. type: Plain text
#: ../E/expr.txt:156
#, no-wrap
msgid "Firstly, the condition is valued and then the first result is returned if the condition is true, otherwise the second result is returned."
msgstr "Először is, a feltétel értékelésre kerül, majd ha a feltétel igaz, az első eredmény kerül visszaadásra, ellenkező esetben a második eredmény."

#. type: \t; header
#: ../E/expr.txt:158 ../E/extends.txt:4 ../E/extends.txt:65 ../E/private.txt:4
#: ../E/protected.txt:4 ../E/super.txt:4
#, no-wrap
msgid "Example"
msgstr "Példa"

#. type: Source code
#: ../E/expr.txt:159
#, no-wrap
msgid "<c/>float c = ((3.0 > 2.0) ? 10.0 : -10.0); // c == 10.0<n/>"
msgstr "<c/>float c = ((3.0 > 2.0) ? 10.0 : -10.0); // c == 10.0<n/>"

#. type: Plain text
#: ../E/cond.txt:2
#, no-wrap
msgid "A condition is a special <a cbot|expr>expression</a> that returns a <a cbot|bool>boolean</a> value, that can only be either <code><a cbot|true>true</a></code> or <code><a cbot|false>false</a></code>. With a condition, you can choose f. ex. if the instructions in a <code><a cbot|while>while</a></code> loop must be repeated again, or if the instruction in a <code><a cbot|if>if</a></code> bloc must be executed."
msgstr "A feltétel egy speciális <a cbot|expr>kifejezés</a>, amely egy <a cbot|bool>logikai</a> értéket ad vissza, amely csak <code><a cbot|true>igaz</a></code> vagy <code><a cbot|false>hamis</a></code> lehet. Egy feltétellel eldöntheted például, hogy egy <code><a cbot|while>while</a></code> ciklus utasításait újra kell-e ismételni, vagy hogy egy <code><a cbot|if>if</a></code> blokk utasításait végre kell-e hajtani."

#. type: \b; header
#: ../E/expr.txt:113
#, no-wrap
msgid "Comparison operators"
msgstr "Összehasonlító operátorok"

#. type: Plain text
#: ../E/expr.txt:114
#, no-wrap
msgid "Comparison operators work with values of type <a cbot|bool>float</a> and they always return a <a cbot|bool>bool</a>. They are mainly used in <a cbot|cond>conditions</a>."
msgstr "Az összehasonlító operátorok <a cbot|bool>float</a> típusú értékekkel működnek, és mindig egy <a cbot|bool>logikai</a> értéket adnak vissza. Főleg <a cbot|cond>feltételek</a> esetén használatosak."

#. type: Plain text
#: ../E/expr.txt:142
#, no-wrap
msgid ""
"<code>!a      </code>not <code>a</code>\n"
"<code>a && b  </code><code>a</code> and <code>b</code>\n"
"<code>a || b  </code><code>a</code> or <code>b</code>"
msgstr ""
"<code>!a      </code>nem <code>a</code>\n"
"<code>a && b  </code><code>a</code> és <code>b</code>\n"
"<code>a || b  </code><code>a</code> vagy <code>b</code>"

#. type: Plain text
#: ../E/expr.txt:147
#, no-wrap
msgid ""
"<code>!false        </code>returns true\n"
"<code>true && false </code>returns false \n"
"<code>true || false </code>returns true"
msgstr ""
"<code>!false        </code>igazat ad vissza\n"
"<code>true && false </code>hamisat ad vissza\n"
"<code>true || false </code>igazat ad vissza"

#. type: \b; header
#: ../E/expr.txt:161
#, no-wrap
msgid "Bitwise operators"
msgstr "Bit-szintű operátorok"

#. type: Plain text
#: ../E/expr.txt:162
#, no-wrap
msgid "Bitwise operators are similar to the logical operator, because they are operating on bits (which can be only 0 or 1, conditions can have a value only of false or true). So in theory, they should be working with basically any type of variable, because each value in the computer must be stored as a sequence of bits."
msgstr "A bit-szintű operátorok hasonlóak a logikai operátorokhoz, mivel biteken dolgoznak (amelyek csak 0 vagy 1 lehetnek, a feltételek értéke pedig csak hamis vagy igaz lehet). Tehát elméletileg bármilyen típusú változóval működniük kellene, mivel minden értéket a számítógépben bitek sorozataként kell tárolni."

#. type: Plain text
#: ../E/expr.txt:165
#, no-wrap
msgid ""
"<code>a & b  </code><code>a</code> AND <code>b</code>\n"
"<code>a | b  </code><code>a</code> OR <code>b</code>\n"
"<code>a ^ b  </code><code>a</code> XOR <code>b</code>\n"
"<code>a >> b  </code>shift bits of <code>a</code> to the right <code>b</code> times\n"
"<code>a << b  </code>shift bits of <code>a</code> to the left <code>b</code> times"
msgstr ""
"<code>a & b  </code><code>a</code> ÉS <code>b</code>\n"
"<code>a | b  </code><code>a</code> VAGY <code>b</code>\n"
"<code>a ^ b  </code><code>a</code> XOR <code>b</code>\n"
"<code>a >> b  </code>bitek eltolása <code>a</code> jobbra <code>b</code> alkalommal\n"
"<code>a << b  </code>bitek eltolása <code>a</code> balra <code>b</code> alkalommal"

#. type: Plain text
#: ../E/expr.txt:172
#, no-wrap
msgid ""
"<code>2 & 1         </code>returns 0\n"
"<code>2 | 1         </code>returns 3\n"
"<code>2 ^ 2         </code>returns 0\n"
"<code>2 >> 1        </code>returns 1\n"
"<code>2 << 1        </code>returns 4"
msgstr ""
"<code>2 & 1         </code>0-t ad vissza\n"
"<code>2 | 1         </code>3-at ad vissza\n"
"<code>2 ^ 2         </code>0-t ad vissza\n"
"<code>2 >> 1        </code>1-et ad vissza\n"
"<code>2 << 1        </code>4-et ad vissza"

#. type: Source code
#: ../E/array.txt:4
#, no-wrap
msgid ""
"int    [ ] a;   // an array of int\n"
"int    a [12];  // an array of int limited to 12 elements\n"
"string s[3];    // an array of 3 strings\n"
"float  xy[][];  // a 2 dimensionnal array of floats"
msgstr ""
"int    [ ] a;   // an array of int\n"
"int    a [12];  // an array of int limited to 12 elements\n"
"string s[3];    // an array of 3 strings\n"
"float  xy[][];  // a 2 dimensionnal array of floats"

#. type: \b; header
#: ../E/array.txt:30
#, no-wrap
msgid "Initialization syntax"
msgstr "Inicializálási szintaxis"

#. type: Plain text
#: ../E/array.txt:31
#, no-wrap
msgid "You can initialize a new array using the following syntax:"
msgstr "Új tömböt a következő szintaxissal inicializálhatod:"

#. type: Source code
#: ../E/array.txt:33
#, no-wrap
msgid "type arrayName[] = { value0, value1, value2, ..., valueN };"
msgstr "típus tömbNév[] = { érték0, érték1, érték2, ..., értékN };"

#. type: Source code
#: ../E/array.txt:37
#, no-wrap
msgid ""
"int numbers[] = { 10, 20, 30 };\n"
"MyClass objects[] = { new MyClass(1), new MyClass(2) };"
msgstr ""
"int számok[] = { 10, 20, 30 };\n"
"MyClass objektumok[] = { új MyClass(1), új MyClass(2) };"

#. type: Plain text
#: ../E/radar.txt:2
#, no-wrap
msgid "With the instruction <c/>radar();<n/>, you can look for objects like <a object|mother>enemies</a>, bots, buildings or raw materials."
msgstr "A <c/>radar();<n/> utasítással olyan objektumokat kereshetsz, mint <a object|mother>ellenségek</a>, botok, épületek vagy nyersanyagok."

#. type: Plain text
#: ../E/radar.txt:81
#, no-wrap
msgid "<c/><a cbot|radarall>radarall</a>();<n/>, <a cbot>programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<c/><a cbot|radarall>radarall</a>();<n/>, <a cbot>programozás</a>, <a cbot|type>típusok</a> és <a cbot|category>kategóriák</a>."

#. type: \b; header
#: ../E/radarall.txt:1
#, no-wrap
msgid "Instruction <code>radarall</code>"
msgstr "<code>radarall</code> utasítás"

#. type: Plain text
#: ../E/radarall.txt:2
#, no-wrap
msgid "<c/>radarall();<n/> is an enhancement of the <c/><a cbot|radar>radar</a>();<n/> function -- it detects all objects matching the given criteria."
msgstr "<c/>radarall();<n/> a <c/><a cbot|radar>radar</a>();<n/> függvény továbbfejlesztése -- minden olyan objektumot felismer, amely megfelel a megadott kritériumoknak."

#. type: \b; header
#: ../E/radarall.txt:4
#, no-wrap
msgid "Example<c/>"
msgstr "Példa<c/>"

#. type: Source code
#: ../E/radarall.txt:13
#, no-wrap
msgid "<c/>radarall ( cat, angle, focus, min, max, sens, filter );<n/>"
msgstr "<c/>radarall ( cat, szög, fókusz, min, max, érzékenység, szűrő );<n/>"

#. type: Plain text
#: ../E/radarall.txt:15
#, no-wrap
msgid "The function works generally the same as the <c/><a cbot|radar>radar</a>();<n/> function with the only difference being that it returns an <a cbot|array>array</a> of <a cbot|object>objects</a> instead of one object. If no object is found, <code><a cbot|null>null</a></code> is returned."
msgstr "A függvény általában ugyanúgy működik, mint a <c/><a cbot|radar>radar</a>();<n/> függvény, azzal a különbséggel, hogy egy objektum helyett egy <a cbot|array>tömböt</a> ad vissza <a cbot|object>objektumokkal</a>. Ha nem található objektum, <code><a cbot|null>null</a></code> kerül visszaadásra."

#. type: Plain text
#: ../E/radarall.txt:17
#, no-wrap
msgid "The order of objects in the returned array is sorted by distance and depends on the <code>sens</code> parameter. The first object in the array is the object which would be returned by the <c/>radar();<n/> function called with the exactly same parameters."
msgstr "Az objektumok sorrendje a visszaadott tömbben távolság szerint van rendezve, és a <code>sens</code> paramétertől függ. Az első objektum a tömbben az a objektum, amelyet ugyanazon paraméterekkel meghívott <c/>radar();<n/> függvény adna vissza."

#. type: Plain text
#: ../E/radarall.txt:20
#, no-wrap
msgid "<c/><a cbot|radar>radar</a>();<n/>, <a cbot>programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<c/><a cbot|radar>radar</a>();<n/>, <a cbot>programozás</a>, <a cbot|type>típusok</a> és <a cbot|category>kategóriák</a>."

#. type: Plain text
#: ../E/for.txt:11
#, no-wrap
msgid "This set of instructions is executed before the first loop instance."
msgstr "Ez a sorozat utasítások a ciklus első példánya előtt kerül végrehajtásra."

#. type: Plain text
#: ../E/for.txt:17
#, no-wrap
msgid "This set of instructions is executed at the end of every instance of the loop. "
msgstr "Ez a sorozat utasítások minden cikluspéldány végén kerül végrehajtásra."

#. type: \t; header
#: ../E/for.txt:38
#, no-wrap
msgid "Executing more instructions"
msgstr "További utasítások végrehajtása"

#. type: Plain text
#: ../E/for.txt:39
#, no-wrap
msgid "In the <code>before</code> and <code>end</code> part of a <code>for</code> loop you can specify more than one instruction by using comma. Example:"
msgstr "A <code>for</code> ciklus <code>before</code> és <code>end</code> részeiben több utasítást is megadhatsz vesszővel elválasztva. Példa:"

#. type: Source code
#: ../E/for.txt:41
#, no-wrap
msgid ""
"int i = 0;\n"
"int j;\n"
"for (i++, j = 2; i < 3 && j > 0; i++, j--)\n"
"{\n"
"    message(i);\n"
"    message(j);\n"
"}"
msgstr ""
"int i = 0;\n"
"int j;\n"
"for (i++, j = 2; i < 3 && j > 0; i++, j--)\n"
"{\n"
"    message(i);\n"
"    message(j);\n"
"}"

#. type: Plain text
#: ../E/for.txt:49
#, no-wrap
msgid "The output of the above code is <code>1 2 2 1</code>."
msgstr "A fenti kód kimenete: <code>1 2 2 1</code>."

#. type: Source code
#: ../E/radarall.txt:5
#, no-wrap
msgid ""
"object[] items = radarall(PowerCell);\n"
"for (int i = 0; i < sizeof(items); ++i)\n"
"{\n"
"    message(items[i].id);\n"
"}"
msgstr ""
"object[] items = radarall(PowerCell);\n"
"for (int i = 0; i < sizeof(items); ++i)\n"
"{\n"
"    message(items[i].id);\n"
"}"

