#. type: Source code
#: ../E/ceil.txt:3
#, no-wrap
msgid "<c/>ceil ( value );<n/>"
msgstr "<c/>ceil ( érték );<n/>"

#. type: Plain text
#: ../E/ceil.txt:4
#, no-wrap
msgid "Rounds up a number."
msgstr "Felfelé kerekít egy számot."

#. type: Plain text
#: ../E/ceil.txt:10
#, no-wrap
msgid "Ceiling of the value, i.e. the smallest integer not less than <code>value</code>. For example, <code>ceil(2.1)</code> is <code>3.0</code>."
msgstr "Az érték felső egész része, vagyis a legkisebb olyan egész szám, ami nem kisebb, mint a <code>value</code>. Például: <code>ceil(2.1)</code> eredménye <code>3.0</code>."

#. type: Plain text
#: ../E/ceil.txt:13 ../E/floor.txt:13 ../E/trunc.txt:13
#, no-wrap
msgid "<a cbot|round>round</a>, <a cbot>programming</a>, <a cbot|type>types</a> and <a cbot|expr>expressions</a>."
msgstr "<a cbot|round>kerekítés</a>, <a cbot>programozás</a>, <a cbot|type>típusok</a> és <a cbot|expr>kifejezések</a>."

#. type: \b; header
#: ../E/colors.txt:1
#, no-wrap
msgid "Value <code>Colors</code>"
msgstr "Érték <code>Colors</code>"

#. type: Plain text
#: ../E/colors.txt:2
#, no-wrap
msgid "Color names are used to define a specific color to use. They can be passed to functions like <a cbot|pendown>pendown</a> or <a cbot|pencolor>pencolor</a>."
msgstr "A színneveket egy adott szín meghatározására használjuk. Átadhatók olyan függvényeknek, mint a <a cbot|pendown>pendown</a> vagy a <a cbot|pencolor>pencolor</a>."

#. type: Plain text
#: ../E/colors.txt:4
#, no-wrap
msgid "In a program, colors are always displayed on a <format const>red background</format>. If a color isn't highlighted in red, it is misspelled. Caps and lower cases should be kept as is."
msgstr "A programban a színek mindig <format const>piros háttéren</format> jelennek meg. Ha egy szín nincs pirossal kiemelve, akkor hibásan van leírva. A kis- és nagybetűket meg kell tartani."

#. type: Plain text
#: ../E/colors.txt:6
#, no-wrap
msgid "Below are the different colors available:"
msgstr "Az alábbiakban láthatók az elérhető színek:"

#. type: Plain text
