#. type: Plain text
#: ../E/strlower.txt:2
#, no-wrap
msgid "Convert all characters in a string to lowercase."
msgstr "Minden karaktert kisbetűsre alakít a <a cbot|string>string</a> esetén."

#. type: Source code
#: ../E/strlower.txt:5
#, no-wrap
msgid "<c/>strlower ( string );<n/>"
msgstr "<c/>strlower ( string );<n/>"

#. type: Source code
#: ../E/strlower.txt:8
