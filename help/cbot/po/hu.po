#. type: \b; header
#: ../E/close.txt:1
#, no-wrap
msgid "Instruction <code>close</code>"
msgstr "Parancs <code>close</code>"

#. type: Plain text
#: ../E/close.txt:2
#, no-wrap
msgid "Close a file opened previously with <code><a cbot|open>open</a></code>. This is a method of the <code><a cbot|file>file</a></code> class; therefore you cannot write  <code>close()</code> but only <code>handle.close()</code>:"
msgstr "Zárja be azt a fájlt, amelyet korábban a <code><a cbot|open>open</a></code> parancs segítségével nyitott meg. Ez a <code><a cbot|file>file</a></code> osztály metódusa, ezért nem írhatja, hogy <code>close()</code>, hanem csak <code>handle.close()</code>-t:"

#. type: Source code
#: ../E/close.txt:4
#, no-wrap
msgid "\thandle.close();"
msgstr "\thandle.close();"

#. type: Plain text
#: ../E/close.txt:7
#, no-wrap
msgid ""
"<code><a cbot|file>file</a></code>, <code><a cbot|open>open</a></code>, <code><a cbot|readln>readln</a></code>, <code><a cbot|writeln>writeln</a></code> and <code><a cbot|eof>eof</a></code>.\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<code><a cbot|file>fájl</a></code>, <code><a cbot|open>open</a></code>, <code><a cbot|readln>readln</a></code>, <code><a cbot|writeln>writeln</a></code> és <code><a cbot|eof>eof</a></code>.\n"
"<a cbot>Programozás</a>, <a cbot|type>típusok</a> és <a cbot|category>kategóriák</a>."

#. type: \b; header
#: ../E/cond.txt:1
#, no-wrap
msgid "Conditions"
msgstr "Feltételek"

#. type: Plain text
#: ../E/expr.txt:117
#, no-wrap
msgid ""
"<code>a == b  </code><code>a</code> equals <code>b</code>\n"
"<code>a != b  </code><code>a</code> is different from <code>b</code>\n"
"<code>a <  b  </code><code>a</code> smaller than <code>b</code>\n"
"<code>a <= b  </code><code>a</code> smaller than or equal to <code>b</code>\n"
"<code>a >  b  </code><code>a</code> greater than <code>b</code>\n"
"<code>a >= b  </code><code>a</code> greater than or equal to <code>b</code>"
msgstr ""
"<code>a == b  </code><code>a</code> egyenlő <code>b</code>-vel\n"
"<code>a != b  </code><code>a</code> nem egyenlő <code>b</code>-val\n"
"<code>a <  b  </code><code>a</code> kisebb, mint <code>b</code>\n"
"<code>a <= b  </code><code>a</code> kisebb vagy egyenlő, mint <code>b</code>\n"
"<code>a >  b  </code><code>a</code> nagyobb, mint <code>b</code>\n"
"<code>a >= b  </code><code>a</code> nagyobb vagy egyenlő, mint <code>b</code>"

#. type: Plain text
#: ../E/expr.txt:125
#, no-wrap
msgid ""
"<code>12 == 12  </code>returns true\n"
"<code>45 != 47  </code>returns true \n"
"<code>99 == 98  </code>returns false\n"
"<code>12 <  -1  </code>returns false\n"
"<code>12 >= 10  </code>returns true \n"
"<code>12 >= 12  </code>returns true "
msgstr ""
"<code>12 == 12  </code>igazat ad\n"
"<code>45 != 47  </code>igazat ad \n"
"<code>99 == 98  </code>hamisat ad\n"
"<code>12 <  -1  </code>hamisat ad\n"
"<code>12 >= 10  </code>igazat ad\n"
"<code>12 >= 12  </code>igazat ad "

#. type: Plain text
#: ../E/expr.txt:133
#, no-wrap
msgid "Be careful not to confuse the equality comparison <code>==</code> with the assignment of a <a cbot|var>variable</a> <code>=</code>."
msgstr "Vigyázz, ne keverd össze az egyenlőség-összehasonlítást <code>==</code> a <a cbot|var>változó</a> értékadásával <code>=</code>."

#. type: Plain text
#: ../E/expr.txt:135
#, no-wrap
msgid ""
"<code>a == b</code> is an expression that compares <code>a</code> with <code>b</code>.\n"
"<code>a = b</code> is an expression that copies the value of <code>b</code> into <code>a</code>."
msgstr ""
"<code>a == b</code> egy kifejezés, amely összehasonlítja <code>a</code>-t <code>b</code>-vel.\n"
"<code>a = b</code> egy kifejezés, amely <code>b</code> értékét átmásolja <code>a</code>-ba."

#. type: \b; header
#: ../E/continue.txt:1
#, no-wrap
msgid "Instruction <code>continue</code>"
msgstr "A <code>continue</code> utasítás"

#. type: Source code
#: ../E/continue.txt:3
#, no-wrap
msgid ""
"<c/>while ( condition )\n"
"{\n"
"\tcontinue;\n"
"}"
msgstr ""
"<c/>while ( bedingung )\n"
"{\n"
"\t...\n"
"\tcontinue;\n"
"\t...\n"
"}"

#. type: Plain text
#: ../E/continue.txt:8
#, no-wrap
msgid "With this instruction, you can jump over the rest of instructions in the <code><a cbot|bloc>bloc</a></code> of a <code><a cbot|while>while</a></code> or <code><a cbot|for>for</a></code> loop: The execution will resume at the beginning of the bloc, the next time the loop is repeated."
msgstr "Ezzel az utasítással átugorhatod a <code><a cbot|while>while</a></code> vagy <code><a cbot|for>for</a></code> ciklus <code><a cbot|bloc>blokkjának</a></code> többi utasítását: a végrehajtás a blokk elejétől folytatódik, amikor a ciklus újra lefut."

#. type: Source code
#: ../E/continue.txt:11
#, no-wrap
msgid ""
"<c/>int i = 0;\n"
"while ( i < 5 )\n"
"{\n"
"\ti = i+1;\n"
"\tif ( i == 3 )\n"
"\t{\n"
"\t\tcontinue;\n"
"\t}\n"
"\t<n/>Instructions ...<c/>\n"
"}"
msgstr ""
"<c/>int i = 0;\n"
"while ( i < 5 )\n"
"{\n"
"\ti = i+1;\n"
"\tif ( i == 3 )\n"
"\t{\n"
"\t\tcontinue;\n"
"\t}\n"
"\t<n/>Utasítások ...<c/>\n"
"}"

#. type: Plain text
#: ../E/continue.txt:22
#, no-wrap
msgid "The instructions will only be executed for the values of <code>i</code> 1, 2, 4 and 5."
msgstr "Az utasítások csak a <code>i</code> 1, 2, 4 és 5 értékeinél hajtódnak végre."

#. type: \b; header
#: ../E/deletef.txt:1
#, no-wrap
msgid "Instruction <code>deletefile</code>"
msgstr "Utasítás <code>deletefile</code>"

#. type: Plain text
#: ../E/deletef.txt:2
#, no-wrap
msgid "The deletefile instruction deletes an existing file in the files/ folder. "
msgstr "A deletefile utasítás töröl egy meglévő fájlt a files/ mappából."

#. type: Plain text
#: ../E/deletef.txt:4
#, no-wrap
msgid "Files can only be deleted in the files/ folder which is located in the folder inside Colobot save directory. You cannot not delete files that are located elsewhere than in the files/ folder."
msgstr "Csak a Colobot mentési könyvtárán belüli files/ mappában lévő fájlokat lehet törölni. Más helyen lévő fájlokat nem lehet ezzel az utasítással törölni."

#. type: Source code
#: ../E/deletef.txt:7
#, no-wrap
msgid "<c/>deletefile ( filename );<n/>"
msgstr "<c/>deletefile ( filename );<n/>"

#. type: \b; header
#: ../E/delinfo.txt:1
#, no-wrap
msgid "Instruction <code>deleteinfo</code>"
msgstr "Utasítás <code>deleteinfo</code>"

#. type: Source code
#: ../E/delinfo.txt:3
#, no-wrap
msgid "<c/>deleteinfo ( name, power );<n/>"
msgstr "<c/>deleteinfo ( name, power );<n/>"

#. type: Plain text
#: ../E/delinfo.txt:5
#, no-wrap
msgid "Delete an existing information in the closest <a object|exchange>information exchange post</a>."
msgstr "Töröl egy meglévő információt a legközelebbi <a object|exchange>információs állomásról</a>."

#. type: \t; header
#: ../E/delinfo.txt:7 ../E/receive.txt:7 ../E/send.txt:7 ../E/testinfo.txt:7
#, no-wrap
msgid "name: <code>string</code>"
msgstr "name: <code>string</code>"

#. type: Plain text
#: ../E/delinfo.txt:8
#, no-wrap
msgid "Name of the information to be deleted. This name is a string: it must be written in quotation marks \"\"."
msgstr "A törlendő információ neve. Ez egy szöveg (string), idézőjelek („”) között kell megadni."

#. type: \t; header
#: ../E/delinfo.txt:10 ../E/receive.txt:10 ../E/send.txt:14
#: ../E/testinfo.txt:10
#, no-wrap
msgid "power: <code>float</code>"
msgstr "power: <code>float</code>"

#. type: Plain text
#: ../E/delinfo.txt:11
#, no-wrap
msgid "Power of the transmitter, which corresponds to the maximal distance between the sender and the exchange post. If the distance is longer, the information won't be deleted. Default value is 10 metres."
msgstr "A jeladó hatótávolsága, ami a robot és az információs állomás közötti maximális távolságnak felel meg. Ha a távolság nagyobb, az információ nem lesz törölve. Alapértelmezett érték: 10 méter."

#. type: Plain text
#: ../E/delinfo.txt:14
#, no-wrap
msgid ""
"<code><a cbot|receive>receive</a></code>, <code><a cbot|send>send</a></code> and <code><a cbot|testinfo>testinfo</a></code>.\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<code><a cbot|receive>receive</a></code>, <code><a cbot|send>send</a></code> és <code><a cbot|testinfo>testinfo</a></code>.\n"
"<a cbot>Programozás</a>, <a cbot|type>típusok</a> és <a cbot|category>kategóriák</a>."

#. type: \b; header
