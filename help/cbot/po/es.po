#. type: Plain text
#: ../E/category.txt:120
#, no-wrap
msgid "<a cbot>CBOT Language</a> and <a cbot|type>Variables</a>."
msgstr "<a cbot>Lenguaje CBOT</a> y <a cbot|type>Variables</a>."

#. type: \b; header
#: ../E/ceil.txt:1
#, no-wrap
msgid "Instruction <code>ceil</code>"
msgstr "Instrucción <code>ceil</code>"

#. type: Source code
#: ../E/ceil.txt:3
#, no-wrap
msgid "<c/>ceil ( value );<n/>"
msgstr ""

#. type: Plain text
#: ../E/ceil.txt:4
#, no-wrap
msgid "Rounds up a number."
msgstr "Redondea un número hacia arriba."

#. type: Plain text
#: ../E/ceil.txt:10
#, no-wrap
msgid "Ceiling of the value, i.e. the smallest integer not less than <code>value</code>. For example, <code>ceil(2.1)</code> is <code>3.0</code>."
msgstr "Techo del valor, es decir, el entero más pequeño que no es menor que <code>value</code>. Por ejemplo, <code>ceil(2.1)</code> es <code>3.0</code>."

#. type: Plain text
#: ../E/ceil.txt:13 ../E/floor.txt:13 ../E/trunc.txt:13
#, no-wrap
msgid "<a cbot|round>round</a>, <a cbot>programming</a>, <a cbot|type>types</a> and <a cbot|expr>expressions</a>."
msgstr "<a cbot|round>round</a>, <a cbot>programación</a>, <a cbot|type>tipos</a> y <a cbot|expr>expresiones</a>."

#. type: \b; header
#: ../E/class.txt:1
#, no-wrap
msgid "Instruction <code>class</code>"
msgstr "Instrucción <code>class</code>"

#. type: \b; header
#: ../E/close.txt:1
#, no-wrap
msgid "Instruction <code>close</code>"
msgstr "Instrucción <code>close</code>"

#. type: Plain text
#: ../E/close.txt:2
#, no-wrap
msgid "Close a file opened previously with <code><a cbot|open>open</a></code>. This is a method of the <code><a cbot|file>file</a></code> class; therefore you cannot write  <code>close()</code> but only <code>handle.close()</code>:"
msgstr "Cierra un archivo abierto anteriormente con <code><a cbot|open>open</a></code>. Este es un método de la clase <code><a cbot|file>file</a></code>; por lo tanto, no puedes escribir <code>close()</code> sino solo <code>handle.close()</code>:"

#. type: Source code
#: ../E/class.txt:4
#, no-wrap
msgid ""
"public class ClassName\n"
"{\n"
"\tdeclarations;\n"
"}"
msgstr ""

#. type: \t; header
#: ../E/class.txt:9
#, no-wrap
msgid "All Classes Are Public"
msgstr "Todas las clases son públicas"

#. type: Plain text
#: ../E/class.txt:10
#, no-wrap
msgid "Classes can be only <a cbot|public>public</a>. This means that they can be used by all bots in a mission."
msgstr "Las clases solo pueden ser <a cbot|public>públicas</a>. Esto significa que pueden ser utilizadas por todos los bots en una misión."

#. type: \b; header
#: ../E/class.txt:12
#, no-wrap
msgid "Class Members"
msgstr "Miembros de clase"

#. type: Plain text
#: ../E/class.txt:13
#, no-wrap
msgid "Class members are fields (<a cbot|var>variables</a>) and methods (<a cbot|function>functions</a>)."
msgstr "Los miembros de clase son campos (<a cbot|var>variables</a>) y métodos (<a cbot|function>funciones</a>)."

#. type: Plain text
#: ../E/class.txt:15
#, no-wrap
msgid "For example, the following class dubbed <code>MyClass</code> contains 4 fields (<code>a</code>, <code>b</code>, <code>x</code> and <code>s</code>) and one method (<code>MyFunction</code>)."
msgstr "Por ejemplo, la siguiente clase llamada <code>MyClass</code> contiene 4 campos (<code>a</code>, <code>b</code>, <code>x</code> y <code>s</code>) y un método (<code>MyFunction</code>)."

#. type: Source code
#: ../E/class.txt:17
#, no-wrap
msgid ""
"public class MyClass\n"
"{\n"
"\tint     a, b;\n"
"\tfloat   x = 3.33;\n"
"\tstring  s = \"hello\";\n"
"\tfloat   MyFunction(float value)\n"
"\t{\n"
"\t\treturn (value * x) - 1;\n"
"\t}\n"
"}"
msgstr ""

#. type: \b; header
#: ../E/class.txt:28
#, no-wrap
msgid "Accessing Class Members"
msgstr "Accediendo a los miembros de clase"

#. type: Plain text
#: ../E/class.txt:29
#, no-wrap
msgid "Class members can be accessed outside of the class definition by using the <code>.</code> operator. Example:"
msgstr "Los miembros de clase se pueden acceder fuera de la definición de la clase utilizando el operador <code>.</code>. Ejemplo:"

#. type: Source code
#: ../E/class.txt:31
#, no-wrap
msgid ""
"public class MyClass\n"
"{\n"
"\tint myField = 0;\n"
"\tint MyFunction()\n"
"\t{\n"
"\t\treturn myField * 2;\n"
"\t}\n"
"}\n"
"\n"
"extern void object::Test()\n"
"{\n"
"\tMyClass myObject();\n"
"\tmyObject.myField = 10;\n"
"\tmessage(myObject.MyFunction()); // 20\n"
"\tMyClass mySecondObject();\n"
"\tmySecondObject.myField = myObject.myField - 2;\n"
"\tmessage(mySecondObject.MyFunction()); // 16\n"
"}"
msgstr ""

#. type: Plain text
#: ../E/class.txt:50
#, no-wrap
msgid "Class members are <a cbot|public>public</a> by default, which means that they are accessible outside of the class definition. They can also be declared as <code><a cbot|private>private</a></code> or <code><a cbot|protected>protected</a></code>. Such members can only be accessed inside of the class definition."
msgstr "Los miembros de clase son <a cbot|public>públicos</a> por defecto, lo que significa que son accesibles fuera de la definición de la clase. También se pueden declarar como <code><a cbot|private>privados</a></code> o <code><a cbot|protected>protegidos</a></code>. Dichos miembros solo se pueden acceder dentro de la definición de la clase."

#. type: \t; header
#: ../E/class.txt:52
#, no-wrap
msgid "Class Members Modifiers"
msgstr "Modificadores de miembros de clase"

#. type: Plain text
#: ../E/class.txt:53
#, no-wrap
msgid "Fields and methods can also be declared as <code><a cbot|static>static</a></code>. Methods can be additionaly declared as <code><a cbot|synchro>synchronized</a></code>."
msgstr "Los campos y métodos también pueden declararse como <code><a cbot|static>estáticos</a></code>. Los métodos additionally pueden declararse como <code><a cbot|synchro>sincronizados</a></code>."

#. type: \t; header
#: ../E/class.txt:55
#, no-wrap
msgid "Member Initialization"
msgstr "Inicialización de miembros"

#. type: Plain text
#: ../E/class.txt:56
#, no-wrap
msgid "As shown in the previous example, the class members can be initialized in the class definition (<c/>int x = 3.33;<n/>)."
msgstr "Como se muestra en el ejemplo anterior, los miembros de clase se pueden inicializar en la definición de la clase (<c/>int x = 3.33;<n/>)."

#. type: Plain text
#: ../E/class.txt:58
#, no-wrap
msgid "Another way of initiliazing fields is by defining a constructor which is a special method having the same name as the class. This method will be called automatically at <a cbot|new>creation</a> time of a class instance. Constructors can be <a cbot|function>overloaded</a>."
msgstr "Otra forma de inicializar campos es definiendo un constructor, que es un método especial con el mismo nombre que la clase. Este método se llamará automáticamente en el momento de <a cbot|new>creación</a> de una instancia de clase. Los constructores pueden ser <a cbot|function>sobrecargados</a>."

#. type: Plain text
#: ../E/class.txt:60
#, no-wrap
msgid "Example:<c/>"
msgstr "Ejemplo:<c/>"

#. type: Source code
#: ../E/class.txt:61
#, no-wrap
msgid ""
"public class MyClass\n"
"{\n"
"\tint  a, b;\n"
"\tvoid MyClass()\n"
"\t{\n"
"\t\ta = 2;  b = 3;\n"
"\t}\n"
"\tvoid MyClass(int a, int b)\n"
"\t{\n"
"\t\tthis.a = a;  this.b = b;\n"
"\t}\n"
"}"
msgstr ""

#. type: \t; header
#: ../E/class.txt:75
#, no-wrap
msgid "Using <code><a cbot|this>this</a></code>"
msgstr "Uso de <code><a cbot|this>this</a></code>"

#. type: Plain text
#: ../E/class.txt:76
#, no-wrap
msgid "As the names of the parameters of the second constructor are the same as the names of the two members <code>a</code> and <code>b</code>, we must use the <code><a cbot|this>this</a></code> <a cbot|pointer>reference</a> to avoid confusion with the parameters' names."
msgstr "Como los nombres de los parámetros del segundo constructor son los mismos que los nombres de los dos miembros <code>a</code> y <code>b</code>, debemos usar la <a cbot|pointer>referencia</a> <code><a cbot|this>this</a></code> para evitar confusiones con los nombres de los parámetros."

#. type: \b; header
#: ../E/class.txt:78
#, no-wrap
msgid "Object Creation"
msgstr "Creación de objetos"

#. type: Plain text
#: ../E/class.txt:79
#, no-wrap
msgid "You can create objects of type <code>YourClass</code> using the <code><a cbot|new>new</a></code> keyword. Example:"
msgstr "Puedes crear objetos de tipo <code>YourClass</code> usando la palabra clave <code><a cbot|new>new</a></code>. Ejemplo:"

#. type: Source code
#: ../E/class.txt:81
#, no-wrap
msgid ""
"extern void object::Test()\n"
"{\n"
"\tMyClass object1();       // Call default constructor (without parameters)\n"
"\tMyClass object2(4, 5);   // Call constructor with two int parameters\n"
"\tMyClass object3;         // No constructor called, object3 == null\n"
"\tobject3 = new MyClass(); // We call constructor now, object3 != null\n"
"}"
msgstr ""

#. type: \b; header
#: ../E/class.txt:90
#, no-wrap
msgid "Object Destruction"
msgstr "Destrucción de objetos"

#. type: Plain text
#: ../E/class.txt:91
#, no-wrap
msgid "You can also define a destructor. This must be a <code><a cbot|void>void</a></code> fonction without parameters, which has the same name as the class but prefixed with the <code>~</code> character. The destructor is called automatically as soon as the class instance is no more referenced by anyone. Example:"
msgstr "También puedes definir un destructor. Este debe ser una función <code><a cbot|void>void</a></code> sin parámetros, que tiene el mismo nombre que la clase pero prefijado con el carácter <code>~</code>. El destructor se llama automáticamente tan pronto como la instancia de la clase ya no sea referenciada por nadie. Ejemplo:"

#. type: Source code
#: ../E/class.txt:93
#, no-wrap
msgid ""
"public class MyClass\n"
"{\n"
"\tstatic private int counter = 0; // instance counter\n"
"\tvoid  MyClass( )\n"
"\t{\n"
"\t\tcounter++;  // one instance more\n"
"\t}\n"
"\tvoid ~MyClass( )\n"
"\t{\n"
"\t\tcounter--;  // one instance less\n"
"\t}\n"
"}\n"
"extern void object::Test()\n"
"{\n"
"\t                   // counter == 0\n"
"\tMyClass item1( );  // counter == 1\n"
"\tMyClass item2( );  // counter == 2\n"
"\titem1 = null;      // counter == 1\n"
"}\n"
"// counter == 0"
msgstr ""

#. type: \b; header
#: ../E/class.txt:114
#, no-wrap
msgid "Passing Objects to Functions"
msgstr "Pasar objetos a funciones"

#. type: Plain text
#: ../E/class.txt:115
#, no-wrap
msgid "Objects in CBOT are passed by <a cbot|pointer>reference</a>. This means that when an object is passed to a <a cbot|function>function</a>, the function receives a copy of a pointer to the instance, not a copy of the object, so any modifications on the object will be visible outside of the function."
msgstr "Los objetos en CBOT se pasan por <a cbot|pointer>referencia</a>. Esto significa que cuando se pasa un objeto a una <a cbot|function>función</a>, la función recibe una copia de un puntero a la instancia, no una copia del objeto, por lo que cualquier modificación en el objeto será visible fuera de la función."

#. type: \b; header
#: ../E/class.txt:117
#, no-wrap
msgid "Inheritance"
msgstr "Herencia"

#. type: Plain text
#: ../E/class.txt:118
#, no-wrap
msgid "A class can inherit public and protected members of another class by using the <code><a cbot|extends>extends</a></code> keyword."
msgstr "Una clase puede heredar miembros públicos y protegidos de otra clase usando la palabra clave <code><a cbot|extends>extends</a></code>."

#. type: Plain text
#: ../E/class.txt:121
#, no-wrap
msgid ""
"<code><a cbot|public>public</a></code>, <code><a cbot|private>private</a></code>, <code><a cbot|protected>protected</a></code>, <code><a cbot|static>static</a></code>, <code><a cbot|synchro>synchronized</a></code>, <code><a cbot|new>new</a></code>, <code><a cbot|pointer>reference</a></code>, <code><a cbot|this>this</a></code>, <code><a cbot|super>super</a></code>, <code><a cbot|extends>extends</a></code>\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<code><a cbot|public>public</a></code>, <code><a cbot|private>private</a></code>, <code><a cbot|protected>protected</a></code>, <code><a cbot|static>static</a></code>, <code><a cbot|synchro>synchronized</a></code>, <code><a cbot|new>new</a></code>, <code><a cbot|pointer>reference</a></code>, <code><a cbot|this>this</a></code>, <code><a cbot|super>super</a></code>, <code><a cbot|extends>extends</a></code>\n"
"<a cbot>Programación</a>, <a cbot|type>tipos</a> y <a cbot|category>categorías</a>."

#. type: Source code
#: ../E/close.txt:4
#, no-wrap
msgid "\thandle.close();"
msgstr ""

#. type: Plain text
#: ../E/close.txt:7
#, no-wrap
msgid ""
"<code><a cbot|file>file</a></code>, <code><a cbot|open>open</a></code>, <code><a cbot|readln>readln</a></code>, <code><a cbot|writeln>writeln</a></code> and <code><a cbot|eof>eof</a></code>.\n"
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr ""
"<code><a cbot|file>file</a></code>, <code><a cbot|open>open</a></code>, <code><a cbot|readln>readln</a></code>, <code><a cbot|writeln>writeln</a></code> y <code><a cbot|eof>eof</a></code>.\n"
"<a cbot>Programación</a>, <a cbot|type>tipos</a> y <a cbot|category>categorías</a>."

#. type: \b; header
#: ../E/colors.txt:1
#, no-wrap
msgid "Value <code>Colors</code>"
msgstr "Valor <code>Colores</code>"

#. type: Plain text
#: ../E/colors.txt:2
#, no-wrap
msgid "Color names are used to define a specific color to use. They can be passed to functions like <a cbot|pendown>pendown</a> or <a cbot|pencolor>pencolor</a>."
msgstr "Los nombres de colores se usan para definir un color específico. Se pueden pasar a funciones como <a cbot|pendown>pendown</a> or <a cbot|pencolor>pencolor</a>."

#. type: Plain text
#: ../E/colors.txt:4
#, no-wrap
msgid "In a program, colors are always displayed on a <format const>red background</format>. If a color isn't highlighted in red, it is misspelled. Caps and lower cases should be kept as is."
msgstr "En un programa, los colores siempre se muestran en un <format const>background rojo</format>. Si un color no aparece resaltado en rojo, está mal escrito. Las mayúsculas y minúsculas deben mantenerse tal como están."

