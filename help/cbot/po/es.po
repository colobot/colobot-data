#. type: \b; header
#: ../E/aim.txt:1
#, no-wrap
msgid "Instruction <code>aim</code>"
msgstr "Instrucción <code>aim</code>"

#. type: Plain text
#: ../E/aim.txt:5
#, no-wrap
msgid "This instruction sets the vertical and the horizontal angle of the cannon. The following robots are equipped with a cannon: "
msgstr "Esta instrucción establece el ángulo vertical y el cañón horizontal. Los siguientes robots están equipados con un cañón: "

#. type: Plain text
#: ../E/fire.txt:18
#, no-wrap
msgid "When controlling the robot through programming, the only way to turn the gun left or right is to turn the whole robot with the instruction <code><a cbot|turn>turn</a></code>."
msgstr "Al controlar el robot a través de la programación, la única forma de girar el arma a la izquierda o a la derecha es girar todo el robot con la instrucción <code><a cbot|turn>turn</a></code>."

