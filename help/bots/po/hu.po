#, no-wrap
msgid "<button 158/> Practice Bot"
msgstr "<button 158/> Gyakorlóbot"

#. type: Image filename
#: ../E/bottr.txt:2
#, no-wrap
msgid "bottr"
msgstr "bottr"

#. type: Plain text
#: ../E/bottr.txt:3
#, no-wrap
msgid "Wheeled bot intended solely for training and practice. Its only purpose is to help you get accustomed to the programming of the bots' various ground movements."
msgstr "Kerekes robot, amely kizárólag gyakorlásra szolgál. Segít elsajátítani a robotok különféle földi mozgásainak programozását."

#. type: \t; header
