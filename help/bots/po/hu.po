#, no-wrap
msgid "Instructions"
msgstr "Utasítások"

#. type: Plain text
#: ../E/bottr.txt:6
#, no-wrap
msgid "To program the bot's movements, use the following commands: <code><a cbot|move>move</a></code>, <code><a cbot|turn>turn</a></code>, <code><a cbot|motor>motor</a></code>, <code><a cbot|goto>goto</a></code>."
msgstr "A robot mozgásának programozásához használd a következő parancsokat: \\c;\\l;move\\u cbot\\move;\\n;, \\c;\\l;turn\\u cbot\\turn;\\n;, \\c;\\l;motor\\u cbot\\motor;\\n;, \\c;\\l;goto\\u cbot\\goto;\\n;."

#. type: Plain text
