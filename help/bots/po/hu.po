#. type: \b; header
#: ../E/bottump.txt:1
#, no-wrap
msgid "<button 146/> Thumper"
msgstr "<button 146/> Döngölő"

#. type: Image filename
#: ../E/bottump.txt:2
#, no-wrap
msgid "bottump"
msgstr "bottump"

#. type: Plain text
#: ../E/bottump.txt:3
#, no-wrap
msgid "Tracked bot designed to hit the ground with enormous force. The purpose of the thumping is to turn <a object|ant>ants</a> and <a object|spider>spiders</a> belly up within a radius of 100 meters. An insect on its back is not dead but will struggle to get right side up again. After approximately 60 seconds of effort, it will usually succeed."
msgstr "Lánctalpas robot, amely hatalmas erővel csapódik a földbe. A döngölés célja, hogy a <a object|ant>hangyákat</a> és <a object|spider>pókokat</a> a hátukra fordítsa 100 méteres körzetben. A rovarok nem halnak meg, de ideiglenesen harcképtelenné válnak, és általában 60 másodperc alatt képesek visszafordulni."

#. type: Plain text
#: ../E/bottump.txt:5
#, no-wrap
msgid "To visualize the zone of impact, hit the <range> button <button 41/>. Little red dots outline the circular zone for 20 seconds."
msgstr "A becsapódási zóna megjelenítéséhez nyomja meg a <range> gombot <button 41/>. Kis piros pontok jelölik ki a kör alakú zónát 20 másodpercre."

#. type: Plain text
#: ../E/bottump.txt:7
#, no-wrap
msgid "The bot uses up a large amount of power. A thump will drain 2/5ths of a <a object|power>regular power cell</a>."
msgstr "A robot sok energiát fogyaszt. Egy ütés 2/5-ét lemeríti egy <a object|power>normál energia cellának</a>."

#. type: Plain text
#: ../E/bottump.txt:12
#, no-wrap
msgid "To program the thumping, use <code><a cbot|thump>thump</a></code>."
msgstr "Az ütés programozásához használja a <code><a cbot|thump>thump</a></code> parancsot."

#. type: Plain text
#: ../E/bottump.txt:15
#, no-wrap
msgid "<code>Thumper</code>"
msgstr "<code>Thumper</code>"

