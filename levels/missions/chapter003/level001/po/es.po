#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "The Trap"
msgstr "La Trampa"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Explore a tropical paradise looking for an explosive device."
msgstr "Explora un paraíso tropical buscando un dispositivo explosivo."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "The observation satellite has detected a new kind of explosive apparently designed by the previous expedition. You must locate it and bring it back to your <a object|base>spaceship</a>."
msgstr "El satélite de observación ha detectado un nuevo tipo de explosivo aparentemente diseñado por la expedición anterior. Debes localizarlo y traerlo de vuelta a tu <a object|base>nave espacial</a>."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Procedure"
msgstr "Procedimiento"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "The location of the explosive is marked by a red cross on your mini map."
msgstr "La ubicación del explosivo está marcada con una cruz roja en tu mini mapa."

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:9 ../help/soluce.E.txt:4
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:10 ../help/soluce.E.txt:5
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Informe Satelital"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Tropica."
msgstr "Actualmente en órbita geoestacionaria de Trópica."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> SUPERFICIE<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      32.4C\n"
"\\tab;Atmosphere:       helium, oxygen\n"
"\\tab;Wind:             1.2 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Temperatura:      32.4C\n"
"\\tab;Atmósfera:       helio, oxígeno\n"
"\\tab;Viento:           1.2 mps\n"
"\\tab;Mineral de titanio: ninguno\n"
"\\tab;Mineral de uranio:  ninguno"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SUBSUELO<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fuente de energía:  ninguna\n"
"\\tab;Mineral de titanio: ninguno\n"
"\\tab;Mineral de uranio:  ninguno"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> INFORMACIÓN ADICIONAL<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         explosive\n"
"\\tab;  - Type:         unknown\n"
"\\tab;Detected:         unidentified organisms\n"
"\\tab;  - Danger:       ?"
msgstr ""
"\\tab;Detectado:       explosivo\n"
"\\tab;  - Tipo:         desconocido\n"
"\\tab;Detectado:       organismos no identificados\n"
"\\tab;  - Peligro:      ?"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Follow the path shown on your mini map. The explosive device lies at the bottom of a small valley populated by giant ants. They will probably attack you and you will probably lose consciousness. There is nothing you can really do about this."
msgstr "Sigue el camino mostrado en tu mini mapa. El dispositivo explosivo se encuentra en el fondo de un pequeño valle poblado por hormigas gigantes. Probablemente te atacarán y probablemente perderás el conocimiento. No hay mucho que puedas hacer al respecto."
