#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "The Trap"
msgstr "A csapda"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Explore a tropical paradise looking for an explosive device."
msgstr "Fedezz fel egy trópusi paradicsomot, és keresd meg a robbanószerkezetet."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A küldetésirányítótól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "The observation satellite has detected a new kind of explosive apparently designed by the previous expedition. You must locate it and bring it back to your <a object|base>spaceship</a>."
msgstr "A megfigyelő műhold egy újfajta robbanószerkezetet észlelt, amelyet feltehetően az előző expedíció tervezett. Meg kell találnod, és vissza kell vinned az <a object|base>űrhajódra</a>."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Procedure"
msgstr "Eljárás"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "The location of the explosive is marked by a red cross on your mini map."
msgstr "A robbanószerkezet helyét egy piros kereszt jelöli a mini térképen."

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "A <format key><key help/></format> megnyomásával bármikor újra megtekintheted ezeket az utasításokat a SatCom <button 63/> eszközödön."

#. type: \t; header
#: ../help/help.E.txt:9 ../help/soluce.E.txt:4
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:10 ../help/soluce.E.txt:5
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Tropica."
msgstr "Jelenleg geostacionárius pályán kering a Tropica felett."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELSZÍN<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      32.4C\n"
"\\tab;Atmosphere:       helium, oxygen\n"
"\\tab;Wind:             1.2 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:      32.4°C\n"
"\\tab;Légkör:           hélium, oxigén\n"
"\\tab;Szél:             1.2 m/s\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> ALTALAJ<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:    nincs\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> TOVÁBBI INFORMÁCIÓK<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         explosive\n"
"\\tab;  - Type:         unknown\n"
"\\tab;Detected:         unidentified organisms\n"
"\\tab;  - Danger:       ?"
msgstr ""
"\\tab;Észlelve:         robbanószer\n"
"\\tab;  - Típus:        ismeretlen\n"
"\\tab;Észlelve:         azonosítatlan élőlények\n"
"\\tab;  - Veszély:      ?"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Follow the path shown on your mini map. The explosive device lies at the bottom of a small valley populated by giant ants. They will probably attack you and you will probably lose consciousness. There is nothing you can really do about this."
msgstr "Kövesd a mini térképen látható utat. A robbanószerkezet egy kis völgy alján található, amelyet óriás hangyák népesítenek be. Valószínűleg megtámadnak, és elveszíted az eszméleted. Ezzel nem tudsz igazán mit tenni."
