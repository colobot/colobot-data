#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Black Box"
msgstr "Fekete doboz"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Explore the underwater world looking for another black box."
msgstr "Fedezd fel a víz alatti világot, és keress meg egy újabb fekete dobozt."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A Küldetésirányító Központtól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Locate and retrieve another <a object|bbox>black box</a> from the previous expedition."
msgstr "Keress meg és hozz vissza egy újabb <a object|bbox>fekete dobozt</a> az előző expedícióból."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "The observation satellite seems to have spotted it underwater. Water is harmless to you as long as you wear your helmet but keep in mind that you can't carry objects underwater. A <a object|botsub>subber</a> may come in handy."
msgstr "Úgy tűnik, a megfigyelő műhold észlelte a víz alatt. A víz nem árt neked, amíg viseled a sisakodat, de ne feledd, hogy a víz alatt nem tudsz tárgyakat szállítani. Egy <a object|botsub>búvárrobot</a> hasznos lehet."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> segítségével bármikor újra megtekintheted ezeket az utasításokat a személyes SatCom-odon <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:14
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Irányítás</a> és <a cbot>CBOT nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Tropica."
msgstr "Jelenleg geostacionárius pályán kering a Tropica felett."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELSZÍN<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      29.4C\n"
"\\tab;Atmosphere:       helium, oxygen\n"
"\\tab;Wind:             0.3 mps\n"
"\\tab;Titanium ore:     some\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:     29.4C\n"
"\\tab;Légkör:          hélium, oxigén\n"
"\\tab;Szél:            0.3 m/s\n"
"\\tab;Titánérc:        némi\n"
"\\tab;Uránérc:         nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> ALTALAJ<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:  nincs\n"
"\\tab;Titánérc:       nincs\n"
"\\tab;Uránérc:        nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> TOVÁBBI INFORMÁCIÓK<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         titanium ore\n"
"\\tab;  - Requires:     converter\n"
"\\tab;Detected:         scattered derelicts\n"
"\\tab;Detected:         black box (underwater)"
msgstr ""
"\\tab;Észlelve:        titánérc\n"
"\\tab;  - Szükséges:    konverter\n"
"\\tab;Észlelve:        szétszórt roncsok\n"
"\\tab;Észlelve:        fekete doboz (víz alatt)"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Locate the <a object|bbox>black box</a> on your own. You can try to spot it from above, using your jet engine, or dive into the water."
msgstr "Keresd meg magad a <a object|bbox>fekete dobozt</a>. Megpróbálhatod kiszúrni a magasból, a hajtóműved segítségével, vagy lemerülhetsz érte a víz alá."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "Build a <a object|convert>converter</a> near the chunks of titanium ore. You'll find them in the vicinity of the spaceship to the east."
msgstr "Építs egy <a object|convert>konvertert</a> a titánérc-darabok közelében. Ezeket a hajótól keletre találod meg."


#. type: Bullet: '3)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Produce two <a object|titan>cubes</a>."
msgstr "Készíts két <a object|titan>kockát</a>."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Build a <a object|factory>bot factory</a> not too far from the black box."
msgstr "Építs egy <a object|factory>robotgyárat</a> nem túl messze a feketedoboztól."

#. type: Bullet: '5)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Manufacture a <a object|botsub>subber</a>."
msgstr "Gyárts egy <a object|botsub>búvárrobotot</a>."

#. type: Bullet: '6)'
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "Bring the black box back on board."
msgstr "Hozd vissza a feketedobozt a fedélzetre."

#. type: Bullet: '7)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "Take off."
msgstr "Indulj el."

#. type: Plain text
#: ../help/soluce.E.txt:10
#, no-wrap
msgid "The black box is lying at the bottom of a small lake, northeast of the spaceship."
msgstr "A feketedoboz egy kis tó fenekén fekszik, a űrhajótól északkeletre."

#. type: Plain text
#: ../help/soluce.E.txt:12
#, no-wrap
msgid "You can build the bot factory right beside the lake, on the south bank."
msgstr "A robotgyárat közvetlenül a tó mellett, a déli parton építheted fel."

#. type: Plain text
#: ../help/soluce.E.txt:15
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"
