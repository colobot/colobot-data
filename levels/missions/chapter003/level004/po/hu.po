"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:    nincs\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "If your bot suddenly explodes, this means that you have hit the steel structures too often. Drive more slowly, so your bot will not be damaged even if you bump into an obstacle."
msgstr "Ha a robotod hirtelen felrobban, az azt jelenti, hogy túl gyakran ütköztél az acélszerkezeteknek. Repülj lassabban, így nem sérül meg, ha akadálynak ütközöl."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "If you can not take off after you completed the training, this means that you have not hit all the targets. Go round one more time, and check if any of the explosive devices or crosses in the center of the steel structures are left."
msgstr "Ha nem tudsz felszállni a gyakorlat végén, az azt jelenti, hogy nem semmisítetted meg az összes célt. Menj még egy kört, és nézd meg, maradt-e robbanószerkezet vagy kereszt az acélszerkezetek közepén."

#. type: Plain text
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"
