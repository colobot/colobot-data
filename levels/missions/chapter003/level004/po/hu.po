"\\tab;Temperature:      32.2C\n"
"\\tab;Atmosphere:       helium, oxygen\n"
"\\tab;Wind:             0.7 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:      32,2 °C\n"
"\\tab;Légkör:           hélium, oxigén\n"
"\\tab;Szél:             0,7 m/s\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: Source code
#: ../help/report.E.txt:11
