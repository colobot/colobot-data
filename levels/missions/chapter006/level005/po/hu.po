#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Safe Home"
msgstr "Biztonságos haza"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Get back to your spaceship."
msgstr "Térj vissza a űrhajódhoz."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A Misszióirányítástól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Congratulations on a fine job as usual."
msgstr "Gratulálunk a szokásos remek munkádhoz."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "This new weapon appears to be yet another practical application of what we've come to refer to as \"green gold\", the <a object|bullet>organic matter</a> produced by the insects. We've named this bot the <a object|botoj>orga shooter</a> or bot equipped with an orgaball cannon."
msgstr "Ez az új fegyver úgy tűnik, hogy egy újabb praktikus alkalmazása annak, amit mi \"zöld aranynak\" hívunk, az <a object|bullet>organikus anyag</a>, amelyet a rovarok termelnek. Ezt a robotot <a object|botoj>Orgashooter</a>-nek vagy orgaball ágyús robottá nevezhettük el."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "It will most certainly come in handy as you make your way back to your <a object|base>spaceship</a>."
msgstr "Biztosan hasznos lesz, miközben visszajutsz a <a object|base>űrhajódhoz</a>."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> lehetővé teszi, hogy bármikor áttekintsd ezeket az utasításokat a személyes SatCom-on <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:10 ../help/soluce.E.txt:10
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Vezérlés</a> és <a cbot>CBOT Nyelv</a>"

