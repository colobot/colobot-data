#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Játszmod"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Everything is blowing up around you. You need to leave the old basecamp as quickly as possible. Just retreat the same way you came."
msgstr "Minden felrobban körülötted. El kell hagynod a régi táborhelyet a lehető leggyorsabban. Csak térj vissza ugyanazon az úton, amin érkeztél."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "<a object|ant>Ants</a> are fairly easy to avoid. If you're badly hit, find a quiet spot and wait until your shield has regenerated."
msgstr "Az <a object|ant>hangyákat</a> elég könnyű elkerülni. Ha súlyosan megsérülsz, keress egy csendes helyet, és várj, amíg a pajzsod regenerálódik."

#. type: Plain text
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "<a object|spider>Spiders</a> are a bit tougher but also more stupid. As soon as they see you, they burst their abdomen, dying in the process. If one fragment hits you, you'll die too. One risky but efficient method to rid yourself of a spider consists in moving dangerously close and, when the spider's abdomen starts inflating, swiftly fly backwards to safety."
msgstr "<a object|spider>Pókok</a> egy kicsit keményebbek, de egyben ostobábbak is. Amint meglátnak, felrobbantják a hasukat, és közben meghalnak. Ha egy darab eltalál, te is meghalsz. Egy kockázatos, de hatékony módszer a pókok megszabadítására, ha veszélyesen közel mész hozzájuk, és amikor a hasuk elkezd felfúvódni, gyorsan hátrarepülsz a biztonságba."

#. type: Plain text
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "As soon as you have reached a quiet island, you can use the <a object|botoj>winged orga shooter</a> to clear your way of hostile insects. Be careful not to lose it, otherwise the whole mission would be in vain."
msgstr "Amint elérsz egy csendes szigetet, használhatod a <a object|botoj>szárnyas orga lövőt</a>, hogy megtisztítsd az utadat az ellenséges rovaroktól. Légy óvatos, hogy ne veszítsd el, különben az egész küldetés kárba vész."

#. type: Plain text
#: ../help/soluce.E.txt:11
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"
