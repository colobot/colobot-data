#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Time for a sharp exit"
msgstr "Itt az idő, hogy gyorsan távozzunk"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Try to leave the planet alive."
msgstr "Próbálj meg élve elhagyni a bolygót."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A küldetésirányítástól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "You need to repel a last minute ant attack before taking off."
msgstr "Először vissza kell verned egy utolsó pillanatban érkező hangyainváziót, mielőtt felszállsz."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> lehetőséget ad arra, hogy bármikor átnézd ezeket az utasításokat a személyes SatCom <button 63/> eszközödön."

#. type: \t; header
#: ../help/help.E.txt:6 ../help/soluce.E.txt:8
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Vezérlés</a> és <a cbot>CBOT nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műhold jelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Volcano."
msgstr "Jelenleg a Volcano körüli geostacionárius pályán tartózkodom."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> Felület<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      96.6C\n"
"\\tab;Atmosphere:       CO2, SO2, HCN, HS, CH4, NH3\n"
"\\tab;Wind:             2.7 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:     96.6C\n"
"\\tab;Atmoszféra:     CO2, SO2, HCN, HS, CH4, NH3\n"
"\\tab;Szél:           2.7 m/s\n"
"\\tab;Titánérc:       nincs\n"
"\\tab;Uránérc:        nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> Föld alatti<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiforrás:    nincs\n"
"\\tab;Titanérc:        nincs\n"
"\\tab;Uránérc:         nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> További információk<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       immediate"
msgstr ""
"\\tab;Felfedezve:      óriás hangyák\n"
"\\tab;  - Veszély:      közvetlen"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Lépésről lépésre"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "It is safer for <a object|human>you</a> to stay on the <a object|base>spaceship</a>. You may get hit a few times but not fatally."
msgstr "Biztonságosabb, ha <a object|human>ön</a> a <a object|base>űrhajón</a> marad. Előfordulhat, hogy néhányszor eltalálják, de nem életveszélyesen."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Put your new <a object|botoj>winged orga shooter</a> to good use and don't waste any time. First shoot the ants on your right, then turn clockwise around the spaceship, flying at low altitude."
msgstr "Használja ki jól az új <a object|botoj>szárnyas orga puskát</a>, és ne pazaroljon időt. Először lője le a jobboldali hangyákat, majd forduljon az űrhajó körül az óramutató járásával megegyezően, alacsony magasságban repülve."

#. type: Plain text
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "If you can not do it this way, place the <a object|botoj>winged orga shooter</a> on a safe place north of the spaceship, then save yourself. You can then take your time to shoot the ants one after another; they can do no harm to the spaceship and the black box."
msgstr "Ha így nem sikerül, helyezze a <a object|botoj>szárnyas orga puskát</a> egy biztonságos helyre az űrhajó északi részén, majd meneküljön el. Ezután nyugodtan lelőheti a hangyákat egyesével; nem okozhatnak kárt az űrhajóban vagy a fekete dobozban."

#. type: Plain text
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "A <a command>vezérlés</a>"
