#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Time for a sharp exit"
msgstr "Hora de una Salida Rápida"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Try to leave the planet alive."
msgstr "Intenta dejar el planeta con vida."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "You need to repel a last minute ant attack before taking off."
msgstr "Necesitas rechazar un ataque de hormigas de último minuto antes de despegar."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

