#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "It is safer for <a object|human>you</a> to stay on the <a object|base>spaceship</a>. You may get hit a few times but not fatally."
msgstr "Es más seguro para <a object|human>ti</a> permanecer en la <a object|base>nave espacial</a>. Puedes recibir algunos golpes pero no serán fatales."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Put your new <a object|botoj>winged orga shooter</a> to good use and don't waste any time. First shoot the ants on your right, then turn clockwise around the spaceship, flying at low altitude."
msgstr "Usa bien tu nuevo <a object|botoj>disparador orga alado</a> y no pierdas tiempo. Primero dispara a las hormigas a tu derecha, luego gira en el sentido de las agujas del reloj alrededor de la nave espacial, volando a baja altitud."

#. type: Plain text
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "If you can not do it this way, place the <a object|botoj>winged orga shooter</a> on a safe place north of the spaceship, then save yourself. You can then take your time to shoot the ants one after another; they can do no harm to the spaceship and the black box."
msgstr "Si no puedes hacerlo de esta manera, coloca el <a object|botoj>disparador orga alado</a> en un lugar seguro al norte de la nave espacial, luego escónete. Entonces podrás tomarte tu tiempo para disparar a las hormigas una por una; no pueden hacer daño a la nave espacial ni a la caja negra."

#. type: Plain text
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"
