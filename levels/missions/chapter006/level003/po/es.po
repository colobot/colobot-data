#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Mountain Warfare"
msgstr "Guerra de Montaña"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Use legged bots to fight on broken terrain."
msgstr "Usa bots con patas para combatir en terreno accidentado."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This planet is obviously unsuited to a long-lasting colonization. Retrieve the <a object|bbox>black box</a> from the previous expedition then take off."
msgstr "Este planeta es obviamente inadecuado para una colonización duradera. Recupera la <a object|bbox>caja negra</a> de la expedición anterior y luego despega."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:6 ../help/soluce.E.txt:10
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Informe del Satélite"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Volcano."
msgstr "Actualmente en órbita geoestacionaria de Volcano."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> SUPERFICIE<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      83.5C\n"
"\\tab;Atmosphere:       CO2, SO2, HCN, HS, CH4, NH3\n"
"\\tab;Wind:             3.4 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Temperatura:      83.5C\n"
"\\tab;Atmósfera:        CO2, SO2, HCN, HS, CH4, NH3\n"
"\\tab;Viento:           3.4 mps\n"
"\\tab;Mineral titanio:  ninguno\n"
"\\tab;Mineral uranio:   ninguno"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SUBSUELO<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    everywhere\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fuente energía:   en todas partes\n"
"\\tab;Mineral titanio:  ninguno\n"
"\\tab;Mineral uranio:   ninguno"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> INFORMACIÓN ADICIONAL<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       not immediate"
msgstr ""
"\\tab;Detectado:        hormigas gigantes\n"
"\\tab;  - Peligro:       no inmediato"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Climb the northern cliff and kill a few <a object|ant>ants</a>. The best access is from the east."
msgstr "Escala el acantilado del norte y mata a algunas <a object|ant>hormigas</a>. El mejor acceso es desde el este."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Keep going until all ants are out of the way."
msgstr "Continúa hasta que todas las hormigas estén fuera del camino."

#. type: Plain text
#: ../help/soluce.E.txt:11
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Power a <a object|botfs>legged shooter</a>. There is even a <a object|atomic>nuclear cell</a> left behind the <a object|factory>bot factory</a>."
msgstr "Alimenta un <a object|botfs>disparador con patas</a>. Incluso hay una <a object|atomic>celda nuclear</a> dejada detrás de la <a object|factory>fábrica de bots</a>."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "Climb the northern cliff with a <a object|botgs>legged grabber</a> and retrieve the <a object|bbox>black box</a> that you will find in the derelict bot factory."
msgstr "Escala el acantilado del norte con un <a object|botgs>recogedor con patas</a> y recupera la <a object|bbox>caja negra</a> que encontrarás en la fábrica de bots abandonada."
