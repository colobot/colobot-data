#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Technological Treasure"
msgstr "Tesoro Tecnológico"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Rediscover a new type of bot."
msgstr "Redescubre un nuevo tipo de bot."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "An urgent notification from Mission Control"
msgstr "Una notificación urgente del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "As you were about to take off, we received from the satellite the following piece of information: a bot of a type yet unknown has been spotted on Volcano. Try to bring it back onto your spaceship for further study."
msgstr "Cuando estabas a punto de despegar, recibimos del satélite la siguiente información: se ha detectado en Volcano un bot de un tipo aún desconocido. Intenta traerlo de vuelta a tu nave espacial para estudiarlo más."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Our engineers on Earth have very recently come up with a formula that should allow reactors to function properly, at least for a short while, despite the high temperatures. The data have been transmitted to you."
msgstr "Nuestros ingenieros en la Tierra han desarrollado recientemente una fórmula que debería permitir que los reactores funcionen correctamente, al menos por un tiempo breve, a pesar de las altas temperaturas. Los datos te han sido transmitidos."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:12
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

