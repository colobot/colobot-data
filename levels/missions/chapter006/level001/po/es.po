#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Start by recharging a <a object|power>regular power cell</a> and power the <a object|research>research center</a>. Use it to research the technology for the building of a <a object|nuclear>nuclear plant</a> <button 170/>."
msgstr "Comienza recargando una <a object|power>celda de energía regular</a> y enciende el <a object|research>centro de investigación</a>. Úsalo para investigar la tecnología para la construcción de una <a object|nuclear>planta nuclear</a> <button 170/>."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Produce a <a object|botgr>wheeled grabber</a>."
msgstr "Produce un <a object|botgr>robot recogedor con ruedas</a>."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Find some <a object|uranore>uranium ore</a> northwest of your position. The nuclear plant will then transform it into <a object|atomic>nuclear power cells</a> of a longer duration."
msgstr "Encuentra algo de <a object|uranore>mineral de uranio</a> al noroeste de tu posición. La planta nuclear lo transformará entonces en <a object|atomic>celdas de energía nuclear</a> de mayor duración."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "Power a <a object|botfr>wheeled shooter</a> with one of your new nuclear cells. Dispatch it to kill all intruding <a object|spider>spiders</a> along the way."
msgstr "Equipa un <a object|botfr>robot disparador con ruedas</a> con una de tus nuevas células nucleares. Envíalo para matar a todas las <a object|spider>arañas</a> intrusas que haya en el camino."

#. type: Bullet: '5)'
#: ../help/soluce.E.txt:10
#, no-wrap
msgid "A <a object|radar>radar</a> is optional but could turn out useful to mark the position of the spiders on your mini map."
msgstr "Un <a object|radar>radar</a> es opcional pero podría resultar útil para marcar la posición de las arañas en tu mini mapa."

#. type: Bullet: '6)'
#: ../help/soluce.E.txt:12
#, no-wrap
msgid "A wheeled grabber should be part of the expedition. It will both clear the way cluttered with <a object|titanore>titanium ore</a> and bring the <a object|tnt>explosive device</a> back."
msgstr "Un bot recogedor con ruedas debería ser parte de la expedición. Limpiará el camino lleno de <a object|titanore>mineral de titanio</a> y traerá de vuelta el <a object|tnt>dispositivo explosivo</a>."

#. type: Plain text
#: ../help/soluce.E.txt:15
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"
