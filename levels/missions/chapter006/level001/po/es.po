#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Transport"
msgstr "Transporte"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Develop your nuclear technology in order to increase your operating range."
msgstr "Desarrolla tu tecnología nuclear para aumentar tu rango de operación."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "You need to retrieve an <a object|tnt>explosive device</a> that has been spotted in a deep valley next to a lake of boiling lava."
msgstr "Necesitas recuperar un <a object|tnt>dispositivo explosivo</a> que ha sido detectado en un valle profundo junto a un lago de lava hirviendo."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Because of the high temperatures, reactors no longer function, i.e. flying is impossible. It is a long way there and you should equip your bots with <a object|atomic>nuclear power cells</a>. Nuclear power cells are manufactured from <a object|uranore>uranium ore</a>."
msgstr " debido a las altas temperaturas, los reactores ya no funcionan, es decir, volar es imposible. Es un camino largo y debes equipar a tus bots con <a object|atomic>celdas de energía nuclear</a>. Las celdas de energía nuclear se fabrican a partir de <a object|uranore>mineral de uranio</a>."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "A more efficient program for the gathering of raw materials is attached to this message."
msgstr "Un programa más eficiente para la recolección de materias primas está adjuntado a este mensaje."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "A note of warning: the explosive device is extremely volatile. Use extreme caution."
msgstr "Una nota de advertencia: el dispositivo explosivo es extremadamente volátil. Usa extrema precaución."

#. type: Plain text
#: ../help/help.E.txt:10
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:12 ../help/soluce.E.txt:14
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:13
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

