#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Building"
msgstr "Construcción"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Learn how to construct buildings."
msgstr "Aprende a construir edificios."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This is your second drill. <a object|human>You</a> should now familiarize yourself with the handling of basic equipment. This could turn out to be your best ally during the course of this expedition."
msgstr "Este es tu segundo ejercicio. <a object|human>Tú</a> deberías ahora familiarizarte con el manejo del equipo básico. Esto podría resultar ser tu mejor aliado durante el curso de esta expedición."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "The construction of buildings and the manufacturing of bots all require the use of <a object|titan>titanium</a>. Titanium is a mineral found in most solar systems in the universe."
msgstr "La construcción de edificios y la fabricación de bots requieren el uso de <a object|titan>titanio</a>. El titanio es un mineral que se encuentra en la mayoría de los sistemas solares del universo."

#. type: \b; header
#: ../help/help.E.txt:6
#, no-wrap
msgid "Procedure"
msgstr "Procedimiento"

#. type: Bullet: '1)'
#: ../help/help.E.txt:7
#, no-wrap
msgid "Position yourself close to the first <a object|titan>titanium cube</a>."
msgstr "Posiciónate cerca del primer <a object|titan>cubo de titanio</a>."

#. type: Bullet: '2)'
#: ../help/help.E.txt:8
#, no-wrap
msgid "Build a <a object|research>research center</a> <button 163/>. Note that only <a object|human>you</a> can accomplish the task of building; no bot can be substituted."
msgstr "Construye un <a object|research>centro de investigación</a> <button 163/>. Ten en cuenta que solo <a object|human>tú</a> puedes realizar la tarea de construcción; ningún bot puede sustituirte."

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:13 ../help/soluce.E.txt:10
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:14 ../help/soluce.E.txt:11
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Walk down the street that runs beside <a object|Huston>Mission Control</a>. You will find a <a object|titan>titanium cube</a> on the left hand side of the road, right after the <a object|botgr>grabber bot</a>."
msgstr "Camina por la calle que pasa junto al <a object|Huston>Control de Misiones</a>. Encontrarás un <a object|titan>cubo de titanio</a> en el lado izquierdo del camino, justo después del <a object|botgr>bot recogedor</a>."

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Face the cube. Click on the first button at the bottom left of your screen: <button 163/> <build a <a object|research>research center</a>>."
msgstr "Mira hacia el cubo. Haz clic en el primer botón en la parte inferior izquierda de tu pantalla: <button 163/> <construir un <a object|research>centro de investigación</a>>."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Walk further down the road. The second cube is on the right past the four green <a object|power>power cells</a>."
msgstr "Continúa caminando por el camino. El segundo cubo está a la derecha después de las cuatro <a object|power>celdas de energía</a> verdes."

#. type: Plain text
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "As soon as both buildings are completed, the mission is at an end."
msgstr "Tan pronto como ambos edificios estén completados, la misión habrá terminado."

#. type: Bullet: '3)'
#: ../help/help.E.txt:9
#, no-wrap
msgid "With a second <a object|titan>titanium cube</a>, build a <a object|factory>bot factory</a> <button 160/>."
msgstr "Con un segundo <a object|titan>cubo de titanio</a>, construye una <a object|factory>fábrica de bots</a> <button 160/>."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Repeat 1) but click on the second button: <button 160/> <build a <a object|factory>bot factory</a>>."
msgstr "Repite 1) pero haz clic en el segundo botón: <button 160/> <construir una <a object|factory>fábrica de bots</a>>."
