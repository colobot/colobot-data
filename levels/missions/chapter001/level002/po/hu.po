#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Building"
msgstr "Épületek"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Learn how to construct buildings."
msgstr "Tanuld meg, hogyan lehet épületeket építeni."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Az irányítóközpontból"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This is your second drill. <a object|human>You</a> should now familiarize yourself with the handling of basic equipment. This could turn out to be your best ally during the course of this expedition."
msgstr "Ez a második gyakorlatod. <a object|human>Most</a> meg kell ismerkedned az alapfelszerelés használatával. Ez lehet a legmegbízhatóbb társad ezen az expedíción."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "The construction of buildings and the manufacturing of bots all require the use of <a object|titan>titanium</a>. Titanium is a mineral found in most solar systems in the universe."
msgstr "Az építkezéshez és a robotok gyártásához <a object|titan>titánra</a> van szükség. A titán egy ásvány, amely a legtöbb csillagrendszerben előfordul az univerzumban."

#. type: \b; header
#: ../help/help.E.txt:6
#, no-wrap
msgid "Procedure"
msgstr "Eljárás"

#. type: Bullet: '1)'
#: ../help/help.E.txt:7
#, no-wrap
msgid "Position yourself close to the first <a object|titan>titanium cube</a>."
msgstr "Állj az első <a object|titan>titánkocka</a> közelébe."

#. type: Bullet: '2)'
#: ../help/help.E.txt:8
#, no-wrap
msgid "Build a <a object|research>research center</a> <button 163/>. Note that only <a object|human>you</a> can accomplish the task of building; no bot can be substituted."
msgstr "Építs egy <a object|research>kutatóközpontot</a> <button 163/>. Ne feledd, csak <a object|human>te</a> tudsz építeni; robot nem helyettesíthet."

#. type: Bullet: '3)'
#: ../help/help.E.txt:9
#, no-wrap
msgid "With a second <a object|titan>titanium cube</a>, build a <a object|factory>bot factory</a> <button 160/>."
msgstr "A második <a object|titan>titánkockából</a> építs egy <a object|factory>robotgyárat</a> <button 160/>."

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "A <format key><key help/></format> segítségével bármikor újraolvashatod ezeket az utasításokat a személyes SatCom készülékeden <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:13 ../help/soluce.E.txt:10
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:14 ../help/soluce.E.txt:11
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Walk down the street that runs beside <a object|Huston>Mission Control</a>. You will find a <a object|titan>titanium cube</a> on the left hand side of the road, right after the <a object|botgr>grabber bot</a>."
msgstr "Sétálj végig az utcán, ami a <a object|Huston>irányítóközpont</a> mellett fut. Az úttest bal oldalán találsz egy <a object|titan>titánkockát</a>, közvetlenül a <a object|botgr>szállítórobot</a> után."

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Face the cube. Click on the first button at the bottom left of your screen: <button 163/> <build a <a object|research>research center</a>>."
msgstr "Fordulj a kocka felé. Kattints a képernyő bal alsó sarkában lévő első gombra: <button 163/> <építs egy <a object|research>kutatóközpontot</a>>."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Walk further down the road. The second cube is on the right past the four green <a object|power>power cells</a>."
msgstr "Menj tovább az úton. A második kocka jobb oldalon van, a négy zöld <a object|power>energiaforrás</a> után."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Repeat 1) but click on the second button: <button 160/> <build a <a object|factory>bot factory</a>>."
msgstr "Ismételd meg az 1) lépést, de most kattints a második gombra: <button 160/> <építs egy <a object|factory>robotgyárat</a>>."

#. type: Plain text
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "As soon as both buildings are completed, the mission is at an end."
msgstr "Amint mindkét épület elkészül, a küldetés véget ér."
