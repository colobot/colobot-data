#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "If your bot suddenly explodes, this means that you have hit the steel structures too often. Drive more slowly, so your bot will not be damaged even if you bump into an obstacle."
msgstr "Ha a robotod hirtelen felrobban, az azt jelenti, hogy túl gyakran nekiütköztél az acélszerkezeteknek. Menj lassabban, hogy ne sérüljön meg akkor sem, ha akadályba ütközöl."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "If you can not take off after you have completed the training, this means that you did not pass through all the targets. Go round one more time, and pass through the targets where the cross is left in the center."
msgstr "Ha nem tudsz felszállni az edzés befejezése után, az azt jelenti, hogy nem haladtál át minden célponton. Menj egy újabb kört, és repülj át azokon, ahol még ott maradt a kereszt középen."

#. type: Plain text
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"

