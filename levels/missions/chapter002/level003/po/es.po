#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "If your bot suddenly explodes, this means that you have hit the steel structures too often. Drive more slowly, so your bot will not be damaged even if you bump into an obstacle."
msgstr "Si tu bot explota repentinamente, significa que has golpeado las estructuras de acero con demasiada frecuencia. Conduce más lentamente, para que tu bot no se dañe incluso si choc contra un obstáculo."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "If you can not take off after you have completed the training, this means that you did not pass through all the targets. Go round one more time, and pass through the targets where the cross is left in the center."
msgstr "Si no puedes despegar después de haber completado el entrenamiento, significa que no pasaste por todos los objetivos. Da una vuelta más y pasa por los objetivos donde la cruz se deja en el centro."

#. type: Plain text
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"
