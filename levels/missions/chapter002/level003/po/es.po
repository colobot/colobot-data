#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Flying Drill #2"
msgstr "Ejercicio de Vuelo #2"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Sharpen your flying skills (cont'd)."
msgstr "Afina tus habilidades de vuelo (cont.)."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Similar drill as before, only this time viewed through the camera placed on board."
msgstr "Ejercicio similar al anterior, solo que esta vez visto a través de la cámara instalada a bordo."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

