#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Flying Drill #2"
msgstr "Repülési gyakorlat 2"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Sharpen your flying skills (cont'd)."
msgstr "Fejleszd a repülési képességeidet (folytatás)."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A Misszióirányításból"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Similar drill as before, only this time viewed through the camera placed on board."
msgstr "Hasonló gyakorlat, mint előzőleg, csak most a fedélzeti kamerán keresztül nézheted."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> lehetőséget ad arra, hogy bármikor újra megtekintsd ezeket az utasításokat a személyes SatComodon <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:6 ../help/soluce.E.txt:6
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "A <a command>Vezérlés</a> és a <a cbot>CBOT nyelv</a>"

