#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Logistics"
msgstr "Logisztika"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Lay the foundations for a relay station and a refueling station."
msgstr "Helyezd le egy reléállomás és egy üzemanyag-utántöltő állomás alapjait."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A Küldetésirányítástól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "It seems obvious enough that this planet will be no haven for humanity. "
msgstr "Nyilvánvalónak tűnik, hogy ez a bolygó nem lesz menedék az emberiség számára."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Build a radar to relay future transmissions."
msgstr "Építs egy radart a jövőbeli adások továbbításához."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "Also... we're very sorry to inform you that you may need to exterminate all hostile organisms."
msgstr "Továbbá... sajnálattal közöljük, hogy előfordulhat, minden ellenséges élőlényt el kell pusztítanod."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "The first expedition located <a object|titanore>titanium ore</a> under the surface of Orpheon. The spot is marked with a blue <a object|flag>flag</a>."
msgstr "Az első expedíció <a object|titanore>titánércet</a> talált Orpheon felszíne alatt. A helyet egy kék <a object|flag>zászló</a> jelöli."

#. type: Plain text
#: ../help/help.E.txt:10
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> segítségével bármikor újra megtekintheted ezeket az utasításokat a személyes SatCom készülékeden <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:12 ../help/soluce.E.txt:14
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:13
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Irányítás</a> és <a cbot>CBOT nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Orpheon."
msgstr "Jelenleg geostacionárius pályán kering Orpheon körül."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELSZÍN<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      -72.8C\n"
"\\tab;Atmosphere:       none\n"
"\\tab;Wind:             0.0 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:     -72.8C\n"
"\\tab;Légkör:          nincs\n"
"\\tab;Szél:            0.0 m/s\n"
"\\tab;Titánérc:        nincs\n"
"\\tab;Uránérc:         nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> Altalaj<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     some (blue flag)\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:   nincs\n"
"\\tab;Titánérc:        némi (kék zászló)\n"
"\\tab;Uránérc:         nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> további információ<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       not immediate\n"
"\\tab;Detected:         fierce electromagnetic storms"
msgstr ""
"\\tab;Észlelve:        óriáshangyák\n"
"\\tab;  - Veszély:     nem közvetlen\n"
"\\tab;Észlelve:        heves elektromágneses viharok"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Quickly build a <a object|captor>power captor</a> near the blue flag."
msgstr "Építs gyorsan egy <a object|captor>villámfelfogót</a> a kék zászló közelébe."

#. type: Plain text
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "All subsequent buildings should be erected within the <range> <button 41/> covered by the power captor."
msgstr "A további épületeket a <range> <button 41/> hatókörén belül építsd meg, amit a villámfelfogó lefed."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Carry some empty <a object|power>power cells</a> under the power captor. When lightning strikes, they will be recharged."
msgstr "Helyezz néhány üres <a object|power>energiacellát</a> a villámfelfogó alá. Amikor becsap a villám, feltöltődnek."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Build a <a object|derrick>derrick</a>."
msgstr "Építs egy <a object|derrick>fúrótornyot</a>."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Build a <a object|convert>converter</a>."
msgstr "Építs egy <a object|convert>konvertert</a>."

#. type: Bullet: '5)'
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "Execute the program <code>CollectTitanium3</code> in order to produce <a object|titan>titanium</a>."
msgstr "Futtasd a <code>CollectTitanium3</code> programot titán <a object|titan>kitermeléséhez</a>."

#. type: Bullet: '6)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "Build a <a object|factory>bot factory</a>."
msgstr "Építs egy <a object|factory>robotgyárat</a>."

#. type: Bullet: '7)'
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "Manufacture a <a object|botoj>winged orga shooter</a>."
msgstr "Gyárts egy <a object|botoj>szárnyas orga lövőt</a>."

#. type: Bullet: '8)'
#: ../help/soluce.E.txt:10
#, no-wrap
msgid "Build a <a object|radar>radar</a>."
msgstr "Építs egy <a object|radar>radart</a>."

#. type: Bullet: '9)'
#: ../help/soluce.E.txt:11
#, no-wrap
msgid "Locate and terminate all <a object|ant>ants</a>."
msgstr "Keresd meg és semmisítsd meg az összes <a object|ant>hangyát</a>."

#. type: Plain text
#: ../help/soluce.E.txt:12
#, no-wrap
msgid "10) Return to your <a object|base>spaceship</a> and take off."
msgstr "10) Térj vissza az <a object|base>űrhajódhoz</a>, és szállj fel."

#. type: Plain text
#: ../help/soluce.E.txt:15
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"
