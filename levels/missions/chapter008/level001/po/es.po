#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Logistics"
msgstr "Logística"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Lay the foundations for a relay station and a refueling station."
msgstr "Prepara los cimientos para una estación de relevo y una estación de reabastecimiento de combustible."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "It seems obvious enough that this planet will be no haven for humanity. "
msgstr "Parece bastante obvio que este planeta no será un refugio para la humanidad."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Build a radar to relay future transmissions."
msgstr "Construye un radar para retransmitir futuras transmisiones."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "Also... we're very sorry to inform you that you may need to exterminate all hostile organisms."
msgstr "Además... lamentamos mucho informarte de que podrías necesitar exterminar todos los organismos hostiles."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "The first expedition located <a object|titanore>titanium ore</a> under the surface of Orpheon. The spot is marked with a blue <a object|flag>flag</a>."
msgstr "La primera expedición localizó <a object|titanore>mineral de titanio</a> bajo la superficie de Orpheon. El punto está marcado con una bandera <a object|flag>azul</a>."

#. type: Plain text
#: ../help/help.E.txt:10
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:12 ../help/soluce.E.txt:14
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:13
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Informe del Satélite"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Orpheon."
msgstr "Actualmente en órbita geoestacionaria de Orpheon."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> SUPERFICIE<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      -72.8C\n"
"\\tab;Atmosphere:       none\n"
"\\tab;Wind:             0.0 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Temperatura:      -72.8C\n"
"\\tab;Atmósfera:        ninguna\n"
"\\tab;Viento:           0.0 mps\n"
"\\tab;Mineral titanio:  ninguno\n"
"\\tab;Mineral uranio:   ninguno"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SUBSUELO<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     some (blue flag)\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fuente energía:   ninguna\n"
"\\tab;Mineral titanio:  algo (bandera azul)\n"
"\\tab;Mineral uranio:   ninguno"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> INFORMACIÓN ADICIONAL<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       not immediate\n"
"\\tab;Detected:         fierce electromagnetic storms"
msgstr ""
"\\tab;Detectado:        hormigas gigantes\n"
"\\tab;  - Peligro:      no inmediato\n"
"\\tab;Detectado:       tormentas electromagnéticas feroces"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Quickly build a <a object|captor>power captor</a> near the blue flag."
msgstr "Construye rápidamente un <a object|captor> captor de energía</a> cerca de la bandera azul."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Carry some empty <a object|power>power cells</a> under the power captor. When lightning strikes, they will be recharged."
msgstr "Lleva algunas <a object|power>celdas de energía</a> vacías bajo el captor de energía. Cuando caiga un rayo, serán recargadas."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Build a <a object|derrick>derrick</a>."
msgstr "Construye una <a object|derrick>torre de perforación</a>."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Build a <a object|convert>converter</a>."
msgstr "Construye un <a object|convert>convertidor</a>."

#. type: Bullet: '5)'
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "Execute the program <code>CollectTitanium3</code> in order to produce <a object|titan>titanium</a>."
msgstr "Ejecuta el programa <code>CollectTitanium3</code> para producir <a object|titan>titanio</a>."

#. type: Bullet: '7)'
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "Manufacture a <a object|botoj>winged orga shooter</a>."
msgstr "Fabrica un <a object|botoj>disparador de orgánica alado</a>."

#. type: Bullet: '8)'
#: ../help/soluce.E.txt:10
#, no-wrap
msgid "Build a <a object|radar>radar</a>."
msgstr "Construye un <a object|radar>radar</a>."

#. type: Bullet: '9)'
#: ../help/soluce.E.txt:11
#, no-wrap
msgid "Locate and terminate all <a object|ant>ants</a>."
msgstr "Localiza y termina con todas las <a object|ant>hormigas</a>."

#. type: Plain text
#: ../help/soluce.E.txt:12
#, no-wrap
msgid "10) Return to your <a object|base>spaceship</a> and take off."
msgstr "10) Regresa a tu <a object|base>nave espacial</a> y despega."

#. type: Plain text
#: ../help/soluce.E.txt:15
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"

#. type: Plain text
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "All subsequent buildings should be erected within the <range> <button 41/> covered by the power captor."
msgstr "Todos los edificios posteriores deben erigirse dentro del <range> <button 41/> cubierto por el captor de energía."

#. type: Bullet: '6)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "Build a <a object|factory>bot factory</a>."
msgstr "Construye una <a object|factory>fábrica de bots</a>."
