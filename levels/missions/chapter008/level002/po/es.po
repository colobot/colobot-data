#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Storm Shelter"
msgstr "Refugio de Tormenta"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Retrieve the black box while protecting your bots from electrical storms."
msgstr "Recupera la caja negra mientras proteges a tus bots de las tormentas eléctricas."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Retrieve the black box."
msgstr "Recupera la caja negra."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Electromagnetic lightning bolts appear to strike even more frequently now than they did previously. You need to protect your equipment."
msgstr "Los rayos electromagnéticos parecen golpear con mayor frecuencia ahora que antes. Necesitas proteger tu equipo."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "Please note that your spaceship also naturally acts as a lightning conductor, and our engineers assure us that your space suit does not attract lightning."
msgstr "Ten en cuenta que tu nave espacial también actúa naturalmente como un pararrayos, y nuestros ingenieros nos aseguran que tu traje espacial no atrae los rayos."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:10 ../help/soluce.E.txt:8
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

