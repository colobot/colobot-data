#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Storm Shelter"
msgstr "Viharvédett Menedék"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Retrieve the black box while protecting your bots from electrical storms."
msgstr "Szerezd vissza a feketedobozt, miközben megvéded a robotokat a villámoktól."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Az irányítóközpontból"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Retrieve the black box."
msgstr "Szerezd meg a feketedobozt."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Electromagnetic lightning bolts appear to strike even more frequently now than they did previously. You need to protect your equipment."
msgstr "Az elektromágneses villámok gyakrabban csapnak le, mint korábban. Meg kell védened a felszerelésedet."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "Please note that your spaceship also naturally acts as a lightning conductor, and our engineers assure us that your space suit does not attract lightning."
msgstr "Felhívjuk a figyelmedet, hogy az űrhajód természetes villámhárítóként működik, de mérnökeink biztosítanak arról, hogy az űrruhád nem vonzza a villámokat."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "A <format key><key help/></format> megnyomásával bármikor újra megtekintheted ezeket az utasításokat a saját SatCom-odon <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:10 ../help/soluce.E.txt:8
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Irányítás</a> és <a cbot>CBOT nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Orpheon."
msgstr "Jelenleg geostacionárius pályán kering az Orpheon körül."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELSZÍN<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      -64.7C\n"
"\\tab;Atmosphere:       none\n"
"\\tab;Wind:             0.0 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:     -64.7°C\n"
"\\tab;Légkör:          nincs\n"
"\\tab;Szél:            0.0 m/s\n"
"\\tab;Titánérc:        nincs\n"
"\\tab;Uránérc:         nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> Talaj alatt<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:    nincs\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> További információk<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       not immediate\n"
"\\tab;Detected:         fierce electromagnetic storms"
msgstr ""
"\\tab;Észlelve:          óriás hangyák\n"
"\\tab;  - Veszély:       nem azonnali\n"
"\\tab;Észlelve:          heves elektromágneses viharok"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "You will find a <a object|radar>radar</a>, a <a object|captor>power captor</a>, a <a object|power>power cell</a> and a <a object|botoj>winged orga shooter</a> in the valley south of the spaceship. This will allow you to kill the ants close to the spaceship and to locate the <a object|bbox>black box</a> in the north next to the remains of the first expedition spaceship."
msgstr "Egy <a object|radar>radart</a>, egy <a object|captor>energiagyűjtőt</a>, egy <a object|power>energia cellát</a> és egy <a object|botoj>szárnyas orga lövőt</a> találhatsz a völgyben, a űrhajótól délre. Ezek segítségével megölheted az űrhajó közelében lévő hangyákat, és megtalálhatod az <a object|bbox>adatdobozt</a> északon, az első expedíció űrhajójának maradványai mellett."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Build a succession of <a object|captor>power captors</a> along the natural path offered by the northern mountain peaks. 5 or 6 captors should offer sufficient protection against lightning."
msgstr "Építs egy sor <a object|captor>energiagyűjtőt</a> az északi hegycsúcsok által kijelölt természetes ösvény mentén. 5 vagy 6 gyűjtő elegendő védelmet nyújt a villámok ellen."

#. type: Plain text
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Bring the black box back aboard your <a object|base>spaceship</a> and take off."
msgstr "Vidd vissza az adatdobozt az <a object|base>űrhajód</a> fedélzetére, és szállj fel."

#. type: Plain text
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"
