#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Disarmed"
msgstr "Lefegyverezve"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Figure out a stratagem."
msgstr "Találj ki egy stratégiát."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A Küldetésirányítótól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Your satellite has located the remains of the previous expedition. You should come across a <a object|bbox>black box</a> not too far from there. It will give you the coordinates of your next destination."
msgstr "A műholdad megtalálta az előző expedíció maradványait. Nem messze onnan találni fogsz egy <a object|bbox>fekete dobozt</a>. Az megadja a következő célállomásod koordinátáit."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Exterminate the few remaining ants. We've been notified that your neutron gun is currently out of order so you will not be able to build new bots. We're convinced that you're resourceful enough at this point to come up with a solution."
msgstr "Írd ki a még hátralévő hangyákat. Értesítettek, hogy a neutronfegyvered jelenleg nem működik, ezért nem fogsz tudni új robotokat építeni. Meg vagyunk győződve róla, hogy elég találékony vagy ahhoz, hogy megoldást találj."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> lehetőséget biztosít arra, hogy bármikor újra megnézd ezeket az utasításokat a saját SatCom-odon <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:8
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Vezérlés</a> és <a cbot>CBOT Nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műhold Jelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Saari."
msgstr "Jelenleg geostacionárius pályán a Saari körül."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELÜLET<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      44.3C\n"
"\\tab;Atmosphere:       CO2, oxygen, nitrogen\n"
"\\tab;Wind:             2.3 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:     44.3C\n"
"\\tab;Atmoszféra:      CO2, oxigén, nitrogén\n"
"\\tab;Szél:            2.3 m/s\n"
"\\tab;Titanérc:        nincs\n"
"\\tab;Uranérc:         nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> Földalatti<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:   nincs\n"
"\\tab;Titanérc:        nincs\n"
"\\tab;Uránérc:        nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> További információk<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         reusable derelicts \n"
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       ?"
msgstr ""
"\\tab;Felfedezve:      újrahasznosítható roncsok \n"
"\\tab;Felfedezve:      óriás hangyák\n"
"\\tab;  - Veszély:     ?"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Játéksegédlet"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "You should build a <a object|radar>radar</a> first."
msgstr "Először egy <a object|radar>radart</a> kell építenie."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "The <a object|ant>ants</a> appear to be running away from you. Try to circle around each one of them until they find themselves trapped between you and a <a object|mine>mine</a>. They'll opt for the mine and blow themselves up."
msgstr ""

#. type: Plain text
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Then bring the <a object|bbox>black box</a> aboard your ship. It is next to the derelict spaceship."
msgstr "Ezután hozza a <a object|bbox>fekete dobozt</a> a hajóra. Az a roncs űrhajó mellett található."

#. type: Plain text
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Szabályok</a>"
