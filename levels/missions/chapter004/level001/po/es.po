#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía paso a paso"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Build a <a object|factory>bot factory</a>."
msgstr "Construye una <a object|factory>fábrica de bots</a>."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "Produce a <a object|botgj>winged grabber</a>."
msgstr "Produce un <a object|botgj>recogedor alado</a>."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Carry a <a object|titan>titanium cube</a> to the highest point."
msgstr "Lleva un <a object|titan>cubo de titanio</a> al punto más alto."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Build a <a object|radar>radar</a> on the spot."
msgstr "Construye un <a object|radar>radar</a> en el lugar."

#. type: Bullet: '5)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Build a <a object|research>research center</a> next to the spaceship."
msgstr "Construye un <a object|research>centro de investigación</a> junto a la nave espacial."

#. type: Bullet: '6)'
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "Initiate the <defense tower research program> <button 68/>."
msgstr "Inicia el <defense tower research program>programa de investigación de torre de defensa</button 68/>."

#. type: Bullet: '7)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "Build the <a object|tower>defense tower</a> next to the radar."
msgstr "Construye la <a object|tower>torre de defensa</a> junto al radar."

#. type: Bullet: '8)'
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "When all the worms are destroyed, you can go back to your ship and take off."
msgstr "Cuando todos los gusanos sean destruidos, puedes volver a tu nave y despegar."

#. type: Plain text
#: ../help/soluce.E.txt:12
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"
