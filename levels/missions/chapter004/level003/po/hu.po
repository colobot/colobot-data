#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "System Failure"
msgstr "Rendszerhiba"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Pursue a rogue bot."
msgstr "Üldözz egy elszabadult robotot."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A küldetésirányításból"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "We have just received this warning from the observation satellite: a rogue bot from the previous expedition has seized the black box from your spaceship."
msgstr "Figyelmeztetést kaptunk a megfigyelő műholdtól: az előző expedíció egyik elszabadult robotja megszerezte az űrhajód feketedobozát."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "We are going to investigate this incident further but it is of vital importance that you retrieve your black box at once."
msgstr "Tovább vizsgáljuk az esetet, de rendkívül fontos, hogy azonnal visszaszerezd a feketedobozt."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "A <format key><key help/></format> segítségével bármikor újra megtekintheted ezeket az utasításokat a saját SatCom-odon <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:6
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Irányítás</a> és <a cbot>CBOT nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Crystalium."
msgstr "Jelenleg geostacionárius pályán kering a Crystalium körül."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELSZÍN<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      4.3C\n"
"\\tab;Atmosphere:       nitrogen\n"
"\\tab;Wind:             0.0 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:      4.3°C\n"
"\\tab;Légkör:           nitrogén\n"
"\\tab;Szél:             0.0 m/s\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> Altalaj<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:    nincs\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> További információk<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       not immediate\n"
"\\tab;Detected:         unknown organisms\n"
"\\tab;  - Danger:       ?"
msgstr ""
"\\tab;Észlelve:         óriáshangyák\n"
"\\tab;  - Veszély:      nem azonnali\n"
"\\tab;Észlelve:         ismeretlen élőlények\n"
"\\tab;  - Veszély:      ?"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "If you lose the bot, it will drop the black box somewhere southwest of your spaceship on a region surrounded by crystals."
msgstr "Ha elveszíted a robotot, a fekete dobozt valahol a űrhajód délnyugati részén, kristályokkal körülvett területen ejti le."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "In case your power runs out before you can bring the black box back, use the second grabber left on the spaceship."
msgstr "Ha kifogysz az energiából, mielőtt visszavinnéd a fekete dobozt, használd a második fogót, ami az űrhajón maradt."

#. type: Plain text
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"
