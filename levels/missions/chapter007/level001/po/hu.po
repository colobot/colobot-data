#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Cloning"
msgstr "Klónozás"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Reproduce the technology to manufacture an orga shooter yourself."
msgstr "Próbáld meg előállítani a technológiát, hogy saját orga lőfegyvert készíthess."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A Küldetésirányítástól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Find some more <a object|bullet>organic matter</a> and, given an appropriate research program performed by your <a object|labo>autolab</a>, <a object|human>you</a> should be able to manufacture orga shooters yourself."
msgstr "Találj még néhány <a object|bullet>szerves anyagot</a>, és megfelelő kutatási programot indítva a <a object|labo>laborodban</a>, <a object|human>készíthetsz</a> magadnak orga lőfegyvereket."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Produce a <a object|botos>legged orga shooter</a> and bring it back aboard your <a object|base>spaceship</a>."
msgstr "Készíts egy <a object|botos>lábas orga lőfegyvert</a>, és hozd vissza a <a object|base>űrhajódra</a>."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "Please keep in mind that low energy resources are a major concern on this planet."
msgstr "Ne feledd, hogy ezen a bolygón alacsony az energiaforrások mennyisége."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> lehetőséget ad arra, hogy bármikor megnézhesd ezeket az utasításokat a személyes SatCom <button 63/> eszközödön."

#. type: \t; header
#: ../help/help.E.txt:10 ../help/soluce.E.txt:19
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Vezérlés</a> és <a cbot>CBOT Nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Centaury."
msgstr "Jelenleg geostacionárius pályán van a Centaury körül."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELÜLET<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      23.4C\n"
"\\tab;Atmosphere:       oxygen, nitrogen, ammonia\n"
"\\tab;Wind:             1.2 mps\n"
"\\tab;Titanium ore:     some\n"
"\\tab;Uranium ore:      some"
msgstr ""
"\\tab;Hőmérséklet:     23.4C\n"
"\\tab;Légkör:          oxigén, nitrogén, ammónia\n"
"\\tab;Szél:            1.2 m/s\n"
"\\tab;Titanit érce:   néhány\n"
"\\tab;Uránérc:        néhány"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> Felszín alatti<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:  nincs\n"
"\\tab;Titánérc:       nincs\n"
"\\tab;Uránérc:       nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> További információk<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       not immediate\n"
"\\tab;Detected:         reusable derelicts"
msgstr ""
"\\tab;Felfedezve:      óriás hangyák\n"
"\\tab;  - Veszély:     nem közvetlen\n"
"\\tab;Felfedezve:      újrahasználható roncsok"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Játék végigjátszása"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "You'll find some useful items in a small valley northeast."
msgstr "Hasznos tárgyakat találsz egy kis völgyben északkeleten."

#. type: Bullet: 'o'
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "A <a object|botrecy>recycler</a> that will allow you to make your first <a object|titan>titanium cube</a>."
msgstr "Egy <a object|botrecy>újrahasznosítót</a>, amivel elkészítheted az első <a object|titan>titán kockát</a>."

#. type: Bullet: 'o'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "A <a object|botgs>legged grabber</a> that is very good at climbing steep slopes."
msgstr "Egy <a object|botgs>lábas emelő</a>, ami nagyon jól mászik meredek lejtőkön."

#. type: Bullet: 'o'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "A nearly charged <a object|atomic>nuclear power cell</a>."
msgstr "Egy majdnem feltöltött <a object|atomic>atomenergia cella</a>."

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "Power the <a object|botgs>legged grabber</a> with the <a object|atomic>nuclear power cell</a>, and use it to carry a <a object|titan>titanium cube</a> to the <a object|base>spaceship</a>. Choose the direct way over the mountains."
msgstr "Töltsd fel a <a object|botgs>lábas emelőt</a> a <a object|atomic>atomenergia cellával</a>, és használd, hogy egy <a object|titan>titán kockát</a> szállíts a <a object|base>űrhajóhoz</a>. Válaszd a közvetlen utat a hegyeken keresztül."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "Use the titanium to build a <a object|convert>converter</a>. Execute the program <code>CollectTitanium3</code> on the <a object|botgs>legged grabber</a> and you will have plenty of titanium."
msgstr "Használd a titánt egy <a object|convert>konverter</a> építésére. Futtasd a <code>CollectTitanium3</code> programot a <a object|botgs>lábas emelőn</a>, és lesz elég titánod."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:11
#, no-wrap
msgid "Stop the program, and use the grabber to collect some <a object|uranore>uranium ore</a> in a second small valley to the east. Again, do not take the way of the valley which is crawling with ants, but take the direct way over the mountains."
msgstr "Állítsd le a programot, és használd az emelőt, hogy összegyűjts néhány <a object|uranore>uránércet</a> egy második kis völgyben keleten. Ismét, ne válaszd a hangyákkal teli völgyet, hanem a közvetlen utat a hegyeken."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:13
#, no-wrap
msgid "Build a <a object|botfj>winged shooter</a> and power it with a <a object|atomic>nuclear power cell</a>. If you take the pass south-east, you will arrive immediately at the ant nest. Kill all the ants, and bring back a ball of <a object|bullet>organic matter</a> to the <a object|base>spaceship</a>."
msgstr "Építs egy <a object|botfj>szárnyas lövőt</a>, és töltsd fel egy <a object|atomic>atomenergia cellával</a>. Ha délkelet felé veszed az irányt, rögtön elérsz a hangyafészekhez. Öld meg az összes hangyát, és hozd vissza egy golyónyi <a object|bullet>organikus anyagot</a> a <a object|base>űrhajóhoz</a>."

#. type: Bullet: '5)'
#: ../help/soluce.E.txt:15
#, no-wrap
msgid "Build an <a object|labo>auto-lab</a>, drop the <a object|bullet>organic matter</a> on the platform and click the <button 110/> button in order to develop the blueprints for the orgaShooter cannon."
msgstr "Építs egy <a object|labo>autolab</a>-ot, tedd az <a object|bullet>organikus anyagot</a> a platformra, és kattints a <button 110/> gombra, hogy kifejleszd az orgaShooter ágyú terveit."

#. type: Bullet: '6)'
#: ../help/soluce.E.txt:17
#, no-wrap
msgid "Build a <a object|botos>legged orga shooter</a>, bring it aboard and take off."
msgstr "Építs egy <a object|botos>lábas orga lövőt</a>, hozd fel a fedélzetre és emelkedj fel."

#. type: Plain text
#: ../help/soluce.E.txt:20
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Vezérlés</a>"
