#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Search the area for <a object|titan>titanium</a>."
msgstr "Busca en el área <a object|titan>titanio</a>."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "Build a <a object|convert>converter</a>."
msgstr "Construye un <a object|convert>convertidor</a>."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Build a <a object|research>research center</a>."
msgstr "Construye un <a object|research>centro de investigación</a>."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Run the <thumper research program> <button 66/>."
msgstr "Ejecuta el <programa de investigación thumper> <button 66/>."

#. type: Bullet: '5)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Manufacture a <a object|bottump>thumper</a>."
msgstr "Fabrica un <a object|bottump>thumper</a>."

#. type: Bullet: '6)'
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "Position the thumper close to the derelict spaceship and \"thump\" the ground."
msgstr "Posiciona el thumper cerca de la nave espacial derelict y \"golpea\" el suelo."

#. type: Bullet: '7)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "Quickly retrieve the <a object|bbox>black box</a> and bring it back aboard your <a object|base>spaceship</a>."
msgstr "Recupera rápidamente la <a object|bbox>caja negra</a> y llévala de vuelta a bordo de tu <a object|base>nave espacial</a>."

#. type: Bullet: '8)'
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "Bring the thumper along and take off."
msgstr "Llévate el thumper y despega."

