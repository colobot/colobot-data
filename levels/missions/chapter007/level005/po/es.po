#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Self-defense"
msgstr "Autodefensa"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Combine defensive and offensive weapons to deal with a massive attack."
msgstr "Combina armas defensivas y ofensivas para enfrentar un ataque masivo."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "You're under attack and this is no time for compassion..."
msgstr "Estás bajo ataque y este no es momento para la compasión..."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Your new <a object|bottump>thumper</a> might come in very handy. However, we emphasize that you should not risk a takeoff if there are any ants still alive in the vicinity of the spaceship."
msgstr "Tu nuevo <a object|bottump>thumper</a> podría resultar muy útil. Sin embargo, enfatizamos que no debes arriesgar un despegue si hay alguna hormiga todavía viva en las cercanías de la nave espacial."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:7
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Informe del Satélite"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Centaury."
msgstr "Actualmente en órbita geoestacionaria de Centaury."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> SUPERFICIE<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      21.3C\n"
"\\tab;Atmosphere:       oxygen, nitrogen, ammonia\n"
"\\tab;Wind:             1.9 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Temperatura:      21.3C\n"
"\\tab;Atmósfera:        oxígeno, nitrógeno, amoníaco\n"
"\\tab;Viento:           1.9 mps\n"
"\\tab;Mineral titanio:  ninguno\n"
"\\tab;Mineral uranio:   ninguno"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SUBSUELO<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fuente energía:   ninguna\n"
"\\tab;Mineral titanio:  ninguno\n"
"\\tab;Mineral uranio:   ninguno"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> INFORMACIÓN ADICIONAL<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       immediate"
msgstr ""
"\\tab;Detectado:        hormigas gigantes\n"
"\\tab;  - Peligro:      inmediato"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Thump the deck of the <a object|base>spaceship</a>. You don't need to move the <a object|bottump>thumper</a> anywhere."
msgstr "Golpea la cubierta de la <a object|base>nave espacial</a>. No necesitas mover el <a object|bottump>thumper</a> a ningún lugar."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "Locate the <a object|botoj>orga shooter</a> approximately 70 meters to the east."
msgstr "Localiza el <a object|botoj>disparador de orgánica</a> aproximadamente 70 metros al este."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Terminate the <a object|ant>ants</a> while they are still on their backs."
msgstr "Termina con las <a object|ant>hormigas</a> mientras todavía están boca arriba."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Take off."
msgstr "Despega."

#. type: Plain text
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"
