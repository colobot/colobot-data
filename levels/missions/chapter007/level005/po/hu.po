#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Self-defense"
msgstr "Önvédelem"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Combine defensive and offensive weapons to deal with a massive attack."
msgstr "Kombináld a védekező és támadó fegyvereket, hogy kivédd a hatalmas támadást."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A Küldetésirányítástól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "You're under attack and this is no time for compassion..."
msgstr "Támadás alatt állsz, ez most nem a könyörület ideje..."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Your new <a object|bottump>thumper</a> might come in very handy. However, we emphasize that you should not risk a takeoff if there are any ants still alive in the vicinity of the spaceship."
msgstr "Az új <a object|bottump>csapódód</a> nagyon hasznos lehet. Viszont hangsúlyozzuk, hogy ne kockáztasd a felszállást, ha még élő hangyák vannak az űrhajó közelében."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "A <format key><key help/></format> segítségével bármikor újra megtekintheted ezeket az utasításokat a személyes SatCom <button 63/> eszközödön."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:7
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Vezérlés</a> és <a cbot>CBOT nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Centaury."
msgstr "Jelenleg geostacionárius pályán kering a Centaury körül."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELSZÍN<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      21.3C\n"
"\\tab;Atmosphere:       oxygen, nitrogen, ammonia\n"
"\\tab;Wind:             1.9 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:     21.3°C\n"
"\\tab;Légkör:          oxigén, nitrogén, ammónia\n"
"\\tab;Szél:            1.9 m/s\n"
"\\tab;Titánérc:        nincs\n"
"\\tab;Uránérc:         nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> ALTALAJ<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:    nincs\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> TOVÁBBI INFORMÁCIÓK<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       immediate"
msgstr ""
"\\tab;Észlelve:         óriás hangyák\n"
"\\tab;  - Veszély:      azonnali"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Thump the deck of the <a object|base>spaceship</a>. You don't need to move the <a object|bottump>thumper</a> anywhere."
msgstr "Dübögtesd meg a <a object|base>űrhajó</a> fedélzetét. Nem szükséges a <a object|bottump>dübögtetőt</a> máshová mozgatni."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "Locate the <a object|botoj>orga shooter</a> approximately 70 meters to the east."
msgstr "Keresd meg az <a object|botoj>orga lövőt</a> körülbelül 70 méterre keletre."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Terminate the <a object|ant>ants</a> while they are still on their backs."
msgstr "Semmisítsd meg a <a object|ant>hangyákat</a>, amíg a hátukon fekszenek."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Take off."
msgstr "Indulj el."

#. type: Plain text
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"
