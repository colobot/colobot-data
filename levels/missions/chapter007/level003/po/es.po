#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Guía Paso a Paso"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "In order to kill all ants and spiders in this large and mountainous region, you will need a <a object|botfj>winged orga shooter</a> powered with <a object|atomic>nuclear power cells</a>. In a small valley to the southeast you will find everything you need: <a object|titan>titanium cubes</a>, <a object|power>power cells</a> and even a <a object|botgj>winged grabber</a> in working condition."
msgstr "Para matar a todas las hormigas y arañas en esta región grande y montañosa, necesitarás un <a object|botfj>disparador de orgánica alado</a> equipado con <a object|atomic>celdas de energía nuclear</a>. En un pequeño valle al sudeste encontrarás todo lo que necesitas: <a object|titan>cubos de titanio</a>, <a object|power>celdas de energía</a> e incluso un <a object|botgj>recogedor alado</a> en condiciones de funcionamiento."

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Build a <a object|radar>radar</a> and a <a object|botfj>winged shooter</a> and power it. Kill the ant that is watching over the <a object|uranore>uranium ore</a> further north."
msgstr "Construye un <a object|radar>radar</a> y un <a object|botfj>disparador alado</a> y equípalo. Mata a la hormiga que vigila el <a object|uranore>mineral de uranio</a> más al norte."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Use the abandoned <a object|nuclear>nuclear plant</a> on the hill above and the <a object|botgj>winged grabber</a> to produce several <a object|atomic>nuclear power cells</a>, and use one to power the <a object|botfj>winged shooter</a>."
msgstr "Usa la <a object|nuclear>planta nuclear</a> abandonada en la colina arriba y el <a object|botgj>recogedor alado</a> para producir varias <a object|atomic>celdas de energía nuclear</a>, y usa una para equipar el <a object|botfj>disparador alado</a>."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "Wipe out all insects from the region. There is one isolated ant in the northwest hidden in a hole: an approach from the west thorough the deep valley will make it easier to hit."
msgstr "Extermina todos los insectos de la región. Hay una hormiga aislada en el noroeste escondida en un agujero: un acercamiento desde el oeste a través del valle profundo facilitará golpearla."

#. type: Plain text
#: ../help/soluce.E.txt:11
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Controles</a>"
