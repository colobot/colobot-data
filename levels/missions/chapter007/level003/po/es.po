#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Cleansing"
msgstr "Limpieza"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Find the resources you need to eradicate all life in the region."
msgstr "Encuentra los recursos que necesitas para erradicar toda vida en la región."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Build a <a object|radar>radar</a> on one of the highest accessible spots and make sure that no organism can destroy it after <a object|human>you</a>'re gone."
msgstr "Construye un <a object|radar>radar</a> en uno de los puntos más altos accesibles y asegúrate de que ningún organismo pueda destruirlo después de que <a object|human>tú</a> te hayas ido."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "The destruction of a previous radar set up by the first expedition was probably the cause of a communication breakdown, which led to complete loss of contact."
msgstr "La destrucción de un radar anterior instalado por la primera expedición fue probablemente la causa de una interrupción de las comunicaciones, que llevó a la pérdida total de contacto."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

