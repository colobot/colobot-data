"\\tab;Atmosphere:       oxygen, nitrogen, ammonia\n"
"\\tab;Wind:             0.7 mps\n"
"\\tab;Titanium ore:     some\n"
"\\tab;Uranium ore:      some"
msgstr ""
"\\tab;Hőmérséklet:     25.4C\n"
"\\tab;Légkör:          oxigén, nitrogén, ammónia\n"
"\\tab;Szél:            0.7 m/s\n"
"\\tab;Titánérc:        kevés\n"
"\\tab;Uránérc:         kevés"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> ALTALAJ<c/>"

#. type: Plain text
