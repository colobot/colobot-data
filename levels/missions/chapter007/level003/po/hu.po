#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Cleansing"
msgstr "Tisztogatás"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Find the resources you need to eradicate all life in the region."
msgstr "Találd meg azokat az erőforrásokat, amelyekkel kiirthatsz minden életet a térségben."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A Küldetésirányítástól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Build a <a object|radar>radar</a> on one of the highest accessible spots and make sure that no organism can destroy it after <a object|human>you</a>'re gone."
msgstr "Építs egy <a object|radar>radart</a> az egyik legmagasabb elérhető pontra, és gondoskodj róla, hogy semmilyen élőlény ne tudja elpusztítani, miután <a object|human>elhagytad</a> a területet."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "The destruction of a previous radar set up by the first expedition was probably the cause of a communication breakdown, which led to complete loss of contact."
msgstr "Az első expedíció által felállított radar megsemmisülése valószínűleg kommunikációs zavarhoz vezetett, ami a kapcsolat teljes elvesztését okozta."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "A <format key><key help/></format> billentyűvel bármikor újra megtekintheted ezeket az utasításokat a saját SatCom <button 63/> eszközödön."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:10
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Vezérlés</a> és <a cbot>CBOT nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Centaury."
msgstr "Jelenleg geostacionárius pályán kering a Centaury körül."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELSZÍN<c/>"

