#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Target Practice"
msgstr "Céllövészet"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Practise shooting with your new orgaball canon."
msgstr "Gyakorold a lövést az új orgaball ágyúddal."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A küldetésirányítástól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "It is time for <a object|human>you</a> to improve your shooting skills again. In the following drill, hit all the <a object|tnt>explosive devices</a> but watch out: your <a object|botoj>orga shooter</a> has very little power left in it, barely enough to complete the drill."
msgstr "Itt az idő, hogy <a object|human>te</a> újra fejleszd a lövéskészségedet. A következő gyakorlatban találd el az összes <a object|tnt>robbanószert</a>, de vigyázz: a <a object|botoj>orga lövődben</a> alig maradt energia – éppen csak elegendő a feladat teljesítéséhez."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "A <format key><key help/></format> segítségével bármikor újra megtekintheted ezeket az utasításokat a saját SatCom készülékeden <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:6 ../help/soluce.E.txt:4
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Irányítás</a> és <a cbot>CBOT nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Centaury."
msgstr "Jelenleg geostacionárius pályán a Centaury körül."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELSZÍN<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      25.4C\n"
"\\tab;Atmosphere:       oxygen, nitrogen, ammonia\n"
"\\tab;Wind:             1.2 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:     25.4C\n"
"\\tab;Légkör:          oxigén, nitrogén, ammónia\n"
"\\tab;Szél:            1.2 m/s\n"
"\\tab;Titánérc:        nincs\n"
"\\tab;Uránérc:         nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> ALTALAJ<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:    nincs\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Drive the <a object|botos>legged orga shooter</a> to each of the pads in front of the targets, and hit all targets that you see with only one burst, moving the mouse during the burst. With 4 bursts, you must be able to hit all the targets."
msgstr "Vezesd a <a object|botos>lábakon járó orga lövőt</a> mindegyik cél előtti padra, és próbáld egyetlen sorozattal eltalálni az összes látható célt, miközben a sorozat közben mozgatod az egeret. Négy sorozatból el kell találnod az összes célt."

#. type: Plain text
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Irányítás</a>"
