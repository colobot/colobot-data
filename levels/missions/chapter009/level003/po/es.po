#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Gold Digger"
msgstr "Buscador de Oro"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Be prepared to dig for buried treasure."
msgstr "Prepárate para cavar en busca del tesoro enterrado."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "The third <a object|key>key</a> (C) is buried in a mushroom-infested area. A <a object|botss>sniffer</a> should be able to locate it and a <a object|derrick>derrick</a> should be able to extract it."
msgstr "La tercera <a object|key>llave</a> (C) está enterrada en un área Infestada de hongos. Un <a object|botss>sniffer</a> debería poder localizarla y una <a object|derrick>torre de perforación</a> debería poder extraerla."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "When your mission is completed and before taking off, bring both <a object|botshld>shielder</a> and <a object|botsub>subber</a> aboard your spaceship."
msgstr "Cuando tu misión esté completa y antes de despegar, bring both <a object|botshld>shielder</a> and <a object|botsub>subber</a> aboard your spaceship."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:5
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

