#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Poison Hail"
msgstr "Granizo Venenoso"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Retrieve the second key using only defensive strategies."
msgstr "Recupera la segunda llave usando solo estrategias defensivas."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Retrieve the second <a object|key>key</a> (B). It should be located near your current position."
msgstr "Recupera la segunda <a object|key>llave</a> (B). Debería estar ubicada cerca de tu posición actual."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "When your mission is completed and before taking off, bring both <a object|botshld>shielder</a> and <a object|botsub>subber</a> aboard your spaceship."
msgstr "Cuando tu misión esté completa y antes de despegar, bring both <a object|botshld>shielder</a> and <a object|botsub>subber</a> aboard your spaceship."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:5
#, no-wrap
