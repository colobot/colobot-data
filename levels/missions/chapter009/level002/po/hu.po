#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Poison Hail"
msgstr "Mérgező jégeső"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Retrieve the second key using only defensive strategies."
msgstr "Szerezd meg a második kulcsot kizárólag védekező stratégiával."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "A küldetésirányítástól"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Retrieve the second <a object|key>key</a> (B). It should be located near your current position."
msgstr "Szerezd meg a második <a object|key>kulcsot</a> (B). Valószínűleg a közeledben található."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "When your mission is completed and before taking off, bring both <a object|botshld>shielder</a> and <a object|botsub>subber</a> aboard your spaceship."
msgstr "Miután a küldetést teljesítetted, és mielőtt felszállnál, vidd a <a object|botshld>védőrobotot</a> és a <a object|botsub>alámerülőt</a> a hajódra."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "A <format key><key help/></format> segítségével bármikor újra megnézheted ezeket az utasításokat a személyes SatCom <button 63/> eszközödön."

#. type: \t; header
#: ../help/help.E.txt:8 ../help/soluce.E.txt:5
#, no-wrap
msgid "See also"
msgstr "Lásd még"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Irányítás</a> és <a cbot>CBOT nyelv</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Műholdjelentés"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Terranova."
msgstr "Jelenleg geostacionárius pályán Terranova körül."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> FELSZÍN<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      24.3C\n"
"\\tab;Atmosphere:       oxygen\n"
"\\tab;Wind:             0.8 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Hőmérséklet:      24,3°C\n"
"\\tab;Légkör:           oxigén\n"
"\\tab;Szél:             0,8 m/s\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> ALTALAJ<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Energiaforrás:    nincs\n"
"\\tab;Titánérc:         nincs\n"
"\\tab;Uránérc:          nincs"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> TOVÁBBI INFORMÁCIÓK<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       immediate"
msgstr ""
"\\tab;Észlelve:         óriás hangyák\n"
"\\tab;  - Veszély:      azonnali"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Végigjátszás"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid ""
"Unfortunately no walkthrough has been provided for this mission.\n"
"You are on your own..."
msgstr ""
"Sajnos ehhez a küldetéshez nem áll rendelkezésre végigjátszás.\n"
"Egyedül kell boldogulnod..."

