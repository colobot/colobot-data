"\\tab;Temperature:      24.8C\n"
"\\tab;Atmosphere:       oxygen\n"
"\\tab;Wind:             0.7 mps\n"
"\\tab;Titanium ore:     underwater\n"
"\\tab;Uranium ore:      none"
msgstr ""
