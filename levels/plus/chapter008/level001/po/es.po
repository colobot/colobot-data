#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     some (blue flag)\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fuente de energía:    ninguna\n"
"\\tab;Mineral de titanio:     algo (bandera azul)\n"
"\\tab;Mineral de uranio:      ninguno"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
