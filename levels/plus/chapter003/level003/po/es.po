#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Desde Control de Misión"

#. type: \t; header
#: ../help/help.E.txt:8
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Black Box"
msgstr "Caja Negra"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Explore the underwater world looking for another black box."
msgstr "Explora el mundo submarino buscando otra caja negra."

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Locate and retrieve another <a object|bbox>black box</a> from the previous expedition."
msgstr "Localiza y recupera otra <a object|bbox>caja negra</a> de la expedición anterior."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "The observation satellite seems to have spotted it underwater. Water is harmless to you as long as you wear your helmet but keep in mind that you can't carry objects underwater. A <a object|botsub>subber</a> may come in handy."
msgstr "El satélite de observación parece haberla detectado bajo el agua. El agua es inofensiva para ti mientras lleves puesto tu casco, pero ten en cuenta que no puedes cargar objetos bajo el agua. Un <a object|botsub>submarino</a> puede resultar útil."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Informe del Satélite"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Tropica."
msgstr "Actualmente en órbita geoestacionaria de Tropica."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> SUPERFICIE<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      29.4C\n"
"\\tab;Atmosphere:       helium, oxygen\n"
"\\tab;Wind:             0.3 mps\n"
"\\tab;Titanium ore:     some\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Temperatura:      29.4C\n"
"\\tab;Atmósfera:        helio, oxígeno\n"
"\\tab;Viento:           0.3 mps\n"
"\\tab;Mineral de titanio: algo\n"
"\\tab;Mineral de uranio: ninguno"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SUBSUELO<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fuente de energía: ninguna\n"
"\\tab;Mineral de titanio: ninguno\n"
"\\tab;Mineral de uranio: ninguno"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> INFORMACIÓN ADICIONAL<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         titanium ore\n"
"\\tab;  - Requires:     converter\n"
"\\tab;Detected:         scattered derelicts\n"
"\\tab;Detected:         black box (underwater)"
msgstr ""
"\\tab;Detectado:         mineral de titanio\n"
"\\tab;  - Requiere:     convertidor\n"
"\\tab;Detectado:         restos dispersos\n"
"\\tab;Detectado:         caja negra (bajo el agua)"
