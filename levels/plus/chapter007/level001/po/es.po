#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: \t; header
#: ../help/help.E.txt:10
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Cloning"
msgstr "Clonación"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Reproduce the technology to manufacture an orga shooter yourself."
msgstr "Reproduce la tecnología para fabricar un lanzador orgánico tú mismo."

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Find some more <a object|bullet>organic matter</a> and, given an appropriate research program performed by your <a object|labo>autolab</a>, <a object|human>you</a> should be able to manufacture orga shooters yourself."
msgstr "Encuentra más <a object|bullet>materia orgánica</a> y, dado un programa de investigación apropiado realizado por tu <a object|labo>autolaboratorio</a>, <a object|human>tú</a> deberías poder fabricar lanzadores orgánicos tú mismo."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Produce a <a object|botos>legged orga shooter</a> and bring it back aboard your <a object|base>spaceship</a>."
msgstr "Produce un <a object|botos>lanzador orgánico con patas</a> y tráelo de vuelta a tu <a object|base>nave espacial</a>."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "Please keep in mind that low energy resources are a major concern on this planet."
msgstr "Por favor ten en cuenta que los recursos energéticos escasos son una preocupación mayor en este planeta."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

