#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Target Practice"
msgstr "Práctica de Tiro"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Practise shooting with your new orgaball canon."
msgstr "Practica disparando con tu nuevo cañón de orga."

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "It is time for <a object|human>you</a> to improve your shooting skills again. In the following drill, hit all the <a object|tnt>explosive devices</a> but watch out: your <a object|botoj>orga shooter</a> has very little power left in it, barely enough to complete the drill."
msgstr "Es hora de que <a object|human>tú</a> mejores tus habilidades de tiro nuevamente. En el siguiente ejercicio, golpea todos los <a object|tnt>dispositivos explosivos</a> pero ten cuidado: tu <a object|botoj>disparador de orga</a> tiene muy poca energía restante, apenas suficiente para completar el ejercicio."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

