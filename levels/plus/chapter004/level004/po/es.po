#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: \t; header
#: ../help/help.E.txt:10
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "The Lost Valley"
msgstr "El Valle Perdido"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Explore a foggy and perilous valley."
msgstr "Explora un valle brumoso y peligroso."

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This planet has turned out to be a very unlikely candidate for colonization. Better to leave it for good. Retrieve the <a object|bbox>black box</a> from the previous expedition and head towards the next planet."
msgstr "Este planeta ha resultado ser un candidato muy poco probable para la colonización. Mejor dejarlo definitivamente. Recupera la <a object|bbox>caja negra</a> de la expedición anterior y dirígete hacia el siguiente planeta."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "The observation satellite has indicated that its present location is at the bottom of a valley. However the pervasive stratum of electromagnetic smog could make all satellite information rather undependable."
msgstr "El satélite de observación ha indicado que su ubicación actual está al fondo de un valle. Sin embargo, la capa generalizada de smog electromagnético podría hacer que toda la información del satélite sea bastante poco confiable."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "Stay alert."
msgstr "Permanece alerta."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

