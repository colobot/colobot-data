#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Time for a sharp exit"
msgstr "Hora de una salida rápida"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Try to leave the planet alive."
msgstr "Intenta abandonar el planeta con vida."

