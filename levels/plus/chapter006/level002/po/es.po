#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Del Control de Misiones"

#. type: \t; header
#: ../help/help.E.txt:10
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Reverse Engineering"
msgstr "Ingeniería Inversa"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Ruin a ruin."
msgstr "Arruina una ruina."

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "We have determined that the best spot to build a <a object|radar>radar</a> on this planet is located on the highest mountain in this region. Unfortunately it is already occupied by a <a object|ruin>ruined radar</a>."
msgstr "Hemos determinado que el mejor lugar para construir un <a object|radar>radar</a> en este planeta está ubicado en la montaña más alta de esta región. Desafortunadamente ya está ocupado por un <a object|ruin>radar en ruinas</a>."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "Build an <a object|labo>autolab</a> and use it to analyze the <a object|tnt>explosive device</a> you acquired, this will allow your <a object|factory>bot factory</a> to replicate the <a object|bottarg>target bot</a> designed by the previous expedition."
msgstr "Construye un <a object|labo>autolaboratorio</a> y úsalo para analizar el <a object|tnt>dispositivo explosivo</a> que adquiriste, esto permitirá a tu <a object|factory>fábrica de bots</a> replicar el <a object|bottarg>bot objetivo</a> diseñado por la expedición anterior."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid "Use the target bot to dispose of the ruin and build a new radar in its place."
msgstr "Utiliza el bot objetivo para eliminar la ruina y construir un nuevo radar en su lugar."

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "<format key><key help/></format> allows you to review these instructions at all times on your personal SatCom <button 63/>."
msgstr "<format key><key help/></format> te permite revisar estas instrucciones en todo momento en tu SatCom personal <button 63/>."

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Controles</a> y <a cbot>Lenguaje CBOT</a>"

