#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "BaseBuilding"
msgstr "Bázisépítés"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Build your base and eliminate your foe!"
msgstr "Építsd meg az alapodat, és semmisítsd meg az ellenségedet!"

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Code Battle (vs Player)"
msgstr "Kódcsata (a játékos ellen)"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This is <a battles>a code battle</a> level, where you fight against an other program, presumably written by some other player."
msgstr "Ez egy <a battles>a kódcsata</a> szint, ahol egy másik program ellen küzdesz, amely valószínűleg egy másik játékos által írt."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Objective"
msgstr "Cél"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "Destroy the other team located on the opposite side of the river."
msgstr "Semmisítsd meg a másik csapatot, amely a folyó túloldalán található."

#. type: \b; header
#: ../help/help.E.txt:7
#, no-wrap
msgid "Notes\\m notes;"
msgstr "Megjegyzések\\m megjegyzések;"

#. type: Bullet: 'o'
#: ../help/help.E.txt:8
#, no-wrap
msgid "There is <a object/enerspot>an underground power source</a> only under the beginning base areas."
msgstr "Csak az alap területek alatt található <a object/enerspot>egy földalatti energiaforrás</a>."

#. type: Bullet: 'o'
#: ../help/help.E.txt:9
#, no-wrap
msgid "The pre-built <a object|derrick>Derricks</a> and <a |object\\radar>RadarStations</a> are indestructible."
msgstr "A készre épített <a object|derrick>Derrickek</a> és <a |object\\radar>Radarállomások</a> elpusztíthatatlanok."

#. type: Bullet: 'o'
#: ../help/help.E.txt:10
#, no-wrap
msgid "You can try to find a program to fight against in the International Colobot Community (<code>http://colobot.info</code>)."
msgstr "Próbálhatsz találni egy programot, akivel harcolhatsz a Nemzetközi Colobot Közösségben (<code>http://colobot.info</code>)."
