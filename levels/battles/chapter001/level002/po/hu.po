#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "ShootOut"
msgstr "Lövöldözés"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Challenge your friend in this simple 1v1 scenario. May the best WingedShooter win!"
msgstr "Kihívhatod a barátodat ebben az egyszerű 1v1 forgatókönyvben. A legjobb WingedShooter nyerjen!"

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Code Battle (shooting an other player)"
msgstr "Kód csata (egy másik játékos lelövéséhez)"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This is <a battles>a code battle</a> level, where you fight against an other program, presumably written by some other player, in order to improve your aim."
msgstr "Ez egy <a battles>kód csata</a> szint, ahol egy másik program ellen küzdesz, amit valószínűleg egy másik játékos írt, hogy fejleszd a célzási képességed."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Objective"
msgstr "Cél"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "Destroy the other <a object/botfj>Shooter</a> located on the opposite side of the river."
msgstr "Zúzd szét a másik <a object/botfj>Shooter</a>-t, ami a folyó túloldalán található."

#. type: \b; header
#: ../help/help.E.txt:7
#, no-wrap
msgid "Notes\\m notes;"
msgstr "Megjegyzések\\m megjegyzések;"

#. type: Bullet: 'o'
#: ../help/help.E.txt:8
#, no-wrap
msgid "You can try to find a program to fight against in the International Colobot Community (<code>http://colobot.info</code>)."
msgstr "Próbálhatsz találni egy programot, amivel küzdhetsz a Nemzetközi Colobot Közösségben (<code>http://colobot.info</code>)."
