#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "BaseBuilding"
msgstr "Bázisépítés"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Challenge the developers! Fight against a simple enemy program."
msgstr "Kihívás a fejlesztőknek! Harcolj egy egyszerű ellenséges program ellen."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Code Battle (vs Computer)"
msgstr "Kódcsata (számítógép ellen)"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This is <a battles>a code battle</a> level, where you fight against a simple program written by the developers of the game."
msgstr "Ez egy <a battles>a kódcsata</a> szint, ahol egy egyszerű program ellen harcolsz, amelyet a játék fejlesztői írtak."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Your objective"
msgstr "A célod"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "Destroy the red team located on the opposite side of the river."
msgstr "Semmisítsd meg a piros csapatot, amely a folyó túloldalán található."

#. type: \b; header
#: ../help/help.E.txt:7
#, no-wrap
msgid "Notes\\m notes;"
msgstr "Jegyzetek\\m jegyzetek;"

#. type: Bullet: 'o'
#: ../help/help.E.txt:8
#, no-wrap
msgid "There is <a object/enerspot>an underground power source</a> only under the beginning base areas."
msgstr "Csak a kezdő bázis területek alatt található <a object/enerspot>alattomos energiaforrás</a>."

#. type: Bullet: 'o'
#: ../help/help.E.txt:9
#, no-wrap
msgid "The pre-built <a object|derrick>Derricks</a> and <a |object\\radar>RadarStations</a> are indestructible."
msgstr "Az előre épített <a object|derrick>olajfúró tornyok</a> és <a |object\\radar>Radarállomások</a> nem megsemmisíthetők."
