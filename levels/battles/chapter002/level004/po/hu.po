#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "ShootOut"
msgstr "Lövöldözés"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Challenge the developers! Sharpen your CodeBattle skills."
msgstr "Kihívás a fejlesztőknek! Fejleszd a CodeBattle képességeidet."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Code Battle (shooting an other shooter)"
msgstr "Kódharc (másik lövöldöző lelövése)"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This is <a battles>a code battle</a> level, where you fight against a simple program for Shooter, written by the developers of the game, in order to improve your aim."
msgstr "Ez egy <a battles>kódharc</a> szint, ahol a játék fejlesztői által írt egyszerű lövöldöző programmal harcolsz, hogy fejleszd a célzási képességed."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Objective"
msgstr "Cél"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "Destroy the other <a object/botfj>Shooter</a> located on the opposite side of the river."
msgstr "Zúzd szét a másik <a object/botfj>Lövöldözőt</a>, amely a folyó túlsó oldalán található."
