#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "ShootOut"
msgstr "Duelo de Tiros"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Challenge the developers! Sharpen your CodeBattle skills."
msgstr "¡Desafía a los desarrolladores! Afina tus habilidades de CodeBattle."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Code Battle (shooting an other shooter)"
msgstr "Batalla de Código (disparando a otro Shooter)"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This is <a battles>a code battle</a> level, where you fight against a simple program for Shooter, written by the developers of the game, in order to improve your aim."
msgstr "Este es un nivel de <a battles>batalla de código</a>, donde fightes contra un simple programa de Shooter, escrito por los desarrolladores del juego, para mejorar tu puntería."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Objective"
msgstr "Objetivo"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "Destroy the other <a object/botfj>Shooter</a> located on the opposite side of the river."
msgstr "Destruye al otro <a object/botfj>Shooter</a> ubicado en el lado opuesto del río."
