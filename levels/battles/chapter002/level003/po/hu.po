#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "ShootingRange"
msgstr "Lövöldöző pálya"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Aim & shoot - simple as that!"
msgstr "Célzódj és lőj - ennyire egyszerű!"

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Code Battle (shooting a target)"
msgstr "Kódcsata (célpont lőése)"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "This is <a battles>a code battle</a> level, where you need to shoot a harmless target, in order to learn how to aim properly."
msgstr "Ez egy <a battles>a kódcsata</a> szint, ahol egy ártalmatlan célpontot kell eltalálnod, hogy megtanulj helyesen célozni."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Objective"
msgstr "Cél"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "Destroy the target located on the opposite side of the river."
msgstr "Törd össze a célt, amely a folyó túloldalán található."
