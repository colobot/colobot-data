#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Exercise"
msgstr "Ejercicio"

#. type: \t; header
#: ../help/help.E.txt:6
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<a cbot>Programación</a>, <a cbot|type>tipos</a> y <a cbot|category>categorías</a>."

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Radar and traps 2"
msgstr "Radar y trampas 2"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Try to figure out how to survive in a hostile environment."
msgstr "Intenta encontrar cómo sobrevivir en un entorno hostil."

#. type: ScriptName-text
#: ../scene.txt:3
#, no-wrap
msgid "Traps"
msgstr "Trampas"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Instruct your <a object|bottr>bot</a> to find all the <a object|waypoint>blue crosses</a> on the ground, but do not get too close to the <a object|mine>mines</a>."
msgstr "Instruye a tu <a object|bottr>bot</a> para que encuentre todas las <a object|waypoint>cruces azules</a> en el suelo, pero no te acerques demasiado a las <a object|mine>minas</a>."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid "If a bot gets within less than 2m of the center of a mine (which is the position returned by the radar instruction), il will blow up. However, you must take into account the inertia of the bot. Probably a safety distance of 3 to 3.5m would be more appropriate."
msgstr "Si un bot se acerca a menos de 2m del centro de una mina (que es la posición devuelta por la instrucción radar), explotará. Sin embargo, debes tener en cuenta la inercia del bot. Probablemente una distancia de seguridad de 3 a 3.5m sería más apropiada."
