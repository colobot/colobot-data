#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Exercise"
msgstr "Ejercicio"

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Useful instructions"
msgstr "Instrucciones útiles"

#. type: \t; header
#: ../help/help.E.txt:13
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:14
#, no-wrap
msgid "<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<a cbot>Programación</a>, <a cbot|type>tipos</a> y <a cbot|category>categorías</a>."

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Crazy bot 2"
msgstr "Bot loco 2"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Use the radar to put some order into a big mess left behind by a crazy bot."
msgstr "Usa el radar para poner orden en el gran desorden dejado por un bot loco."

#. type: ScriptName-text
#: ../scene.txt:3
#, no-wrap
msgid "Radar"
msgstr "Radar"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "In this exercise, a \"crazy bot\" places many <a object|waypoint>blue crosses</a> on the ground. Just try to find them all."
msgstr "En este ejercicio, un \"bot loco\" coloca muchas <a object|waypoint>cruces azules</a> en el suelo. Simplemente trata de encontrarlas todas."

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid ""
"<code><a cbot|radar>radar</a></code> to detect the blue crosses (category <code><a object|waypoint>WayPoint</a></code>)\n"
"<code><a cbot|direct>direction</a></code> to calculate a direction\n"
"<code><a cbot|if>if</a></code> to test a condition\n"
"<code><a cbot|motor>motor</a></code> to set the motor speeds"
msgstr ""
"<code><a cbot|radar>radar</a></code> para detectar las cruces azules (categoría <code><a object|waypoint>WayPoint</a></code>)\n"
"<code><a cbot|direct>direction</a></code> para calcular una dirección\n"
"<code><a cbot|if>if</a></code> para probar una condición\n"
"<code><a cbot|motor>motor</a></code> para establecer las velocidades del motor"

#. type: \t; header
#: ../help/help.E.txt:10
#, no-wrap
msgid "Remark"
msgstr "Observación"

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "Do not wait too long, because the crazy bot gets down to work immediately. Fortunately, as long as you are in the program editor, the game will pause."
msgstr "No esperes demasiado, porque el bot loco comienza a trabajar inmediatamente. Afortunadamente, mientras estés en el editor de programas, el juego se pausará."
