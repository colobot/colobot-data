#. type: \b; header
#: ../help/help.E.txt:12
#, no-wrap
msgid "Useful instructions"
msgstr "Instrucciones útiles"

#. type: \t; header
#: ../help/help.E.txt:18
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:19
#, no-wrap
msgid "<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<a cbot>Programación</a>, <a cbot|type>tipos</a> y <a cbot|category>categorías</a>."

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Exchange posts 3"
msgstr "Centros de intercambio 3"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Collect lots of valuable information from information exchange posts."
msgstr "Recopila mucha información valiosa de los centros de intercambio de información."

#. type: ScriptName-text
#: ../scene.txt:3
#, no-wrap
msgid "Info"
msgstr "Información"

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Exercice"
msgstr "Ejercicio"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Several <a object|exchange>information exchange posts</a> are standing along the way. When the bot is close enough to a post, it can read the instructions it contains. The <a object|exchange>information exchange posts</a> along the way contain the direction of the next post and the distance. And you do not know how many exchange posts you must get in touch with before arriving at your goal."
msgstr "Varios <a object|exchange>centros de intercambio de información</a> están ubicados a lo largo del camino. Cuando el bot está lo suficientemente cerca de un poste, puede leer las instrucciones que contiene. Los <a object|exchange>centros de intercambio de información</a> a lo largo del camino contienen la dirección del siguiente poste y la distancia. Y no sabes cuántos centros de intercambio debes contactar antes de llegar a tu objetivo."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "General principle"
msgstr "Principio general"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "\tAlways repeat:"
msgstr "\tSiempre repetir:"

#. type: Bullet: 'o'
#: ../help/help.E.txt:6
#, no-wrap
msgid "Retrieve the direction from the <a object|exchange>exchange post</a>."
msgstr "Recupera la dirección del <a object|exchange>centro de intercambio</a>."

#. type: Bullet: 'o'
#: ../help/help.E.txt:7
#, no-wrap
msgid "Retrieve the distance from the <a object|exchange>exchange post</a>."
msgstr "Recupera la distancia del <a object|exchange>centro de intercambio</a>."

#. type: Bullet: 'o'
#: ../help/help.E.txt:8
#, no-wrap
msgid "If no information could be retrieved, stop the program."
msgstr "Si no se pudo recuperar información, detén el programa."

#. type: Bullet: 'o'
#: ../help/help.E.txt:9
#, no-wrap
msgid "Execute the rotation."
msgstr "Ejecuta la rotación."

#. type: Bullet: 'o'
#: ../help/help.E.txt:10
#, no-wrap
msgid "Move forward to the next post."
msgstr "Avanza hacia el siguiente puesto."

#. type: Plain text
#: ../help/help.E.txt:13
#, no-wrap
msgid ""
"<code><a cbot|while>while</a></code> to repeat the instructions\n"
"<code><a cbot|receive>receive</a></code> to get the information from a post\n"
"<code><a cbot|move>move</a></code> to move the bot\n"
"<code><a cbot|turn>turn</a></code> to turn the bot"
msgstr ""
"<code><a cbot|while>while</a></code> para repetir las instrucciones\n"
"<code><a cbot|receive>receive</a></code> para obtener la información de un poste\n"
"<code><a cbot|move>move</a></code> para mover el bot\n"
"<code><a cbot|turn>turn</a></code> para girar el bot"
