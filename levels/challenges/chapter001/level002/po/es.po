#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<a cbot>Programación</a>, <a cbot|type>tipos</a> y <a cbot|category>categorías</a>."

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Massacre"
msgstr "Masacre"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Use a loop in order to destroy four targets."
msgstr "Usa un bucle para destruir cuatro objetivos."

#. type: ScriptName-text
#: ../scene.txt:3
#, no-wrap
msgid "Go"
msgstr "Ir"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Destroy all four <a object|bottarg>targets</a> with a program using a <code>for</code> loop. You must move 10m to get from one target to another."
msgstr "Destruye los cuatro <a object|bottarg>objetivos</a> con un programa usando un bucle <code>for</code>. Debes moverte 10m para pasar de un objetivo a otro."

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid ""
"<code><a cbot|for>for</a></code> loop to repeat the instructions\n"
"<code><a cbot|move>move</a></code> to move the bot\n"
"<code><a cbot|turn>turn</a></code> to turn the bot\n"
"<code><a cbot|fire>fire</a></code> to fire the cannon"
msgstr ""
