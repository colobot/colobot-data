#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Mover 1"
msgstr "Mover 1"

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Exercise"
msgstr "Ejercicio"

#. type: \b; header
#: ../help/help.E.txt:26
#, no-wrap
msgid "Useful instructions"
msgstr "Instrucciones útiles"

#. type: \t; header
#: ../help/help.E.txt:34
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:35
#, no-wrap
msgid "<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<a cbot>Programación</a>, <a cbot|type>tipos</a> y <a cbot|category>categorías</a>."

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Retrieve some titanium ore in order to convert it to titanium cubes."
msgstr "Recupera mineral de titanio para convertirlo en cubos de titanio."

#. type: ScriptName-text
#: ../scene.txt:3
#, no-wrap
msgid "Mover"
msgstr "Mover"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "Convert some <a object|titanore>titanium ore</a> to <a object|titan>titanium cubes</a>, then drop 2 titanium cubes on the pads whose coordinates are:"
msgstr "Convierte algo de <a object|titanore>mineral de titanio</a> en <a object|titan>cubos de titanio</a>, luego deja 2 cubos de titanio en las plataformas cuyas coordenadas son:"

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid ""
"\tx=10, y=-60\n"
"\tx=10, y=-65"
msgstr ""
"\tx=10, y=-60\n"
"\tx=10, y=-65"

#. type: Image filename
#: ../help/help.E.txt:7
#, no-wrap
msgid "derrick"
msgstr "torreExtractor"

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "The <a object|derrick>derrick</a> extracts titanium ore from the subsoil; you just have to pick it up."
msgstr "La <a object|derrick>torre extractor</a> extrae mineral de titanio del subsuelo; solo tienes que recogerlo."

#. type: Image filename
#: ../help/help.E.txt:10
#, no-wrap
msgid "convert"
msgstr "convertidor"

#. type: Plain text
#: ../help/help.E.txt:11
#, no-wrap
msgid "The <a object|convert>converter</a> converts titanium ore to titanium cubes. Just drop the titanium ore on the platform, move backward, and wait until it has been converted."
msgstr "El <a object|convert>convertidor</a> convierte mineral de titanio en cubos de titanio. Simplemente deja el mineral de titanio en la plataforma, retrocede y espera hasta que se haya convertido."

#. type: \b; header
#: ../help/help.E.txt:13
#, no-wrap
msgid "General principle"
msgstr "Principio general"

#. type: Plain text
#: ../help/help.E.txt:14
#, no-wrap
msgid "Repeat two times :"
msgstr "Repetir dos veces:"

#. type: Bullet: 'o'
#: ../help/help.E.txt:15
#, no-wrap
msgid "Wait until there is some titanium ore."
msgstr "Espera hasta que haya mineral de titanio."

#. type: Bullet: 'o'
#: ../help/help.E.txt:16
#, no-wrap
msgid "Go to the titanium ore."
msgstr "Ve al mineral de titanio."

#. type: Bullet: 'o'
#: ../help/help.E.txt:17
#, no-wrap
msgid "Pick it up."
msgstr "Recógelo."

#. type: Bullet: 'o'
#: ../help/help.E.txt:18
#, no-wrap
msgid "Go to the converter."
msgstr "Ve al convertidor."

#. type: Bullet: 'o'
#: ../help/help.E.txt:19
#, no-wrap
msgid "Drop the titanium ore."
msgstr "Deja el mineral de titanio."

#. type: Bullet: 'o'
#: ../help/help.E.txt:20
#, no-wrap
msgid "Move back 2.5 meters."
msgstr "Retrocede 2.5 metros."

#. type: Bullet: 'o'
#: ../help/help.E.txt:21
#, no-wrap
msgid "Wait until there is a titanium cube."
msgstr "Espera hasta que haya un cubo de titanio."

#. type: Bullet: 'o'
#: ../help/help.E.txt:22
#, no-wrap
msgid "Pick up the titanium cube."
msgstr "Recoge el cubo de titanio."

#. type: Bullet: 'o'
#: ../help/help.E.txt:23
#, no-wrap
msgid "Go to the platform."
msgstr "Ve a la plataforma."

#. type: Bullet: 'o'
#: ../help/help.E.txt:24
#, no-wrap
msgid "Drop the titanium cube."
msgstr "Deja el cubo de titanio."

#. type: Plain text
#: ../help/help.E.txt:27
#, no-wrap
msgid ""
"<code><a cbot|for>for</a></code> to repeat some instructions\n"
"<code><a cbot|do>do - while</a></code> to repeat some instructions\n"
"<code><a cbot|radar>radar</a></code> to look for different objects\n"
"<code><a cbot|goto>goto</a></code> to move the bot\n"
"<code><a cbot|grab>grab</a></code> to grab an object\n"
"<code><a cbot|drop>drop</a></code> to drop an object"
msgstr ""
"<code><a cbot|for>for</a></code> para repetir instrucciones\n"
"<code><a cbot|do>do - while</a></code> para repetir instrucciones\n"
"<code><a cbot|radar>radar</a></code> para buscar diferentes objetos\n"
"<code><a cbot|goto>goto</a></code> para mover el bot\n"
"<code><a cbot|grab>grab</a></code> para recoger un objeto\n"
"<code><a cbot|drop>drop</a></code> para dejar un objeto"
