#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Exercise"
msgstr "Ejercicio"

#. type: \t; header
#: ../help/help.E.txt:7
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:8
#, no-wrap
msgid "<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<a cbot>Programación</a>, <a cbot|type>tipos</a> y <a cbot|category>categorías</a>."

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Crazy bot"
msgstr "Bot loco"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Use the radar to put some order into a big mess left behind by a crazy bot."
msgstr "Usa el radar para poner orden en un gran desastre dejado por un bot loco."

#. type: ScriptName-text
#: ../scene.txt:3
#, no-wrap
msgid "Move"
msgstr "Mover"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "In this exercise, a \"crazy bot\" places many <a object|waypoint>blue crosses</a> on the ground. In order to find them, you can reuse the program written in the previous exercise. This can show you the flexibility of such a program: it adapts to whatever environment it encounters."
msgstr "En este ejercicio, un \"bot loco\" coloca muchas <a object|waypoint>cruces azules</a> en el suelo. Para encontrarlas, puedes reutilizar el programa escrito en el ejercicio anterior. Esto puede mostrarte la flexibilidad de tal programa: se adapta a cualquier entorno que encuentre."

#. type: \t; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "Remark"
msgstr "Nota"

#. type: Plain text
#: ../help/help.E.txt:5
#, no-wrap
msgid "Do not wait too long, because the crazy bot gets down to work immediately. Fortunately, as long as you are in the program editor, the game will pause."
msgstr "No esperes demasiado, porque el bot loco comienza a trabajar inmediatamente. Afortunadamente, mientras estés en el editor de programas, el juego se pausará."
