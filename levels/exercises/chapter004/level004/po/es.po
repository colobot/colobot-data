#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "Exercise"
msgstr "Ejercicio"

#. type: \t; header
#: ../help/help.E.txt:17
#, no-wrap
msgid "See also"
msgstr "Ver también"

#. type: Plain text
#: ../help/help.E.txt:18
#, no-wrap
msgid "<a cbot>Programming</a>, <a cbot|type>types</a> and <a cbot|category>categories</a>."
msgstr "<a cbot>Programación</a>, <a cbot|type>tipos</a> y <a cbot|category>categorías</a>."

#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Patient hunter"
msgstr "Cazador paciente"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Be patient enough not to waste your ammunitions."
msgstr "Ten suficiente paciencia para no desperdiciar tu munición."

#. type: ScriptName-text
#: ../scene.txt:3
#, no-wrap
msgid "Patient"
msgstr "Paciente"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "You must find a way to destroy the four moving <a object|bottarg>target bots</a> without wasting one shot. Notice that after every move, the targets will stay motionless during one second."
msgstr "Debes encontrar una manera de destruir los cuatro <a object|bottarg>bots objetivo</a> en movimiento sin desperdiciar ningún disparo. Observa que después de cada movimiento, los objetivos permanecerán inmóviles durante un segundo."

#. type: \b; header
#: ../help/help.E.txt:4
#, no-wrap
msgid "General principle"
msgstr "Principio general"

#. type: Bullet: '1)'
#: ../help/help.E.txt:5
#, no-wrap
msgid "Detect a target with the instruction <c/><a cbot|radar>radar</a>(TargetBot);<n/>."
msgstr "Detecta un objetivo con la instrucción <c/><a cbot|radar>radar</a>(TargetBot);<n/>."

#. type: Bullet: '2)'
#: ../help/help.E.txt:6
#, no-wrap
msgid "Turn towards the target with <c/><a cbot|turn>turn</a>(direction());<n/>."
msgstr "Gira hacia el objetivo con <c/><a cbot|turn>turn</a>(direction());<n/>."

#. type: Bullet: '3)'
#: ../help/help.E.txt:7
#, no-wrap
msgid "After the rotation, check if the target did not move."
msgstr "Después de la rotación, verifica si el objetivo no se movió."

#. type: Bullet: '4)'
#: ../help/help.E.txt:8
#, no-wrap
msgid "If it did not, wait 0.2 seconds with <c/><a cbot|wait>wait</a>(0.2);<n/>."
msgstr "Si no se movió, espera 0.2 segundos con <c/><a cbot|wait>wait</a>(0.2);<n/>."

#. type: Bullet: '5)'
#: ../help/help.E.txt:9
#, no-wrap
msgid "Re-check if the target did not move."
msgstr "Vuelve a verificar si el objetivo no se movió."

#. type: Bullet: '6)'
#: ../help/help.E.txt:10
#, no-wrap
msgid "If it did not, shoot with <c/><a cbot|fire>fire</a>(2);<n/> and wait 2 seconds for the target to be hit by the bullets and destroyed."
msgstr "Si no se movió, dispara con <c/><a cbot|fire>fire</a>(2);<n/> y espera 2 segundos para que el objetivo sea golpeado por las balas y destruido."

#. type: Plain text
#: ../help/help.E.txt:12
#, no-wrap
msgid "There are of course other ways to achieve the goal."
msgstr "Por supuesto, hay otras formas de lograr el objetivo."

#. type: \b; header
#: ../help/help.E.txt:14
#, no-wrap
msgid "Remark"
msgstr "Nota"

#. type: Plain text
#: ../help/help.E.txt:15
#, no-wrap
msgid "In order to increase the efficiency of your shots, aim a little downward with <c/><a cbot|aim>aim</a>(-3);<n/>."
msgstr "Para aumentar la eficiencia de tus disparos, apunta un poco hacia abajo con <c/><a cbot|aim>aim</a>(-3);<n/>."
